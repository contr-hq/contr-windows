<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="Contr.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///CommunityToolkit.WinUI.Controls.Segmented/Segmented/Segmented.xaml" />

                <!--
                    Merged here because Application.Resources is the one scope pages in every module
                    assembly can see; ms-appx:///<AssemblyName>/ addresses another assembly's file.
                -->
                <ResourceDictionary Source="ms-appx:///Contr.UI.Common/Styles/FontSizes.xaml" />
                <ResourceDictionary Source="ms-appx:///Contr.UI.Common/Styles/Thickness.xaml" />
                <ResourceDictionary Source="ms-appx:///Contr.UI.Common/Styles/Texts.xaml" />
                <ResourceDictionary Source="ms-appx:///Contr.UI.Common/Styles/BasicInputs.xaml" />
                <ResourceDictionary Source="ms-appx:///Contr.UI.Common/Styles/Menus.xaml" />
                <ResourceDictionary Source="ms-appx:///Contr.UI.Common/Styles/Cards.xaml" />
                <ResourceDictionary Source="ms-appx:///Contr.UI.Common/Styles/Lists.xaml" />
                <ResourceDictionary Source="ms-appx:///Contr.UI.Common/Styles/SelectorBar.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
