<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Contr.App</RootNamespace>
    <AssemblyName>Contr.App</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CA1416;CS8305;CS0612;CS0618;MVVMTK0045</NoWarn>
    <!-- https://github.com/microsoft/CsWin32/issues/1273 -->
    <NoWarn>$(NoWarn);IL2050</NoWarn>

    <!-- Program.Main claims the single-instance key before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.Development.json"
             Condition="Exists('appsettings.Development.json')"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="UI\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="System.Reactive" />
    <PackageReference Include="WinUIEx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contr.App.Infrastructure\Contr.App.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Shared\Contr.Daemon.UI\Contr.Daemon.UI.csproj" />
    <ProjectReference Include="..\..\Shared\Contr.Interoperability\Contr.Interoperability.csproj" />
    <ProjectReference Include="..\..\Shared\Contr.UI.Common\Contr.UI.Common.csproj" />
    <ProjectReference Include="..\..\Shared\Contr.UI.Contracts\Contr.UI.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Containers\Contr.Modules.Containers.UI\Contr.Modules.Containers.UI.csproj" />
    <ProjectReference Include="..\..\Modules\Images\Contr.Modules.Images.UI\Contr.Modules.Images.UI.csproj" />
    <ProjectReference Include="..\..\Modules\Volumes\Contr.Modules.Volumes.UI\Contr.Modules.Volumes.UI.csproj" />
    <ProjectReference Include="..\..\Modules\Networks\Contr.Modules.Networks.UI\Contr.Modules.Networks.UI.csproj" />
  </ItemGroup>

  <!-- dotnet publish of a WinUI 3 app leaves out the XBF, PRI and Assets files. -->
  <Target Name="CopyWinUIResourcesOnPublish" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_WinUIXbfFiles Include="$(OutputPath)**\*.xbf" />
      <_WinUIPriFiles Include="$(OutputPath)$(AssemblyName).pri" />
      <_WinUIAssetFiles Include="$(OutputPath)Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIXbfFiles)" DestinationFiles="@(_WinUIXbfFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIPriFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIAssetFiles)" DestinationFiles="@(_WinUIAssetFiles->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
