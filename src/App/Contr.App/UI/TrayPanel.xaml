<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Contr.App.UI.TrayPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:contracts="using:Contr.UI.Contracts.Services.Containers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Contr.App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="360"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="TrayCommandStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <DataTemplate x:Key="RunningTemplate" x:DataType="contracts:RunningContainer">
            <Grid
                MinHeight="34"
                Padding="12,0,4,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind local:TrayPanel.ProjectText(Project)}" />
                </StackPanel>
                <HyperlinkButton
                    Grid.Column="2"
                    Padding="2,0"
                    VerticalAlignment="Center"
                    Content="{x:Bind Port}"
                    FontSize="12"
                    NavigateUri="{x:Bind Link}"
                    Visibility="{x:Bind local:TrayPanel.WhenLink(Link)}" />
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Stop"
                    Click="OnStopContainer"
                    Style="{StaticResource RowActionButtonStyle}"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="Stop">
                    <FontIcon FontSize="12" Glyph="&#xE71A;" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid
            Padding="12,12,8,12"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image
                Width="32"
                Height="32"
                Source="ms-appx:///Assets/ContrLogo.png" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Text="Contr" />
                <common:StatusLabel
                    FontSize="12"
                    Kind="{x:Bind ViewModel.StatusKind, Mode=OneWay}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </StackPanel>
            <Button
                Grid.Column="2"
                AutomationProperties.Name="Open Contr"
                Click="OnOpen"
                Style="{StaticResource RowActionButtonStyle}"
                ToolTipService.ToolTip="Open Contr">
                <FontIcon FontSize="14" Glyph="&#xE8A7;" />
            </Button>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Settings"
                Click="OnSettings"
                Style="{StaticResource RowActionButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <StackPanel Visibility="{x:Bind ViewModel.HasContainers}">
            <MenuFlyoutSeparator />
            <TextBlock
                Margin="12,8,12,4"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.RunningTitle, Mode=OneWay}" />
            <ItemsRepeater ItemTemplate="{StaticResource RunningTemplate}" ItemsSource="{x:Bind ViewModel.Running}" />
            <HyperlinkButton
                Margin="8,2,0,6"
                Click="OnShowContainers"
                Content="Show all containers"
                FontSize="12" />
        </StackPanel>

        <StackPanel Visibility="{x:Bind ViewModel.HasContext, Mode=OneWay}">
            <MenuFlyoutSeparator />
            <Grid Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon FontSize="14" Glyph="&#xE756;" />
                    <TextBlock Text="Docker context" />
                </StackPanel>
                <TextBlock
                    HorizontalAlignment="Right"
                    FontFamily="Cascadia Mono,Consolas"
                    Text="{x:Bind ViewModel.DockerContext, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <MenuFlyoutSeparator />
        <Button
            Click="OnStartEngine"
            Style="{StaticResource TrayCommandStyle}"
            Visibility="{x:Bind ViewModel.CanStartEngine, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon FontSize="14" Glyph="&#xE768;" />
                <TextBlock Text="Start engine" />
            </StackPanel>
        </Button>
        <Button
            Click="OnRestartEngine"
            Style="{StaticResource TrayCommandStyle}"
            Visibility="{x:Bind ViewModel.CanRestartEngine, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                <TextBlock Text="Restart engine" />
            </StackPanel>
        </Button>
        <Button Click="OnTroubleshoot" Style="{StaticResource TrayCommandStyle}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon FontSize="14" Glyph="&#xE90F;" />
                <TextBlock Text="Troubleshoot" />
            </StackPanel>
        </Button>
        <Button Click="OnQuit" Style="{StaticResource TrayCommandStyle}">
            <Grid Width="320">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                    <TextBlock Text="Quit Contr" />
                </StackPanel>
                <TextBlock
                    HorizontalAlignment="Right"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="The engine keeps running" />
            </Grid>
        </Button>
    </StackPanel>
</UserControl>
