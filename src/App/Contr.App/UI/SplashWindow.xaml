<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="Contr.App.UI.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    Width="560"
    Height="360"
    IsMaximizable="False"
    IsMinimizable="False"
    IsResizable="False"
    IsTitleBarVisible="False"
    mc:Ignorable="d">

    <winex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winex:WindowEx.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Margin="56,40,56,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Image
                Width="80"
                Height="80"
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                Source="ms-appx:///Assets/ContrLogo.png" />
            <TextBlock
                Margin="0,0,0,28"
                HorizontalAlignment="Center"
                FontSize="32"
                FontWeight="SemiBold"
                Text="Contr" />
            <ProgressBar
                Width="360"
                IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
            <StackPanel
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.StepText, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Margin="24,0,24,16"
            HorizontalAlignment="Right"
            FontFamily="Cascadia Mono,Consolas"
            FontSize="11"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="{x:Bind ViewModel.VersionText}" />
    </Grid>
</winex:WindowEx>
