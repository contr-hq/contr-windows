<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.App.UI.TroubleshootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Contr.UI.Common.Icons"
    xmlns:local="using:Contr.App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TroubleshootLogBackgroundBrush" Color="#0C0C0C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TroubleshootLogBackgroundBrush" Color="#FBFBFB" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ComponentLogTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="17" />
            </Style>

            <DataTemplate x:Key="CheckTemplate" x:DataType="local:CheckRow">
                <Grid
                    MinHeight="44"
                    Padding="0,6"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <common:PillView
                        HorizontalAlignment="Left"
                        Kind="{x:Bind PillKind}"
                        Text="{x:Bind Outcome}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontWeight="{x:Bind local:TroubleshootPage.Weight(IsFailed)}"
                        Text="{x:Bind Name}" />
                    <!--  The daemon's details are sentences; a long one wraps instead of losing its end.  -->
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Detail}"
                        TextAlignment="Right"
                        TextWrapping="Wrap" />
                    <ItemsRepeater
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind Fixes}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="local:CheckFix">
                                <HyperlinkButton
                                    Padding="8,4"
                                    AutomationProperties.Name="{x:Bind Label}"
                                    Click="OnFix"
                                    Tag="{x:Bind}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            Glyph="{x:Bind icons:ContrIcons.Shield}"
                                            Style="{StaticResource IconStyle}"
                                            Visibility="{x:Bind RequiresElevation}" />
                                        <TextBlock Text="{x:Bind Label}" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="{StaticResource PageContentMaxWidth}" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <common:PageHeader Title="Troubleshoot" />

                <InfoBar
                    Title="{x:Bind ViewModel.ProblemTitle, Mode=OneWay}"
                    Margin="0,16,0,0"
                    AutomationProperties.AutomationId="EngineProblem"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ProblemMessage, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.ProblemSeverity, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasProblem, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            AutomationProperties.AutomationId="ProblemFixButton"
                            AutomationProperties.Name="{x:Bind ViewModel.ProblemFixLabel, Mode=OneWay}"
                            Click="OnFixProblem"
                            IsEnabled="{x:Bind ViewModel.CanFix, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.HasProblemFix, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    Glyph="{x:Bind icons:ContrIcons.Shield}"
                                    Style="{StaticResource IconStyle}"
                                    Visibility="{x:Bind ViewModel.ProblemFixNeedsApproval, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.ProblemFixLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                    <InfoBar.Content>
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontFamily="Cascadia Mono,Consolas"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.ProblemCode, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasProblemCode, Mode=OneWay}" />
                            <StackPanel
                                Margin="0,0,0,12"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.IsFixingProblem, Mode=OneWay}">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind ViewModel.IsFixingProblem, Mode=OneWay}" />
                                <TextBlock
                                    AutomationProperties.AutomationId="ProblemFixStatus"
                                    Text="{x:Bind ViewModel.FixStatus, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                AutomationProperties.AutomationId="ProblemFixError"
                                Text="{x:Bind ViewModel.FixError, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind ViewModel.HasFixError, Mode=OneWay}" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <Grid Margin="0,16,0,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <Border VerticalAlignment="Top" Style="{StaticResource CaptionedCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="SYSTEM CHECKS" />
                                <common:PillRow Grid.Column="1" Pills="{x:Bind ViewModel.CheckPills, Mode=OneWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource TimeTextStyle}"
                                    Text="{x:Bind ViewModel.ChecksSummary, Mode=OneWay}" />
                                <Button
                                    Grid.Column="3"
                                    AutomationProperties.AutomationId="RunChecksButton"
                                    Click="OnRunAgain"
                                    IsEnabled="{x:Bind ViewModel.CanFix, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Restart}" Style="{StaticResource IconStyle}" />
                                        <TextBlock Text="Run again" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.IsFixingCheck, Mode=OneWay}">
                                <ProgressRing
                                    Width="16"
                                    Height="16"
                                    IsActive="{x:Bind ViewModel.IsFixingCheck, Mode=OneWay}" />
                                <TextBlock
                                    AutomationProperties.AutomationId="FixStatus"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.FixStatus, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <!--  A control, so one running fix disables every other fix button.  -->
                            <ContentControl
                                HorizontalContentAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanFix, Mode=OneWay}"
                                IsTabStop="False">
                                <ItemsRepeater
                                    AutomationProperties.AutomationId="SystemChecks"
                                    ItemTemplate="{StaticResource CheckTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Checks}" />
                            </ContentControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="16">
                        <Border Style="{StaticResource CaptionedCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="DIAGNOSTICS BUNDLE" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="A zip of logs and check results for your IT team. Credentials, your user name, home folder and this PC's name are removed."
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button
                                        AutomationProperties.AutomationId="CreateBundleButton"
                                        Click="OnCreateBundle"
                                        Content="Create bundle"
                                        IsEnabled="{x:Bind ViewModel.CanCreateBundle, Mode=OneWay}" />
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind ViewModel.IsCreatingBundle, Mode=OneWay}">
                                        <ProgressRing
                                            Width="16"
                                            Height="16"
                                            IsActive="{x:Bind ViewModel.IsCreatingBundle, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind ViewModel.BundleStatus, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="This version of Contr's background service doesn't make bundles."
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind local:TroubleshootPage.Not(ViewModel.OffersBundle), Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CaptionedCardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="COMPONENT LOGS" />
                                    <ComboBox
                                        HorizontalAlignment="Right"
                                        AutomationProperties.Name="Component"
                                        SelectedIndex="0">
                                        <ComboBoxItem Content="Client" />
                                        <ComboBoxItem Content="Daemon" IsEnabled="False" />
                                    </ComboBox>
                                </Grid>
                                <ScrollViewer
                                    x:Name="LogScroller"
                                    MaxHeight="220"
                                    Padding="10,8"
                                    AutomationProperties.AutomationId="ComponentLog"
                                    Background="{ThemeResource TroubleshootLogBackgroundBrush}"
                                    CornerRadius="4">
                                    <Grid>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="The client hasn't written to its log yet."
                                            TextWrapping="Wrap"
                                            Visibility="{x:Bind local:TroubleshootPage.Not(ViewModel.HasLog), Mode=OneWay}" />
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.LogLines}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="local:ComponentLogLine">
                                                    <!--  One wrapping block, so a long line continues under its time.  -->
                                                    <TextBlock
                                                        IsTextSelectionEnabled="True"
                                                        Opacity="{x:Bind local:TroubleshootPage.LineOpacity(Level)}"
                                                        Style="{StaticResource ComponentLogTextStyle}"
                                                        TextWrapping="Wrap">
                                                        <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Stamp}" /><Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind OtherLevel}" /><Run Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind WarningLevel}" /><Run Foreground="{ThemeResource SystemFillColorCriticalBrush}" Text="{x:Bind ErrorLevel}" /><Run Text="{x:Bind Text}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Grid>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CaptionedCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="RESET" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Reset the engine" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Replaces its runtime. Images, containers and volumes stay."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ResetEngineButton"
                                        Click="OnResetEngine"
                                        Content="Reset…"
                                        IsEnabled="{x:Bind ViewModel.CanReset, Mode=OneWay}" />
                                </Grid>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Reset Kubernetes" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Recreates the cluster. Images stay."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="ResetKubernetesButton"
                                        Click="OnResetKubernetes"
                                        Content="Reset…"
                                        IsEnabled="{x:Bind ViewModel.CanResetKubernetes, Mode=OneWay}" />
                                </Grid>
                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Factory reset" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Deletes all containers, images, volumes and settings."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="FactoryResetButton"
                                        Click="OnFactoryReset"
                                        Content="Factory reset…"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        IsEnabled="{x:Bind ViewModel.CanReset, Mode=OneWay}" />
                                </Grid>
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Visibility="{x:Bind ViewModel.IsResetting, Mode=OneWay}">
                                    <ProgressRing
                                        Width="16"
                                        Height="16"
                                        IsActive="{x:Bind ViewModel.IsResetting, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.ResetStatus, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="This daemon can't reset the engine it runs."
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind local:TroubleshootPage.Not(ViewModel.OffersReset), Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
