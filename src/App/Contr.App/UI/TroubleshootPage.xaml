<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.App.UI.TroubleshootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Contr.App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TroubleshootLogBackgroundBrush" Color="#0C0C0C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TroubleshootLogBackgroundBrush" Color="#FBFBFB" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <DataTemplate x:Key="CheckTemplate" x:DataType="local:CheckRow">
                <Grid
                    MinHeight="40"
                    Padding="16,6"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <common:StatusLabel
                        VerticalAlignment="Center"
                        FontSize="12"
                        Kind="{x:Bind Kind}"
                        Text="{x:Bind Outcome}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name}" />
                    <TextBlock
                        Grid.Column="2"
                        MaxWidth="320"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Detail}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="36,24,36,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <common:PageHeader Title="Troubleshoot" />

        <InfoBar
            Grid.Row="1"
            Title="{x:Bind ViewModel.ProblemTitle, Mode=OneWay}"
            AutomationProperties.AutomationId="EngineProblem"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
            Message="{x:Bind ViewModel.ProblemMessage, Mode=OneWay}"
            Severity="Error">
            <InfoBar.Content>
                <TextBlock
                    Margin="0,0,0,12"
                    FontFamily="Cascadia Mono,Consolas"
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.ProblemCode, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasProblemCode, Mode=OneWay}" />
            </InfoBar.Content>
        </InfoBar>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border VerticalAlignment="Top" Style="{StaticResource ListCardStyle}">
                <StackPanel>
                    <Grid Padding="16,10,12,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="System checks" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind local:TroubleshootPage.Summary(ViewModel.ChecksSummary), Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            AutomationProperties.AutomationId="RunChecksButton"
                            Click="OnRunAgain">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                <TextBlock Text="Run again" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsRepeater
                        AutomationProperties.AutomationId="SystemChecks"
                        ItemTemplate="{StaticResource CheckTemplate}"
                        ItemsSource="{x:Bind ViewModel.Checks}" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="10">
                    <Border Padding="16" Style="{StaticResource ListCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Diagnostics bundle" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="A zip of logs and check results to send to whoever helps you."
                                TextWrapping="Wrap" />
                            <Button Content="Create bundle" IsEnabled="False" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16" Style="{StaticResource ListCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Component logs" />
                                <ComboBox
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Component"
                                    SelectedIndex="0">
                                    <ComboBoxItem Content="Client" />
                                    <ComboBoxItem Content="Daemon" IsEnabled="False" />
                                </ComboBox>
                            </Grid>
                            <ScrollViewer
                                MaxHeight="220"
                                Padding="10,8"
                                Background="{ThemeResource TroubleshootLogBackgroundBrush}"
                                CornerRadius="4"
                                HorizontalScrollBarVisibility="Auto">
                                <TextBlock
                                    FontFamily="Cascadia Mono,Consolas"
                                    FontSize="11"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind local:TroubleshootPage.OrEmpty(ViewModel.LogText), Mode=OneWay}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Padding="16" Style="{StaticResource ListCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock FontWeight="SemiBold" Text="Reset" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Reset Kubernetes" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Recreates the cluster. Images stay."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="Reset"
                                    IsEnabled="False" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Factory reset" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Deletes all containers, images, volumes and settings."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="Factory reset…"
                                    IsEnabled="False" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
