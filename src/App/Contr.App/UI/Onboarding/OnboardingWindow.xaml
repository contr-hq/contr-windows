<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="Contr.App.UI.Onboarding.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Contr.App.UI"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Contr.App.UI.Onboarding"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    Title="Set up Contr"
    Width="1040"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    mc:Ignorable="d">

    <winex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </winex:WindowEx.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <DataTemplate x:Key="RailStepTemplate" x:DataType="local:OnboardingStep">
                <Grid Margin="0,0,0,18" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="24"
                        Height="24"
                        VerticalAlignment="Top">
                        <Ellipse
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            Visibility="{x:Bind local:OnboardingWindow.WhenState(State, 'Done'), Mode=OneWay}" />
                        <FontIcon
                            FontSize="12"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE73E;"
                            Visibility="{x:Bind local:OnboardingWindow.WhenState(State, 'Done'), Mode=OneWay}" />
                        <Ellipse
                            Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                            StrokeThickness="2"
                            Visibility="{x:Bind local:OnboardingWindow.WhenState(State, 'Current'), Mode=OneWay}" />
                        <Ellipse
                            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            StrokeThickness="1"
                            Visibility="{x:Bind local:OnboardingWindow.WhenState(State, 'Pending'), Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{x:Bind Number}"
                            Visibility="{x:Bind local:OnboardingWindow.WhenNotDone(State), Mode=OneWay}" />
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="{x:Bind local:OnboardingWindow.TitleWeight(State), Mode=OneWay}" Text="{x:Bind Title}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Detail, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CheckTemplate" x:DataType="app:CheckRow">
                <Grid
                    MinHeight="44"
                    Padding="16,8"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <common:StatusLabel VerticalAlignment="Center" Kind="{x:Bind Kind}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Name}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Detail}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="EngineStepTemplate" x:DataType="local:EngineSetupStep">
                <Grid
                    MinHeight="40"
                    Padding="16,6"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <common:StatusLabel VerticalAlignment="Center" Kind="{x:Bind local:OnboardingWindow.StepKind(IsDone), Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Message}" />
                </Grid>
            </DataTemplate>

            <Style x:Key="StepTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="StepTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TitleBar
            x:Name="SetupTitleBar"
            Title="Set up Contr"
            Grid.ColumnSpan="2">
            <TitleBar.LeftHeader>
                <ImageIcon
                    Height="16"
                    Margin="12,0,0,0"
                    Source="ms-appx:///Assets/ContrLogo.png" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <ItemsControl
            Grid.Row="1"
            Padding="28,24,20,24"
            AutomationProperties.Name="Setup steps"
            ItemTemplate="{StaticResource RailStepTemplate}"
            ItemsSource="{x:Bind ViewModel.Steps}" />

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            CornerRadius="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Padding="40,36,40,24">
                <StackPanel MaxWidth="700" HorizontalAlignment="Left" Spacing="16">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.StepLabel, Mode=OneWay}" />

                    <!--  1. Check this PC  -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay}">
                        <TextBlock Style="{StaticResource StepTitleStyle}" Text="Welcome to Contr" />
                        <TextBlock Style="{StaticResource StepTextStyle}" Text="Contr runs containers on this PC with a Docker-compatible engine. First, a check that this PC is ready." />
                        <Border Style="{StaticResource CardStyle}">
                            <ItemsRepeater ItemTemplate="{StaticResource CheckTemplate}" ItemsSource="{x:Bind ViewModel.Checks}" />
                        </Border>
                    </StackPanel>

                    <!--  2. Install WSL  -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsWsl, Mode=OneWay}">
                        <TextBlock Style="{StaticResource StepTitleStyle}" Text="Install WSL" />
                        <TextBlock
                            Style="{StaticResource StepTextStyle}"
                            Text="Contr runs its engine in WSL 2. Setting up the engine in the next step tells whether WSL is there."
                            Visibility="{x:Bind local:OnboardingWindow.Not(ViewModel.IsWslMissing), Mode=OneWay}" />
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsWslMissing, Mode=OneWay}">
                            <TextBlock Style="{StaticResource StepTextStyle}" Text="Contr runs its engine in WSL 2, which isn't installed. Install it from a terminal opened as administrator, restart if Windows asks, then try again." />
                            <Grid
                                Padding="12,8"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                CornerRadius="4">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono,Consolas"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind local:OnboardingWindow.WslCommand}" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="OnCopyWslCommand"
                                    Content="Copy" />
                            </Grid>
                            <Button
                                Click="OnRetryEngine"
                                Content="Try again"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  3. Set up the engine  -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsEngine, Mode=OneWay}">
                        <TextBlock Style="{StaticResource StepTitleStyle}" Text="Setting up the engine" />
                        <TextBlock Style="{StaticResource StepTextStyle}" Text="You can keep working while this runs. The tray icon shows when the engine is ready." />
                        <ProgressBar IsIndeterminate="{x:Bind local:OnboardingWindow.Both(ViewModel.IsBusy, ViewModel.IsEngineProgressIndeterminate), Mode=OneWay}" Value="{x:Bind ViewModel.EngineProgress, Mode=OneWay}" />
                        <InfoBar
                            Title="The engine didn't start"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.HasEngineError, Mode=OneWay}"
                            Message="{x:Bind ViewModel.EngineError, Mode=OneWay}"
                            Severity="Error">
                            <InfoBar.ActionButton>
                                <Button Click="OnRetryEngine" Content="Try again" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <Border Style="{StaticResource CardStyle}">
                            <ItemsRepeater ItemTemplate="{StaticResource EngineStepTemplate}" ItemsSource="{x:Bind ViewModel.EngineSteps}" />
                        </Border>
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Header="Details">
                            <ItemsControl FontFamily="Cascadia Mono,Consolas" ItemsSource="{x:Bind ViewModel.EngineLog}" />
                        </Expander>
                    </StackPanel>

                    <!--  4. Tools and integration  -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsTools, Mode=OneWay}">
                        <TextBlock Style="{StaticResource StepTitleStyle}" Text="How should your tools reach the engine?" />
                        <TextBlock Style="{StaticResource StepTextStyle}" Text="You can change these later in Settings." />
                        <Border Padding="16" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <CheckBox
                                    AutomationProperties.AutomationId="InstallToolsCheck"
                                    Content="Add command-line tools to my PATH"
                                    IsChecked="{x:Bind ViewModel.InstallTools, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanInstallTools, Mode=OneWay}" />
                                <TextBlock
                                    Margin="28,0,0,0"
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="{x:Bind ViewModel.ToolsText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <InfoBar
                                    Margin="28,4,0,0"
                                    IsClosable="False"
                                    IsOpen="{x:Bind ViewModel.HasToolsNote, Mode=OneWay}"
                                    Message="{x:Bind ViewModel.ToolsNote, Mode=OneWay}"
                                    Severity="Informational" />
                            </StackPanel>
                        </Border>
                        <Border Padding="16" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Docker context" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="{x:Bind ViewModel.ContextText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Padding="16" Style="{StaticResource CardStyle}">
                            <CheckBox
                                AutomationProperties.AutomationId="StartAtSignInCheck"
                                Content="Start Contr in the notification area when I sign in"
                                IsChecked="{x:Bind ViewModel.StartAtSignIn, Mode=TwoWay}" />
                        </Border>
                    </StackPanel>

                    <!--  5. Ready  -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                        <Border
                            Width="56"
                            Height="56"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="28">
                            <FontIcon
                                FontSize="24"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;" />
                        </Border>
                        <TextBlock Style="{StaticResource StepTitleStyle}" Text="You're all set" />
                        <TextBlock Style="{StaticResource StepTextStyle}" Text="Contr stays in the notification area when you close its window." />
                        <Border Style="{StaticResource CardStyle}">
                            <ItemsRepeater ItemTemplate="{StaticResource CheckTemplate}" ItemsSource="{x:Bind ViewModel.Summary}" />
                        </Border>
                        <Border Padding="16" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Try it in a new terminal" />
                                <Grid
                                    Padding="12,6,6,6"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Mono,Consolas"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind local:OnboardingWindow.TryCommand}" />
                                    <Button
                                        HorizontalAlignment="Right"
                                        Click="OnCopyTryCommand"
                                        Content="Copy"
                                        Style="{StaticResource ToolbarButtonStyle}" />
                                </Grid>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Open a new terminal so it picks up the updated PATH. Terminals that were already open won't find the docker command yet."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Padding="16" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Find Contr later" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Click the Contr icon in the notification area, next to the clock."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid
                Grid.Row="1"
                Padding="40,16"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="1"
                    MinWidth="96"
                    Click="OnBack"
                    Content="Back"
                    Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />
                <Button
                    Grid.Column="2"
                    MinWidth="96"
                    AutomationProperties.AutomationId="OnboardingNext"
                    Click="OnNext"
                    Content="{x:Bind ViewModel.NextText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</winex:WindowEx>
