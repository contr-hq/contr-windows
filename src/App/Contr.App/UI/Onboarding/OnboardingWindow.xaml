<?xml version="1.0" encoding="utf-8" ?>
<winex:WindowEx
    x:Class="Contr.App.UI.Onboarding.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Contr.App.UI"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Contr.UI.Common.Icons"
    xmlns:local="using:Contr.App.UI.Onboarding"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    Title="Set up Contr"
    Width="1040"
    Height="760"
    MinWidth="760"
    MinHeight="600"
    mc:Ignorable="d">

    <winex:WindowEx.SystemBackdrop>
        <common:TintedMicaBackdrop />
    </winex:WindowEx.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <!--  A check as a settings card: what passes under its name, what was found as a pill.  -->
            <DataTemplate x:Key="CheckTemplate" x:DataType="app:CheckRow">
                <controls:SettingsCard Description="{x:Bind Requirement}" Header="{x:Bind Name}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="{x:Bind local:OnboardingWindow.CheckGlyph(Name)}" Style="{StaticResource IconStyle}" />
                    </controls:SettingsCard.HeaderIcon>
                    <common:PillView Kind="{x:Bind PillKind}" Text="{x:Bind Detail}" />
                </controls:SettingsCard>
            </DataTemplate>

            <DataTemplate x:Key="SummaryTemplate" x:DataType="app:CheckRow">
                <controls:SettingsCard Description="{x:Bind Detail}" Header="{x:Bind Name}">
                    <common:PillView Kind="{x:Bind PillKind}" Text="{x:Bind Outcome}" />
                </controls:SettingsCard>
            </DataTemplate>

            <DataTemplate x:Key="EngineStepTemplate" x:DataType="local:EngineSetupStep">
                <Grid
                    MinHeight="40"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="{x:Bind icons:ContrIcons.SuccessFilled}"
                        Style="{StaticResource IconStyle}"
                        Visibility="{x:Bind IsDone, Mode=OneWay}" />
                    <ProgressRing
                        Width="16"
                        Height="16"
                        IsActive="{x:Bind local:OnboardingWindow.Not(IsDone), Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontWeight="{x:Bind local:OnboardingWindow.StepWeight(IsDone), Mode=OneWay}"
                        Text="{x:Bind Message}"
                        TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>

            <!--  One numbered row of what installing WSL does; the rows after the first are divided.  -->
            <Style x:Key="WslStepStyle" TargetType="Grid">
                <Setter Property="Padding" Value="0,10" />
                <Setter Property="ColumnSpacing" Value="12" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <Style x:Key="StepNumberStyle" TargetType="Border">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <Style x:Key="StepNumberTextStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="StepDetailStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CommandBoxStyle" TargetType="Border">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseAltBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="SetupTitleBar" Title="Set up Contr">
            <TitleBar.LeftHeader>
                <ImageIcon
                    Height="16"
                    Margin="12,0,0,0"
                    Source="ms-appx:///Assets/ContrLogo.png" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <!--  A fixed column: one sized by its content shifts sideways on short steps. MinWidth leaves room for it.  -->
        <ScrollViewer Grid.Row="1">
            <StackPanel
                Width="728"
                Padding="24,8,24,32"
                Spacing="16">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="{x:Bind ViewModel.StepCaption, Mode=OneWay}" />
                    <ProgressBar
                        AutomationProperties.Name="Setup progress"
                        Maximum="{x:Bind ViewModel.Steps.Count}"
                        Value="{x:Bind ViewModel.StepNumber, Mode=OneWay}" />
                </StackPanel>

                <!--  The step's mark: the app on the first step, success on the last.  -->
                <Image
                    Width="48"
                    Height="48"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Source="ms-appx:///Assets/ContrLogo.png"
                    Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay}" />
                <FontIcon
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    FontFamily="{StaticResource ContrIconsFontFamily}"
                    FontSize="48"
                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                    Glyph="{x:Bind icons:ContrIcons.SuccessFilled}"
                    Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}" />

                <StackPanel Margin="0,8,0,0" Spacing="4">
                    <TextBlock
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.StepTitle, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Text="{x:Bind ViewModel.StepLead, Mode=OneWay}" />
                </StackPanel>

                <!--  1. Check this PC  -->
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsChecking, Mode=OneWay}">
                    <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="THIS PC" />
                    <ItemsRepeater ItemTemplate="{StaticResource CheckTemplate}" ItemsSource="{x:Bind ViewModel.Checks}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <!--  2. Install WSL  -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsWsl, Mode=OneWay}">
                    <InfoBar
                        Title="{x:Bind local:OnboardingViewModel.WslErrorTitle}"
                        AutomationProperties.AutomationId="WslError"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasWslError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.WslError, Mode=OneWay}"
                        Severity="Error"
                        Visibility="{x:Bind ViewModel.HasWslError, Mode=OneWay}" />
                    <InfoBar
                        Title="{x:Bind ViewModel.WslDoneTitle, Mode=OneWay}"
                        AutomationProperties.AutomationId="WslDone"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsWslRestartNeeded, Mode=OneWay}"
                        Message="{x:Bind ViewModel.WslDoneMessage, Mode=OneWay}"
                        Severity="Informational"
                        Visibility="{x:Bind ViewModel.IsWslRestartNeeded, Mode=OneWay}" />
                    <InfoBar
                        Title="Needs administrator approval once."
                        IsClosable="False"
                        IsOpen="True"
                        Message="Everything after this step runs as you, without admin rights."
                        Severity="Informational"
                        Visibility="{x:Bind local:OnboardingWindow.WhenNot(ViewModel.IsWslRestartNeeded), Mode=OneWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                        <TextBlock
                            AutomationProperties.AutomationId="WslStatus"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.WslStatus, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Style="{StaticResource CaptionedCardStyle}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,4"
                                Style="{StaticResource CaptionLabelStyle}"
                                Text="WHAT HAPPENS" />
                            <Grid Style="{StaticResource WslStepStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumberStyle}">
                                    <TextBlock Style="{StaticResource StepNumberTextStyle}" Text="1" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Windows asks for administrator approval" />
                                    <TextBlock Style="{StaticResource StepDetailStyle}" Text="If you can't approve it, someone from IT can sign in on the prompt." />
                                </StackPanel>
                            </Grid>
                            <Grid BorderThickness="0,1,0,0" Style="{StaticResource WslStepStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumberStyle}">
                                    <TextBlock Style="{StaticResource StepNumberTextStyle}" Text="2" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="WSL is installed from Microsoft" />
                                    <TextBlock Style="{StaticResource StepDetailStyle}">
                                        <Run Text="Runs" />
                                        <Run FontFamily="Cascadia Mono,Consolas" Text="{x:Bind local:OnboardingWindow.WslCommand}" /><Run Text=". No Linux distribution is added." />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <Grid BorderThickness="0,1,0,0" Style="{StaticResource WslStepStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumberStyle}">
                                    <TextBlock Style="{StaticResource StepNumberTextStyle}" Text="3" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="You restart your PC" />
                                    <TextBlock Style="{StaticResource StepDetailStyle}" Text="Only if Windows asks. Save your work first; you choose when." />
                                </StackPanel>
                            </Grid>
                            <Grid BorderThickness="0,1,0,0" Style="{StaticResource WslStepStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepNumberStyle}">
                                    <TextBlock Style="{StaticResource StepNumberTextStyle}" Text="4" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Setup continues when you open Contr again" />
                                    <TextBlock Style="{StaticResource StepDetailStyle}" Text="It picks up at step 3. No admin rights are needed after this." />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="NoApprovalExpander"
                        Header="Can't get administrator approval?"
                        Visibility="{x:Bind local:OnboardingWindow.WhenNot(ViewModel.IsWslRestartNeeded), Mode=OneWay}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Your IT team can install WSL for you. Send them the instructions, then come back here." TextWrapping="Wrap" />
                            <Button
                                AutomationProperties.AutomationId="CopyItInstructions"
                                Click="OnCopyItInstructions">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind icons:ContrIcons.Copy}" Style="{StaticResource IconStyle}" />
                                    <TextBlock Text="Copy instructions for IT" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <!--  3. Set up the engine  -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsEngine, Mode=OneWay}">
                    <InfoBar
                        Title="The engine didn't start"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasEngineError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.EngineError, Mode=OneWay}"
                        Severity="Error"
                        Visibility="{x:Bind ViewModel.HasEngineError, Mode=OneWay}">
                        <InfoBar.ActionButton>
                            <Button Click="OnRetryEngine" Content="Try again" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <Border Style="{StaticResource CaptionedCardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="PROGRESS" />
                            <ProgressBar
                                IsIndeterminate="{x:Bind local:OnboardingWindow.Both(ViewModel.IsBusy, ViewModel.IsEngineProgressIndeterminate), Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                Value="{x:Bind ViewModel.EngineProgress, Mode=OneWay}" />
                            <ItemsRepeater ItemTemplate="{StaticResource EngineStepTemplate}" ItemsSource="{x:Bind ViewModel.EngineSteps}" />
                        </StackPanel>
                    </Border>
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Header="Details">
                        <ItemsControl
                            FontFamily="Cascadia Mono,Consolas"
                            FontSize="12"
                            ItemsSource="{x:Bind ViewModel.EngineLog}" />
                    </Expander>
                </StackPanel>

                <!--  4. Connect your tools  -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsTools, Mode=OneWay}">
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource CaptionLabelStyle}"
                        Text="COMMAND LINE" />
                    <controls:SettingsCard Description="{x:Bind ViewModel.ToolsText, Mode=OneWay}" Header="Add command-line tools to PATH">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Terminal}" Style="{StaticResource IconStyle}" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            AutomationProperties.AutomationId="InstallToolsCheck"
                            AutomationProperties.Name="Add command-line tools to PATH"
                            IsEnabled="{x:Bind ViewModel.CanInstallTools, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.InstallTools, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasToolsNote, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ToolsNote, Mode=OneWay}"
                        Severity="Informational"
                        Visibility="{x:Bind ViewModel.HasToolsNote, Mode=OneWay}" />
                    <controls:SettingsCard Description="{x:Bind ViewModel.ContextText, Mode=OneWay}" Header="Docker context">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Context}" Style="{StaticResource IconStyle}" />
                        </controls:SettingsCard.HeaderIcon>
                    </controls:SettingsCard>

                    <TextBlock
                        Margin="0,12,0,4"
                        Style="{StaticResource CaptionLabelStyle}"
                        Text="INTEGRATION" />
                    <controls:SettingsExpander
                        AutomationProperties.AutomationId="WslDistributionsCard"
                        Description="docker inside the checked distros talks to Contr"
                        Header="Use the engine from your WSL distros"
                        IsExpanded="True"
                        ItemsSource="{x:Bind ViewModel.Distributions}"
                        Visibility="{x:Bind ViewModel.HasDistributions, Mode=OneWay}">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Distros}" Style="{StaticResource IconStyle}" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.ItemTemplate>
                            <DataTemplate x:DataType="app:WslDistributionItem">
                                <controls:SettingsCard ContentAlignment="Left">
                                    <CheckBox IsChecked="{x:Bind IsOn, Mode=TwoWay}" IsEnabled="{x:Bind CanChange}">
                                        <StackPanel>
                                            <TextBlock>
                                                <Run FontFamily="Cascadia Mono,Consolas" Text="{x:Bind Name}" />
                                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DefaultText}" />
                                            </TextBlock>
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Detail, Mode=OneWay}" />
                                        </StackPanel>
                                    </CheckBox>
                                </controls:SettingsCard>
                            </DataTemplate>
                        </controls:SettingsExpander.ItemTemplate>
                    </controls:SettingsExpander>
                    <controls:SettingsCard Description="Runs in the notification area" Header="Start Contr when I sign in">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Power}" Style="{StaticResource IconStyle}" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            AutomationProperties.AutomationId="StartAtSignInCheck"
                            AutomationProperties.Name="Start Contr when I sign in"
                            IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=TwoWay}" />
                    </controls:SettingsCard>
                    <!--  What the app sends to other systems is shown, with a way to turn it off, before setup ends.  -->
                    <controls:SettingsCard
                        AutomationProperties.AutomationId="UpdateCheckCard"
                        Description="{x:Bind ViewModel.UpdateCheckText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.OffersUpdateCheck, Mode=OneWay}">
                        <controls:SettingsCard.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Check for new releases" />
                                <common:PillView
                                    Kind="Locked"
                                    Text="Managed by your organization"
                                    Visibility="{x:Bind ViewModel.IsUpdateCheckLocked, Mode=OneWay}" />
                            </StackPanel>
                        </controls:SettingsCard.Header>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Sync}" Style="{StaticResource IconStyle}" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            AutomationProperties.AutomationId="UpdateCheckSwitch"
                            AutomationProperties.Name="Check for new releases"
                            IsEnabled="{x:Bind ViewModel.CanChooseUpdateCheck, Mode=OneWay}"
                            IsOn="{x:Bind ViewModel.ChecksForUpdates, Mode=TwoWay}" />
                    </controls:SettingsCard>
                </StackPanel>

                <!--  5. Ready  -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsReady, Mode=OneWay}">
                    <Border Style="{StaticResource CaptionedCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="TRY IT IN A NEW TERMINAL" />
                                <Button HorizontalAlignment="Right" Click="OnCopyTryCommand">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Copy}" Style="{StaticResource IconStyle}" />
                                        <TextBlock Text="Copy" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Style="{StaticResource CommandBoxStyle}">
                                <TextBlock
                                    FontFamily="Cascadia Mono,Consolas"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind local:OnboardingWindow.TryPrompt}" />
                            </Border>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Open a new terminal so it picks up the updated PATH. Terminals that were already open won't find docker yet."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="4">
                        <TextBlock
                            Margin="0,0,0,4"
                            Style="{StaticResource CaptionLabelStyle}"
                            Text="WHAT'S SET UP" />
                        <ItemsRepeater ItemTemplate="{StaticResource SummaryTemplate}" ItemsSource="{x:Bind ViewModel.Summary}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="4" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock
                            Margin="0,0,0,4"
                            Style="{StaticResource CaptionLabelStyle}"
                            Text="WHAT'S NEXT" />
                        <controls:SettingsCard Description="Next to the clock. Contr stays there when you close the window." Header="Find Contr in the notification area">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="{x:Bind icons:ContrIcons.NotificationArea}" Style="{StaticResource IconStyle}" />
                            </controls:SettingsCard.HeaderIcon>
                        </controls:SettingsCard>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="24,20"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid MaxWidth="680" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    MinWidth="96"
                    Click="OnBack"
                    Content="Back"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        MinWidth="96"
                        AutomationProperties.AutomationId="OnboardingNotNow"
                        Click="OnNotNow"
                        Content="Not now"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CanPostpone, Mode=OneWay}" />
                    <Button
                        MinWidth="96"
                        AutomationProperties.AutomationId="OnboardingNext"
                        AutomationProperties.Name="{x:Bind ViewModel.NextText, Mode=OneWay}"
                        Click="OnNext"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                Glyph="{x:Bind icons:ContrIcons.Shield}"
                                Style="{StaticResource IconStyle}"
                                Visibility="{x:Bind ViewModel.NextNeedsApproval, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.NextText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</winex:WindowEx>
