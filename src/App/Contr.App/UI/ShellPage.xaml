<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.App.UI.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Contr.UI.Common.Icons"
    xmlns:local="using:Contr.App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:search="using:Contr.UI.Contracts.Services.Search"
    Loaded="OnShellPageLoaded"
    Unloaded="OnShellPageUnloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="StatusBarTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Contr"
            BackRequested="OnTitleBarBackRequested"
            Canvas.ZIndex="1"
            IsBackButtonVisible="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.LeftHeader>
                <ImageIcon
                    Height="16"
                    Margin="8,0"
                    Source="ms-appx:///Assets/ContrLogo.png" />
            </TitleBar.LeftHeader>
            <AutoSuggestBox
                x:Name="SearchBox"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="GlobalSearch"
                AutomationProperties.Name="Search containers, images, volumes and networks"
                PlaceholderText="Search containers, images, volumes"
                QueryIcon="Find"
                QuerySubmitted="OnSearchSubmitted"
                TextChanged="OnSearchTextChanged"
                UpdateTextOnSelect="False">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="search:SearchHit">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource ContrIconsFontFamily}"
                                FontSize="16"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="{x:Bind Glyph}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Detail}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AlwaysShowHeader="False"
            Canvas.ZIndex="0"
            ExpandedModeThresholdWidth="600"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTabStop="False"
            OpenPaneLength="240"
            PaneDisplayMode="Left"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
            ItemInvoked="OnNavViewItemInvoked"
            SelectionChanged="OnNavViewSelectionChanged">

            <!--  The design's pane icons are 20 px, where the item template boxes them at 16.  -->
            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">20</x:Double>
            </NavigationView.Resources>

            <Frame x:Name="NavFrame" />
        </NavigationView>

        <StackPanel
            Grid.Row="2"
            Height="32"
            Padding="12,0,16,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Orientation="Horizontal"
            Spacing="20">
            <Button
                x:Name="EngineStatusPill"
                Padding="4,2"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="EngineStatusPill"
                AutomationProperties.Name="{x:Bind ViewModel.EngineStatus.Text, Mode=OneWay}"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="{x:Bind local:ShellPage.ToolTipFor(ViewModel.EngineStatus.Detail), Mode=OneWay}">
                <controls:StatusLabel
                    FontSize="12"
                    Kind="{x:Bind ViewModel.EngineStatus.Kind, Mode=OneWay}"
                    Text="{x:Bind ViewModel.EngineStatus.Text, Mode=OneWay}" />
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedLeft">
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.StartEngineCommand}"
                            Text="Start engine">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ContrIconsFontFamily}" Glyph="{x:Bind icons:ContrIcons.Play}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.StopEngineCommand}"
                            Text="Stop engine">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ContrIconsFontFamily}" Glyph="{x:Bind icons:ContrIcons.Stop}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Command="{x:Bind ViewModel.RestartEngineCommand}"
                            Text="Restart engine">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ContrIconsFontFamily}" Glyph="{x:Bind icons:ContrIcons.Restart}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <TextBlock
                Style="{StaticResource StatusBarTextStyle}"
                Text="{x:Bind ViewModel.SinceText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasSince, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource StatusBarTextStyle}"
                Text="{x:Bind ViewModel.BackendText, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.DaemonVersionText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasBackend, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource StatusBarTextStyle}"
                Text="{x:Bind ViewModel.EngineVersionText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasEngineVersion, Mode=OneWay}" />
            <TextBlock
                AutomationProperties.AutomationId="StatusBarCpu"
                Style="{StaticResource StatusBarTextStyle}"
                Text="{x:Bind ViewModel.CpuText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasUsage, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource StatusBarTextStyle}"
                Text="{x:Bind ViewModel.MemoryText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasUsage, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource StatusBarTextStyle}"
                Text="{x:Bind ViewModel.DiskText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasDisk, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource StatusBarTextStyle}"
                Text="{x:Bind ViewModel.ContextText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasContext, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
