<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.App.UI.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Contr.App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnShellPageLoaded"
    Unloaded="OnShellPageUnloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Contr"
            BackRequested="OnTitleBarBackRequested"
            Canvas.ZIndex="1"
            IsBackButtonVisible="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.LeftHeader>
                <ImageIcon
                    Height="16"
                    Margin="8,0"
                    Source="ms-appx:///Assets/ContrLogo.png" />
            </TitleBar.LeftHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AlwaysShowHeader="False"
            Canvas.ZIndex="0"
            ExpandedModeThresholdWidth="600"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTabStop="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
            SelectionChanged="OnNavViewSelectionChanged">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="AppNotificationBar"
                    Margin="16,8,16,0"
                    IsClosable="True"
                    IsOpen="False" />

                <Frame x:Name="NavFrame" Grid.Row="1" />

                <Grid
                    Grid.Row="2"
                    Padding="12,6"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="EngineStatusPill"
                        Padding="10,3"
                        AutomationProperties.AutomationId="EngineStatusPill"
                        AutomationProperties.Name="{x:Bind ViewModel.EngineStatus.Text, Mode=OneWay}"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        CornerRadius="11"
                        ToolTipService.ToolTip="{x:Bind local:ShellPage.ToolTipFor(ViewModel.EngineStatus.Detail), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{x:Bind local:ShellPage.ToneBrush(ViewModel.EngineStatus.Tone), Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{x:Bind ViewModel.EngineStatus.Text, Mode=OneWay}" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedLeft">
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.StartEngineCommand}"
                                    Text="Start engine">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.StopEngineCommand}"
                                    Text="Stop engine">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE71A;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.RestartEngineCommand}"
                                    Text="Restart engine">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72C;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.DaemonText, Mode=OneWay}" />
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
