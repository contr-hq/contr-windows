<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.App.UI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Contr.UI.Common.Icons"
    xmlns:local="using:Contr.App.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsGroups.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  A row of the installed versions; the columns line up with the header in ItemsHeader.  -->
            <DataTemplate x:Key="ComponentTemplate" x:DataType="local:InstalledComponent">
                <Border Style="{StaticResource TableRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind Name}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind WhatItIs}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Mono,Consolas"
                            FontSize="13"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Version}" />
                        <common:PillView
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Kind="{x:Bind Kind}"
                            Text="{x:Bind Status}"
                            Visibility="{x:Bind HasStatus}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!--  A row of the tools table: the columns line up with the header in ItemsHeader.  -->
            <DataTemplate x:Key="ToolTemplate" x:DataType="local:CliToolRow">
                <Border Style="{StaticResource TableRowStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontFamily="Cascadia Mono,Consolas"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="{x:Bind Name}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Description}" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Mono,Consolas"
                            FontSize="13"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Version}" />
                        <common:PillView
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Kind="{x:Bind Kind}"
                            Text="{x:Bind Status}" />
                    </Grid>
                </Border>
            </DataTemplate>

            <!--  A table inside an expander card: rows line up under the header's text, dividers between.  -->
            <Style x:Key="TableRowStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="52" />
                <Setter Property="Padding" Value="52,14,16,14" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>

            <Style x:Key="TableHeaderStyle" TargetType="Grid">
                <Setter Property="Padding" Value="52,8,16,8" />
                <Setter Property="ColumnSpacing" Value="16" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>

            <Style x:Key="ProxyFieldStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
                <Setter Property="Margin" Value="0,6,0,0" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <Grid Padding="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="{StaticResource PageContentMaxWidth}" />
                </Grid.ColumnDefinitions>

                <!--  Margins rather than spacing, so a closed bar leaves no gap behind.  -->
                <StackPanel>
                    <common:PageHeader Trail="{x:Bind local:SettingsPage.Trail(ViewModel.TabIndex), Mode=OneWay}" TrailClicked="OnTrailClicked" />

                    <InfoBar
                        Title="Some settings are managed by your organization."
                        Margin="0,16,0,0"
                        AutomationProperties.AutomationId="ManagedSettings"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.HasLockedSettings, Mode=OneWay}"
                        Message="Settings with a lock can only be changed by your IT admin."
                        Severity="Informational"
                        Visibility="{x:Bind ViewModel.HasLockedSettings, Mode=OneWay}">
                        <InfoBar.IconSource>
                            <FontIconSource FontFamily="{StaticResource ContrIconsFontFamily}" Glyph="{x:Bind icons:ContrIcons.Organization}" />
                        </InfoBar.IconSource>
                    </InfoBar>

                    <!--  The open tab's messages, under the breadcrumb and before the tabs.  -->
                    <InfoBar
                        Title="Resource limits are not available yet"
                        Margin="0,16,0,0"
                        IsClosable="False"
                        IsOpen="{x:Bind local:SettingsPage.Shows(ViewModel.TabIndex, 1, ViewModel.LacksResourceLimits), Mode=OneWay}"
                        Message="This version of the Contr daemon cannot change the WSL virtual machine's limits."
                        Severity="Informational"
                        Visibility="{x:Bind local:SettingsPage.WhenShown(ViewModel.TabIndex, 1, ViewModel.LacksResourceLimits), Mode=OneWay}" />
                    <InfoBar
                        Title="WSL integration is not available yet"
                        Margin="0,16,0,0"
                        IsClosable="False"
                        IsOpen="{x:Bind local:SettingsPage.Shows(ViewModel.TabIndex, 1, ViewModel.LacksWslIntegration), Mode=OneWay}"
                        Message="This version of the Contr daemon does not integrate your WSL distributions."
                        Severity="Informational"
                        Visibility="{x:Bind local:SettingsPage.WhenShown(ViewModel.TabIndex, 1, ViewModel.LacksWslIntegration), Mode=OneWay}" />
                    <InfoBar
                        Title="WSL integration didn't change"
                        Margin="0,16,0,0"
                        IsClosable="False"
                        IsOpen="{x:Bind local:SettingsPage.Shows(ViewModel.TabIndex, 1, ViewModel.HasWslError), Mode=OneWay}"
                        Message="{x:Bind ViewModel.WslError, Mode=OneWay}"
                        Severity="Error"
                        Visibility="{x:Bind local:SettingsPage.WhenShown(ViewModel.TabIndex, 1, ViewModel.HasWslError), Mode=OneWay}" />
                    <InfoBar
                        Title="Proxy and certificate settings aren't available"
                        Margin="0,16,0,0"
                        IsClosable="False"
                        IsOpen="True"
                        Message="This engine doesn't take proxy, certificate or registry mirror settings from Contr."
                        Severity="Informational"
                        Visibility="{x:Bind local:SettingsPage.WhenShown(ViewModel.TabIndex, 2, ViewModel.Proxies.LacksOffer), Mode=OneWay}" />
                    <InfoBar
                        Title="Engine configuration is not available yet"
                        Margin="0,16,0,0"
                        IsClosable="False"
                        IsOpen="True"
                        Message="This version of the Contr daemon cannot edit the engine's daemon.json."
                        Severity="Informational"
                        Visibility="{x:Bind local:SettingsPage.When(ViewModel.TabIndex, 3), Mode=OneWay}" />
                    <InfoBar
                        Title="Updates are not available yet"
                        Margin="0,16,0,0"
                        IsClosable="False"
                        IsOpen="True"
                        Message="This version of Contr does not check for updates."
                        Severity="Informational"
                        Visibility="{x:Bind local:SettingsPage.When(ViewModel.TabIndex, 5), Mode=OneWay}" />

                    <SelectorBar
                        x:Name="Tabs"
                        Margin="0,8,0,0"
                        SelectionChanged="OnTabSelectionChanged">
                        <SelectorBarItem x:Name="GeneralTab" Text="General" />
                        <SelectorBarItem x:Name="ResourcesTab" Text="Resources" />
                        <SelectorBarItem x:Name="ProxiesTab" Text="Proxies and certificates" />
                        <SelectorBarItem x:Name="EngineTab" Text="Engine" />
                        <SelectorBarItem x:Name="KubernetesTab" Text="Kubernetes" />
                        <SelectorBarItem x:Name="UpdatesTab" Text="Updates" />
                    </SelectorBar>

                    <!--  General  -->
                    <StackPanel
                        Margin="0,12,0,0"
                        Spacing="16"
                        Visibility="{x:Bind local:SettingsPage.When(ViewModel.TabIndex, 0), Mode=OneWay}">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Changes on this page apply right away." />

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="STARTUP AND CLOSING" />
                                <controls:SettingsCard
                                    BorderThickness="0"
                                    Description="Opens in the notification area, not as a window."
                                    Header="Start Contr when I sign in to Windows">
                                    <ToggleSwitch AutomationProperties.AutomationId="StartAtSignInToggle" IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard Description="Turn off to start it yourself from the tray when you need it.">
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Start the engine with Contr" />
                                            <common:PillView
                                                Kind="Locked"
                                                Text="Managed by your organization"
                                                Visibility="{x:Bind ViewModel.Autostart.IsLocked, Mode=OneWay}" />
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <ToggleSwitch
                                        AutomationProperties.AutomationId="StartsEngineToggle"
                                        AutomationProperties.Name="Start the engine with Contr"
                                        IsEnabled="{x:Bind ViewModel.Autostart.CanChange, Mode=OneWay}"
                                        IsOn="{x:Bind ViewModel.Autostart.IsOn, Mode=TwoWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    HorizontalContentAlignment="Left"
                                    ContentAlignment="Vertical"
                                    Header="When I close the window">
                                    <RadioButtons SelectedIndex="0">
                                        <RadioButton Content="Keep running in the notification area" />
                                        <RadioButton Content="Quit Contr and stop the engine" IsEnabled="False" />
                                    </RadioButtons>
                                </controls:SettingsCard>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="APPEARANCE" />
                                <controls:SettingsCard
                                    BorderThickness="0"
                                    Description="Choose the colors that appear in the app."
                                    Header="Theme">
                                    <ComboBox MinWidth="150" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="System default" />
                                        <ComboBoxItem Content="Light" />
                                        <ComboBoxItem Content="Dark" />
                                    </ComboBox>
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Description="Follow the Windows accent, or use Contr's own."
                                    Header="Accent color"
                                    Visibility="{x:Bind ViewModel.HasAccentChoice}">
                                    <ComboBox MinWidth="150" SelectedIndex="{x:Bind ViewModel.AccentIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Windows" />
                                        <ComboBoxItem Content="Contr" />
                                    </ComboBox>
                                </controls:SettingsCard>
                            </StackPanel>
                        </Border>

                        <!--  The tools are a table, so their caption sits above the card, as the board shows.  -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource CaptionLabelStyle}"
                                Text="COMMAND-LINE TOOLS" />
                            <Border Padding="0" Style="{StaticResource CardStyle}">
                                <controls:SettingsExpander
                                    AutomationProperties.AutomationId="CliTools"
                                    Description="{x:Bind ViewModel.ToolsDetail, Mode=OneWay}"
                                    Header="{x:Bind ViewModel.ToolsTitle, Mode=OneWay}"
                                    IsExpanded="True"
                                    ItemTemplate="{StaticResource ToolTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Tools}">
                                    <controls:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Terminal}" Style="{StaticResource IconStyle}" />
                                    </controls:SettingsExpander.HeaderIcon>
                                    <common:PillView
                                        Kind="{x:Bind local:SettingsPage.KindOf(ViewModel.ToolsSummary), Mode=OneWay}"
                                        Text="{x:Bind local:SettingsPage.TextOf(ViewModel.ToolsSummary), Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasToolsSummary, Mode=OneWay}" />
                                    <controls:SettingsExpander.ItemsHeader>
                                        <Grid Style="{StaticResource TableHeaderStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="170" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="TOOL" />
                                            <TextBlock
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionLabelStyle}"
                                                Text="VERSION" />
                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionLabelStyle}"
                                                Text="STATUS" />
                                        </Grid>
                                    </controls:SettingsExpander.ItemsHeader>
                                    <controls:SettingsExpander.ItemsFooter>
                                        <controls:SettingsCard
                                            Padding="52,14,16,14"
                                            Description="Reinstalls them and puts the folder back on your PATH."
                                            Header="Repair the tools">
                                            <Button
                                                AutomationProperties.AutomationId="InstallToolsButton"
                                                Command="{x:Bind ViewModel.InstallToolsCommand}"
                                                Content="{x:Bind ViewModel.InstallToolsText, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanInstallTools, Mode=OneWay}" />
                                        </controls:SettingsCard>
                                    </controls:SettingsExpander.ItemsFooter>
                                </controls:SettingsExpander>
                            </Border>
                            <InfoBar
                                Title="docker is second on your PATH."
                                AutomationProperties.AutomationId="PathWarning"
                                IsClosable="False"
                                IsOpen="{x:Bind ViewModel.HasPathWarning, Mode=OneWay}"
                                Message="{x:Bind ViewModel.PathWarning, Mode=OneWay}"
                                Severity="Informational"
                                Visibility="{x:Bind ViewModel.HasPathWarning, Mode=OneWay}" />
                        </StackPanel>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="HOW TOOLS CONNECT" />
                                <controls:SettingsCard
                                    BorderThickness="0"
                                    Description="The Docker context Contr made for this engine. Make it current with docker context use."
                                    Header="Docker context">
                                    <TextBlock
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource IdentifierTextStyle}"
                                        Text="{x:Bind local:SettingsPage.OrDash(ViewModel.ContextName)}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard Visibility="{x:Bind ViewModel.HasDaemonSettings, Mode=OneWay}">
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Also listen on the standard Docker pipe" />
                                            <common:PillView
                                                Kind="Locked"
                                                Text="Managed by your organization"
                                                Visibility="{x:Bind ViewModel.IsDefaultPipeLocked, Mode=OneWay}" />
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <controls:SettingsCard.Description>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="For tools that ignore contexts:" />
                                            <Run FontFamily="Cascadia Mono,Consolas" Text="\\.\pipe\docker_engine" /><Run Text=", while no other program uses it. Applies at the next engine start." />
                                        </TextBlock>
                                    </controls:SettingsCard.Description>
                                    <ToggleSwitch
                                        AutomationProperties.AutomationId="DefaultPipeToggle"
                                        AutomationProperties.Name="Also listen on the standard Docker pipe"
                                        IsEnabled="{x:Bind ViewModel.CanChangeDefaultPipe, Mode=OneWay}"
                                        IsOn="{x:Bind ViewModel.ServesDefaultPipe, Mode=TwoWay}" />
                                </controls:SettingsCard>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="DAEMON AND DIAGNOSTICS" />
                                <controls:SettingsCard
                                    BorderThickness="0"
                                    Description="{x:Bind ViewModel.DaemonDescription}"
                                    Header="Contr daemon">
                                    <TextBlock
                                        MaxWidth="420"
                                        FontSize="12"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource IdentifierTextStyle}"
                                        Text="{x:Bind ViewModel.DaemonEndpoint}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard Description="Errors are written to a log file on this machine. Nothing is sent anywhere." Header="Log files">
                                    <Button
                                        AutomationProperties.Name="Open the log folder"
                                        Command="{x:Bind ViewModel.OpenLogFolderCommand}"
                                        Content="Open log folder" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Description="Returns the engine settings you changed here to their defaults."
                                    Header="Engine settings"
                                    Visibility="{x:Bind ViewModel.HasDaemonSettings, Mode=OneWay}">
                                    <Button
                                        AutomationProperties.AutomationId="ResetSettingsButton"
                                        Click="OnResetSettings"
                                        Content="Reset to defaults"
                                        IsEnabled="{x:Bind local:SettingsPage.Not(ViewModel.IsResetting), Mode=OneWay}" />
                                </controls:SettingsCard>
                                <controls:SettingsCard Description="Checks this PC, sets up the engine and the tools again." Header="Setup">
                                    <Button
                                        AutomationProperties.AutomationId="RunSetupButton"
                                        Click="OnRunSetup"
                                        Content="Run setup again" />
                                </controls:SettingsCard>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Resources  -->
                    <StackPanel
                        Margin="0,12,0,0"
                        Spacing="16"
                        Visibility="{x:Bind local:SettingsPage.When(ViewModel.TabIndex, 1), Mode=OneWay}">
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="WSL 2 VIRTUAL MACHINE" />
                                <controls:SettingsCard
                                    BorderThickness="0"
                                    Description="Maximum memory for the WSL VM. Containers share it."
                                    Header="Memory"
                                    IsEnabled="False">
                                    <controls:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Memory}" Style="{StaticResource IconStyle}" />
                                    </controls:SettingsCard.HeaderIcon>
                                    <Slider Width="200" AutomationProperties.Name="Memory" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Description="{x:Bind local:SettingsPage.ProcessorsText()}"
                                    Header="Processors"
                                    IsEnabled="False">
                                    <controls:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Processor}" Style="{StaticResource IconStyle}" />
                                    </controls:SettingsCard.HeaderIcon>
                                    <ComboBox MinWidth="120" PlaceholderText="—" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Description="Mirrored works best with VPNs. NAT keeps containers on a private subnet."
                                    Header="Networking mode"
                                    IsEnabled="False">
                                    <controls:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Networks}" Style="{StaticResource IconStyle}" />
                                    </controls:SettingsCard.HeaderIcon>
                                    <ComboBox MinWidth="150" PlaceholderText="—" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Description="Where the engine keeps images, containers and volumes."
                                    Header="Data disk location"
                                    IsEnabled="False">
                                    <controls:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Disk}" Style="{StaticResource IconStyle}" />
                                    </controls:SettingsCard.HeaderIcon>
                                    <Button Content="Move…" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Description="Shrinks the virtual disk when images and volumes are removed."
                                    Header="Give unused disk space back to Windows"
                                    IsEnabled="False">
                                    <controls:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Sync}" Style="{StaticResource IconStyle}" />
                                    </controls:SettingsCard.HeaderIcon>
                                    <ToggleSwitch />
                                </controls:SettingsCard>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="WSL INTEGRATION" />
                                <TextBlock
                                    Margin="0,4,0,6"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap">
                                    <Run Text="Make the" />
                                    <Run FontFamily="Cascadia Mono,Consolas" Text="docker" />
                                    <Run Text="command work inside your own distros. Contr shares one engine with all of them." />
                                </TextBlock>
                                <!--  Switches apply when flipped. The template insets the header 16 px; the margin undoes it.  -->
                                <controls:SettingsExpander
                                    Margin="-16,0,-16,0"
                                    AutomationProperties.AutomationId="WslDistributions"
                                    Description="{x:Bind local:SettingsPage.Or(ViewModel.WslSummary, 'docker inside these distros talks to Contr.'), Mode=OneWay}"
                                    Header="Your distros"
                                    IsEnabled="{x:Bind ViewModel.OffersWslIntegration}"
                                    IsExpanded="True"
                                    ItemsSource="{x:Bind ViewModel.Distributions}">
                                    <controls:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Distros}" Style="{StaticResource IconStyle}" />
                                    </controls:SettingsExpander.HeaderIcon>
                                    <controls:SettingsExpander.ItemTemplate>
                                        <DataTemplate x:DataType="local:WslDistributionItem">
                                            <controls:SettingsCard Description="{x:Bind Detail, Mode=OneWay}" IsEnabled="{x:Bind CanChange, Mode=OneWay}">
                                                <controls:SettingsCard.Header>
                                                    <TextBlock>
                                                        <Run FontFamily="Cascadia Mono,Consolas" Text="{x:Bind Name}" />
                                                        <Run
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind DefaultText, Mode=OneWay}" />
                                                    </TextBlock>
                                                </controls:SettingsCard.Header>
                                                <ToggleSwitch AutomationProperties.Name="{x:Bind Name}" IsOn="{x:Bind IsOn, Mode=TwoWay}" />
                                            </controls:SettingsCard>
                                        </DataTemplate>
                                    </controls:SettingsExpander.ItemTemplate>
                                </controls:SettingsExpander>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Proxies and certificates  -->
                    <StackPanel
                        Margin="0,12,0,0"
                        Spacing="16"
                        Visibility="{x:Bind local:SettingsPage.When(ViewModel.TabIndex, 2), Mode=OneWay}">
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="PROXY" />
                                <controls:SettingsCard
                                    BorderThickness="0"
                                    HorizontalContentAlignment="Left"
                                    ContentAlignment="Vertical"
                                    Description="Used for image pulls and builds.">
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="How the engine finds your proxy" />
                                            <common:PillView
                                                Kind="Locked"
                                                Text="Managed by your organization"
                                                Visibility="{x:Bind ViewModel.Proxies.IsModeLocked, Mode=OneWay}" />
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <!--  One row at each choice's own width, as the board spaces them.  -->
                                    <StackPanel
                                        AutomationProperties.Name="How the engine finds your proxy"
                                        Orientation="Horizontal"
                                        Spacing="24"
                                        XYFocusKeyboardNavigation="Enabled">
                                        <RadioButton
                                            MinWidth="0"
                                            AutomationProperties.AutomationId="ProxyModeSystem"
                                            Checked="OnProxyModeChecked"
                                            Content="Use Windows settings"
                                            GroupName="ProxyMode"
                                            IsChecked="{x:Bind local:SettingsPage.Is(ViewModel.Proxies.ModeIndex, 0), Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.Proxies.CanEditMode, Mode=OneWay}"
                                            Tag="0" />
                                        <RadioButton
                                            MinWidth="0"
                                            AutomationProperties.AutomationId="ProxyModeManual"
                                            Checked="OnProxyModeChecked"
                                            Content="Manual"
                                            GroupName="ProxyMode"
                                            IsChecked="{x:Bind local:SettingsPage.Is(ViewModel.Proxies.ModeIndex, 1), Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.Proxies.CanEditMode, Mode=OneWay}"
                                            Tag="1" />
                                        <RadioButton
                                            MinWidth="0"
                                            AutomationProperties.AutomationId="ProxyModeNone"
                                            Checked="OnProxyModeChecked"
                                            Content="No proxy"
                                            GroupName="ProxyMode"
                                            IsChecked="{x:Bind local:SettingsPage.Is(ViewModel.Proxies.ModeIndex, 2), Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.Proxies.CanEditMode, Mode=OneWay}"
                                            Tag="2" />
                                    </StackPanel>
                                </controls:SettingsCard>
                                <!--  The servers apply in manual mode; they stay visible, disabled, in the others.  -->
                                <Grid
                                    Padding="36,12,0,16"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    ColumnSpacing="16"
                                    RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="HTTP proxy" />
                                            <common:PillView
                                                Kind="Locked"
                                                Text="Managed by your organization"
                                                Visibility="{x:Bind ViewModel.Proxies.IsHttpLocked, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBox
                                            AutomationProperties.AutomationId="ProxyHttp"
                                            AutomationProperties.Name="HTTP proxy"
                                            IsEnabled="{x:Bind ViewModel.Proxies.CanEditHttp, Mode=OneWay}"
                                            PlaceholderText="http://proxy.example.com:8080"
                                            Style="{StaticResource ProxyFieldStyle}"
                                            Text="{x:Bind ViewModel.Proxies.Http, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="HTTPS proxy" />
                                            <common:PillView
                                                Kind="Locked"
                                                Text="Managed by your organization"
                                                Visibility="{x:Bind ViewModel.Proxies.IsHttpsLocked, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBox
                                            AutomationProperties.AutomationId="ProxyHttps"
                                            AutomationProperties.Name="HTTPS proxy"
                                            IsEnabled="{x:Bind ViewModel.Proxies.CanEditHttps, Mode=OneWay}"
                                            PlaceholderText="http://proxy.example.com:8080"
                                            Style="{StaticResource ProxyFieldStyle}"
                                            Text="{x:Bind ViewModel.Proxies.Https, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Don't use the proxy for" />
                                            <common:PillView
                                                Kind="Locked"
                                                Text="Managed by your organization"
                                                Visibility="{x:Bind ViewModel.Proxies.IsExcludeLocked, Mode=OneWay}" />
                                        </StackPanel>
                                        <TextBox
                                            AutomationProperties.AutomationId="ProxyExclude"
                                            AutomationProperties.Name="Don't use the proxy for"
                                            IsEnabled="{x:Bind ViewModel.Proxies.CanEditExclude, Mode=OneWay}"
                                            PlaceholderText="localhost, 127.0.0.1, .corp.example.com"
                                            Style="{StaticResource ProxyFieldStyle}"
                                            Text="{x:Bind ViewModel.Proxies.Exclude, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <controls:SettingsCard
                                    Description="Sets HTTP_PROXY, HTTPS_PROXY and NO_PROXY in new containers and builds."
                                    Header="Pass these settings to containers"
                                    IsEnabled="False">
                                    <ToggleSwitch />
                                </controls:SettingsCard>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="CERTIFICATES" />
                                <controls:SettingsCard BorderThickness="0" Description="Copies your organization's root certificates into the engine, so pulls work when your network inspects HTTPS traffic.">
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Trust certificates from Windows" />
                                            <common:PillView
                                                Kind="Locked"
                                                Text="Managed by your organization"
                                                Visibility="{x:Bind ViewModel.Proxies.IsTrustLocked, Mode=OneWay}" />
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <controls:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Certificate}" Style="{StaticResource IconStyle}" />
                                    </controls:SettingsCard.HeaderIcon>
                                    <ToggleSwitch
                                        AutomationProperties.AutomationId="TrustSystemCertificates"
                                        AutomationProperties.Name="Trust certificates from Windows"
                                        IsEnabled="{x:Bind ViewModel.Proxies.CanEditTrust, Mode=OneWay}"
                                        IsOn="{x:Bind ViewModel.Proxies.TrustsSystemCertificates, Mode=TwoWay}" />
                                </controls:SettingsCard>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="REGISTRY" />
                                <controls:SettingsCard BorderThickness="0" Description="Pulls from Docker Hub go through this mirror first.">
                                    <controls:SettingsCard.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Registry mirror" />
                                            <common:PillView
                                                Kind="Locked"
                                                Text="Managed by your organization"
                                                Visibility="{x:Bind ViewModel.Proxies.IsMirrorLocked, Mode=OneWay}" />
                                        </StackPanel>
                                    </controls:SettingsCard.Header>
                                    <TextBox
                                        MinWidth="260"
                                        AutomationProperties.AutomationId="RegistryMirror"
                                        AutomationProperties.Name="Registry mirror"
                                        FontFamily="Cascadia Mono,Consolas"
                                        IsEnabled="{x:Bind ViewModel.Proxies.CanEditMirror, Mode=OneWay}"
                                        PlaceholderText="https://"
                                        Text="{x:Bind ViewModel.Proxies.Mirror, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </controls:SettingsCard>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Engine  -->
                    <StackPanel
                        Margin="0,12,0,0"
                        Spacing="16"
                        Visibility="{x:Bind local:SettingsPage.When(ViewModel.TabIndex, 3), Mode=OneWay}">
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="ENGINE CONFIGURATION" />
                                <controls:SettingsCard
                                    BorderThickness="0"
                                    Description="The engine's own configuration file. Contr adds your proxy and certificate settings to it when the engine starts."
                                    Header="daemon.json"
                                    IsEnabled="False">
                                    <Button Content="Reset to defaults" />
                                </controls:SettingsCard>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Kubernetes  -->
                    <StackPanel
                        Margin="0,12,0,0"
                        Spacing="16"
                        Visibility="{x:Bind local:SettingsPage.When(ViewModel.TabIndex, 4), Mode=OneWay}">
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="KUBERNETES" />
                                <controls:SettingsCard
                                    BorderThickness="0"
                                    Description="The cluster's settings are on the Kubernetes page."
                                    Header="Kubernetes">
                                    <controls:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Kubernetes}" Style="{StaticResource IconStyle}" />
                                    </controls:SettingsCard.HeaderIcon>
                                    <Button Click="OnOpenKubernetes" Content="Open Kubernetes" />
                                </controls:SettingsCard>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Updates  -->
                    <StackPanel
                        Margin="0,12,0,0"
                        Spacing="16"
                        Visibility="{x:Bind local:SettingsPage.When(ViewModel.TabIndex, 5), Mode=OneWay}">
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="UPDATE SETTINGS" />
                                <controls:SettingsCard
                                    BorderThickness="0"
                                    Description="Which releases Contr installs."
                                    Header="Release channel"
                                    IsEnabled="False">
                                    <ComboBox MinWidth="160" PlaceholderText="—" />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Description="Contr never restarts the engine without asking."
                                    Header="Download updates in the background"
                                    IsEnabled="False">
                                    <ToggleSwitch />
                                </controls:SettingsCard>
                                <controls:SettingsCard
                                    Description="Never checked."
                                    Header="Check for updates"
                                    IsEnabled="False">
                                    <Button Content="Check now" />
                                </controls:SettingsCard>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8">
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource CaptionLabelStyle}"
                                Text="INSTALLED VERSIONS" />
                            <Border Padding="0" Style="{StaticResource CardStyle}">
                                <controls:SettingsExpander
                                    AutomationProperties.AutomationId="InstalledVersions"
                                    Description="{x:Bind ViewModel.ComponentsSummary, Mode=OneWay}"
                                    IsExpanded="True"
                                    ItemTemplate="{StaticResource ComponentTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Components}">
                                    <controls:SettingsExpander.Header>
                                        <TextBlock>
                                            <Run Text="Contr" />
                                            <Run FontFamily="Cascadia Mono,Consolas" Text="{x:Bind ViewModel.AppVersion}" />
                                        </TextBlock>
                                    </controls:SettingsExpander.Header>
                                    <controls:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Containers}" Style="{StaticResource IconStyle}" />
                                    </controls:SettingsExpander.HeaderIcon>
                                    <controls:SettingsExpander.ItemsHeader>
                                        <Grid Style="{StaticResource TableHeaderStyle}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="150" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="COMPONENT" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Style="{StaticResource CaptionLabelStyle}"
                                                Text="WHAT IT IS" />
                                            <TextBlock
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionLabelStyle}"
                                                Text="INSTALLED" />
                                            <TextBlock
                                                Grid.Column="3"
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CaptionLabelStyle}"
                                                Text="STATUS" />
                                        </Grid>
                                    </controls:SettingsExpander.ItemsHeader>
                                    <controls:SettingsExpander.ItemsFooter>
                                        <controls:SettingsCard
                                            Padding="52,14,16,14"
                                            Description="Copies every version above as text, for bug reports and support."
                                            Header="Version details">
                                            <Button AutomationProperties.AutomationId="CopyVersions" Click="OnCopyVersions">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="{x:Bind icons:ContrIcons.Copy}" Style="{StaticResource IconStyle}" />
                                                    <TextBlock Text="Copy" />
                                                </StackPanel>
                                            </Button>
                                        </controls:SettingsCard>
                                    </controls:SettingsExpander.ItemsFooter>
                                </controls:SettingsExpander>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  Pending proxy edits apply together, as the board's footer shows.  -->
        <Border
            Grid.Row="1"
            Padding="24,14"
            AutomationProperties.AutomationId="ProxyChangesBar"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Visibility="{x:Bind local:SettingsPage.WhenShown(ViewModel.TabIndex, 2, ViewModel.Proxies.HasChanges), Mode=OneWay}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.Proxies.ChangesText, Mode=OneWay}" />
                    <Run Text="{x:Bind ViewModel.Proxies.ApplyHint, Mode=OneWay}" />
                </TextBlock>
                <Button
                    Grid.Column="1"
                    AutomationProperties.AutomationId="DiscardProxyChanges"
                    Click="OnDiscardProxyChanges"
                    Content="Discard"
                    IsEnabled="{x:Bind ViewModel.Proxies.CanApply, Mode=OneWay}" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.AutomationId="ApplyProxyChanges"
                    Click="OnApplyProxyChanges"
                    Content="{x:Bind ViewModel.Proxies.ApplyText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.Proxies.CanApply, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
