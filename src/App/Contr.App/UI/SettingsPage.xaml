<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.App.UI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <common:PageHeader Title="Settings" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled">
            <StackPanel Padding="0,0,0,24" Spacing="4">
                <TextBlock
                    Margin="0,8,0,4"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Appearance" />
                <controls:SettingsCard
                    Description="Choose the colors that appear in the app."
                    Header="Theme"
                    HeaderIcon="{winui:FontIcon Glyph=&#xE790;}">
                    <ComboBox MinWidth="150" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="System default" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </controls:SettingsCard>
                <controls:SettingsCard
                    Description="Follow the Windows accent, or use Contr's own."
                    Header="Accent color"
                    HeaderIcon="{winui:FontIcon Glyph=&#xE771;}"
                    Visibility="{x:Bind ViewModel.HasAccentChoice}">
                    <ComboBox MinWidth="150" SelectedIndex="{x:Bind ViewModel.AccentIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Windows" />
                        <ComboBoxItem Content="Contr" />
                    </ComboBox>
                </controls:SettingsCard>

                <TextBlock
                    Margin="0,20,0,4"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Daemon" />
                <controls:SettingsCard
                    Description="{x:Bind ViewModel.DaemonDescription}"
                    Header="Contr daemon"
                    HeaderIcon="{winui:FontIcon Glyph=&#xE950;}">
                    <TextBlock
                        MaxWidth="420"
                        FontFamily="Cascadia Mono,Consolas"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.DaemonEndpoint}"
                        TextTrimming="CharacterEllipsis" />
                </controls:SettingsCard>

                <TextBlock
                    Margin="0,20,0,4"
                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                    Text="Diagnostics" />
                <controls:SettingsCard
                    Description="Errors are written to a log file on this machine. Nothing is sent anywhere."
                    Header="Log files"
                    HeaderIcon="{winui:FontIcon Glyph=&#xEBE8;}">
                    <Button
                        AutomationProperties.Name="Open the log folder"
                        Command="{x:Bind ViewModel.OpenLogFolderCommand}"
                        Content="Open log folder" />
                </controls:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
