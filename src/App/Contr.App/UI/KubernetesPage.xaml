<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.App.UI.KubernetesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsGroups.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="{StaticResource PageContentMaxWidth}" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="16">
                <common:PageHeader Title="Kubernetes" />

                <InfoBar
                    Title="Kubernetes is not available yet"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsNotOffered}"
                    Message="This version of the Contr daemon does not run a Kubernetes cluster. These settings wait for one that does."
                    Severity="Informational"
                    Visibility="{x:Bind ViewModel.IsNotOffered}" />

                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="CLUSTER" />
                        <controls:SettingsCard
                            BorderThickness="0"
                            Description="Runs a single-node cluster as a container on your engine."
                            Header="Kubernetes"
                            IsEnabled="False">
                            <ToggleSwitch AutomationProperties.Name="Run Kubernetes" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Description="Changing it recreates the cluster. Images stay."
                            Header="Version"
                            IsEnabled="False">
                            <ComboBox MinWidth="140" PlaceholderText="—" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Description="Whether kubectl uses this cluster unless told otherwise."
                            Header="Make contr the current kubectl context"
                            IsEnabled="False">
                            <ToggleSwitch AutomationProperties.Name="Make contr the current kubectl context" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Description="Routes Ingress resources to your services."
                            Header="Traefik ingress controller"
                            IsEnabled="False">
                            <ToggleSwitch AutomationProperties.Name="Traefik ingress controller" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Description="Where kubectl finds the cluster's address and credentials."
                            Header="Kubeconfig"
                            IsEnabled="False">
                            <Button Content="Open folder" />
                        </controls:SettingsCard>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsGroupStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SettingsGroupCaptionStyle}" Text="MAINTENANCE" />
                        <controls:SettingsCard
                            BorderThickness="0"
                            Description="Copies images from your engine into the cluster, so pods can use them without a registry."
                            Header="Use local images in the cluster"
                            IsEnabled="False">
                            <Button Content="Import images…" />
                        </controls:SettingsCard>
                        <controls:SettingsCard
                            Description="Deletes all workloads and cluster data. Your images stay."
                            Header="Reset cluster"
                            IsEnabled="False">
                            <Button Content="Reset…" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </controls:SettingsCard>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
