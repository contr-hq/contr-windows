<?xml version="1.0" encoding="utf-8" ?>
<!--
    Settings rows grouped in a captioned card: a page merges this dictionary, and every SettingsCard on it
    becomes a borderless row with a divider above it. The first row of a group sets BorderThickness="0"; an
    expander opens its group, its items under dividers.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!--  A disabled expander's header shows the toggle button's own background.  -->
            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ExpanderHeaderBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="ExpanderHeaderBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ExpanderContentBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="SettingsCardBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="SettingsCardBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="SettingsCardBorderBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushPointerOver" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushPressed" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushDisabled" ResourceKey="DividerStrokeColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <!--  A disabled expander's header shows the toggle button's own background.  -->
            <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ExpanderHeaderBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="ExpanderHeaderBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ExpanderContentBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ExpanderContentBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="SettingsCardBackground" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="SettingsCardBackgroundDisabled" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="SettingsCardBorderBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushPointerOver" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushPressed" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushDisabled" ResourceKey="DividerStrokeColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="SettingsCardBackground" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="SettingsCardBackgroundDisabled" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="SettingsCardBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushPressed" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="SettingsCardBorderBrushDisabled" ResourceKey="SystemColorGrayTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Thickness x:Key="SettingsCardBorderThickness">0,1,0,0</Thickness>
    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
    <Thickness x:Key="SettingsCardPadding">0,14,0,14</Thickness>
    <Thickness x:Key="SettingsCardHeaderIconMargin">0,0,16,0</Thickness>
    <Thickness x:Key="SettingsExpanderHeaderPadding">0,14,0,14</Thickness>
    <Thickness x:Key="SettingsExpanderItemPadding">52,10,16,10</Thickness>
    <Thickness x:Key="ClickableSettingsExpanderItemPadding">52,10,16,10</Thickness>

    <!--  The group: a captioned card whose rows bring their own vertical padding.  -->
    <Style
        x:Key="SettingsGroupStyle"
        BasedOn="{StaticResource CardStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="20,20,20,6" />
    </Style>

    <Style
        x:Key="SettingsGroupCaptionStyle"
        BasedOn="{StaticResource CaptionLabelStyle}"
        TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

</ResourceDictionary>
