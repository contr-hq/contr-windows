<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.Modules.Containers.UI.Views.ComposePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Contr.UI.Common.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Contr.Modules.Containers.UI.Views"
    xmlns:vm="using:Contr.Modules.Containers.UI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ComposeLogBackgroundBrush" Color="#0D1013" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ComposeLogBackgroundBrush" Color="#F5F7F9" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  The header and every row share these widths, so the columns line up.  -->
            <GridLength x:Key="ServiceColumnWidth">*</GridLength>
            <GridLength x:Key="ImageColumnWidth">1.4*</GridLength>
            <GridLength x:Key="StateColumnWidth">1.2*</GridLength>
            <GridLength x:Key="PortsColumnWidth">100</GridLength>
            <GridLength x:Key="ActionColumnWidth">32</GridLength>

            <Style x:Key="LogTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono,Consolas" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="LogListItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <!--  ListView draws the selection: the subtle fill and the accent marker the board shows.  -->
            <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">True</x:Boolean>
            <Style
                x:Key="ProjectItemStyle"
                BasedOn="{StaticResource DefaultListViewItemStyle}"
                TargetType="ListViewItem">
                <Setter Property="Padding" Value="16,10,12,10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <DataTemplate x:Key="ProjectTemplate" x:DataType="vm:ComposeProjectItem">
                <Grid
                    AutomationProperties.Name="{x:Bind Name}"
                    Background="Transparent"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Click="OnRemoveProject"
                                IsEnabled="{x:Bind IsAdded}"
                                Tag="{x:Bind}"
                                Text="Remove from Contr" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource CellTextStyle}"
                        Text="{x:Bind Name}" />
                    <common:PillView
                        Grid.Column="1"
                        Kind="{x:Bind PillKind}"
                        Text="{x:Bind StatusText}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind HasLocation}">
                        <Run
                            FontFamily="Cascadia Mono,Consolas"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind Location}" />
                        <Run
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind views:ComposePage.AddedText(IsAdded)}" />
                    </TextBlock>
                </Grid>
            </DataTemplate>

            <!--  The board shows the host port alone; the link opens it on localhost.  -->
            <DataTemplate x:Key="PortTemplate" x:DataType="vm:PortLink">
                <Grid>
                    <TextBlock Style="{StaticResource LogTextStyle}" Visibility="{x:Bind IsLink}">
                        <Hyperlink NavigateUri="{x:Bind Uri}" UnderlineStyle="None">
                            <Run Text="{x:Bind views:ComposePage.PortNumber(Address)}" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock
                        Style="{StaticResource LogTextStyle}"
                        Text="{x:Bind views:ComposePage.PortNumber(Address)}"
                        Visibility="{x:Bind IsText}" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ServiceTemplate" x:DataType="vm:ComposeServiceRow">
                <Grid AutomationProperties.Name="{x:Bind Name}" Style="{StaticResource CardTableRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ServiceColumnWidth}" MinWidth="110" />
                        <ColumnDefinition Width="{StaticResource ImageColumnWidth}" MinWidth="150" />
                        <ColumnDefinition Width="{StaticResource StateColumnWidth}" MinWidth="140" />
                        <ColumnDefinition Width="{StaticResource PortsColumnWidth}" />
                        <ColumnDefinition Width="{StaticResource ActionColumnWidth}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource CellTextStyle}"
                        Text="{x:Bind Name}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource IdentifierTextStyle}"
                        Text="{x:Bind Image}"
                        Visibility="{x:Bind IsPulled}" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource CellTextStyle}"
                        Text="{x:Bind BuildText}"
                        Visibility="{x:Bind IsBuilt}" />
                    <common:PillView
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        Kind="{x:Bind PillKind}"
                        Text="{x:Bind StatusText}" />
                    <ItemsRepeater
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        ItemTemplate="{StaticResource PortTemplate}"
                        ItemsSource="{x:Bind Ports}"
                        Visibility="{x:Bind HasPorts}" />
                    <TextBlock
                        Grid.Column="3"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CellTextStyle}"
                        Text="—"
                        Visibility="{x:Bind HasNoPorts}" />
                    <Button
                        Grid.Column="4"
                        AutomationProperties.Name="{x:Bind views:ComposePage.RestartName(Name)}"
                        Click="OnRestartService"
                        IsEnabled="{x:Bind CanRestart}"
                        Style="{StaticResource RowActionButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="{x:Bind views:ComposePage.RestartName(Name)}">
                        <FontIcon
                            FontSize="16"
                            Glyph="{x:Bind icons:ContrIcons.Restart}"
                            Style="{StaticResource IconStyle}" />
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="LogTemplate" x:DataType="vm:ComposeLogLine">
                <Grid Padding="14,1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="48" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Foreground="{x:Bind views:ComposePage.ServiceBrush(Color)}"
                        Style="{StaticResource LogTextStyle}"
                        Text="{x:Bind Service}" />
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource LogTextStyle}"
                        Text="|" />
                    <TextBlock
                        Grid.Column="2"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource LogTextStyle}"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="OutputTemplate" x:DataType="vm:ComposeOutputLine">
                <TextBlock
                    Padding="14,1"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource LogTextStyle}"
                    Text="{x:Bind Text}"
                    TextWrapping="Wrap" />
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="{StaticResource PageContentMaxWidth}" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <common:PageHeader Title="Compose">
                    <Button
                        AutomationProperties.AutomationId="AddComposeProjectButton"
                        AutomationProperties.Name="Add project"
                        Click="OnAddProject"
                        Visibility="{x:Bind views:ComposePage.ShowsBoth(ViewModel.Engine.IsOpen, ViewModel.IsOffered), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Add}" Style="{StaticResource IconStyle}" />
                            <TextBlock Text="Add project…" />
                        </StackPanel>
                    </Button>
                </common:PageHeader>

                <InfoBar
                    Title="Compose can't read this project's files"
                    Margin="0,16,0,0"
                    AutomationProperties.AutomationId="ComposeConfigError"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasConfigError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ConfigError, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind views:ComposePage.ShowsBoth(ViewModel.Engine.IsOpen, ViewModel.HasConfigError), Mode=OneWay}" />

                <!--  Counted over every project.  -->
                <common:PillRow
                    Margin="0,16,0,0"
                    Pills="{x:Bind ViewModel.SummaryPills, Mode=OneWay}"
                    Visibility="{x:Bind views:ComposePage.ShowsBoth(ViewModel.Engine.IsOpen, ViewModel.HasProjects), Mode=OneWay}" />

                <Grid
                    Margin="0,16,0,0"
                    ColumnSpacing="16"
                    Visibility="{x:Bind views:ComposePage.ShowsBoth(ViewModel.Engine.IsOpen, ViewModel.HasProjects), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border VerticalAlignment="Top" Style="{StaticResource CaptionedCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="PROJECTS" />
                            <ListView
                                x:Name="ProjectList"
                                Margin="-4,0"
                                AutomationProperties.AutomationId="ComposeProjects"
                                AutomationProperties.Name="Projects"
                                ItemContainerStyle="{StaticResource ProjectItemStyle}"
                                ItemTemplate="{StaticResource ProjectTemplate}"
                                ItemsSource="{x:Bind ViewModel.Projects}"
                                SelectionChanged="OnProjectSelectionChanged"
                                SelectionMode="Single" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Projects appear when you run docker compose up, or you can add one."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="16">
                        <Border Style="{StaticResource CaptionedCardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Contr doesn't know this project's Compose files, so Up and Pull are off. Add the project by its compose.yaml to use them."
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ViewModel.LacksConfigFiles, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            FontSize="12"
                                            Style="{StaticResource IdentifierTextStyle}"
                                            Text="{x:Bind ViewModel.ConfigFiles, Mode=OneWay}"
                                            Visibility="{x:Bind ViewModel.HasConfigFiles, Mode=OneWay}" />
                                        <HyperlinkButton
                                            Padding="2,0"
                                            AutomationProperties.AutomationId="ComposeOpenFolder"
                                            Click="OnOpenFolder"
                                            Content="Open folder"
                                            FontSize="12"
                                            Visibility="{x:Bind views:ComposePage.IsWindowsPath(ViewModel.WorkingDir), Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="ComposeUpButton"
                                        Click="OnUp"
                                        IsEnabled="{x:Bind ViewModel.CanUp, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="Creates and starts every service, pulling or building the images they lack">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Play}" Style="{StaticResource IconStyle}" />
                                            <TextBlock Text="Up" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        AutomationProperties.AutomationId="ComposePullButton"
                                        Click="OnPull"
                                        IsEnabled="{x:Bind ViewModel.CanUp, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Download}" Style="{StaticResource IconStyle}" />
                                            <TextBlock Text="Pull" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        AutomationProperties.AutomationId="ComposeRestartButton"
                                        Click="OnRestart"
                                        IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Restart}" Style="{StaticResource IconStyle}" />
                                            <TextBlock Text="Restart" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        AutomationProperties.AutomationId="ComposeStopButton"
                                        Click="OnStop"
                                        IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Stop}" Style="{StaticResource IconStyle}" />
                                            <TextBlock Text="Stop" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        AutomationProperties.AutomationId="ComposeDownButton"
                                        Click="OnDown"
                                        Content="Down…"
                                        IsEnabled="{x:Bind ViewModel.CanAct, Mode=OneWay}"
                                        Style="{StaticResource DestructiveButtonStyle}" />
                                </StackPanel>

                                <!--  The last command's output stays under the commands until another runs.  -->
                                <Grid
                                    Margin="-20,4,-20,-20"
                                    AutomationProperties.AutomationId="ComposeRun"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    Visibility="{x:Bind ViewModel.ShowsRun, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel
                                        Padding="20,10"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource CaptionLabelStyle}"
                                            Text="OUTPUT" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind ViewModel.Run.Title, Mode=OneWay}" />
                                        <common:PillView Kind="{x:Bind ViewModel.Run.PillKind, Mode=OneWay}" Text="{x:Bind ViewModel.Run.StatusText, Mode=OneWay}" />
                                    </StackPanel>
                                    <ListView
                                        x:Name="OutputList"
                                        Grid.Row="1"
                                        MaxHeight="220"
                                        Padding="0,8"
                                        Background="{ThemeResource ComposeLogBackgroundBrush}"
                                        CornerRadius="0,0,8,8"
                                        ItemContainerStyle="{StaticResource LogListItemStyle}"
                                        ItemTemplate="{StaticResource OutputTemplate}"
                                        ItemsSource="{x:Bind ViewModel.Output}"
                                        SelectionMode="None" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CaptionedCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="SERVICES" />
                                <StackPanel>
                                    <Grid Style="{StaticResource CardTableHeadStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource ServiceColumnWidth}" MinWidth="110" />
                                            <ColumnDefinition Width="{StaticResource ImageColumnWidth}" MinWidth="150" />
                                            <ColumnDefinition Width="{StaticResource StateColumnWidth}" MinWidth="140" />
                                            <ColumnDefinition Width="{StaticResource PortsColumnWidth}" />
                                            <ColumnDefinition Width="{StaticResource ActionColumnWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource ColumnHeadStyle}" Text="Service" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource ColumnHeadStyle}"
                                            Text="Image" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Style="{StaticResource ColumnHeadStyle}"
                                            Text="State" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Style="{StaticResource ColumnHeadStyle}"
                                            Text="Ports" />
                                    </Grid>
                                    <ItemsRepeater
                                        AutomationProperties.AutomationId="ComposeServices"
                                        ItemTemplate="{StaticResource ServiceTemplate}"
                                        ItemsSource="{x:Bind ViewModel.Services}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="400" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Padding="20,12"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionLabelStyle}"
                                        Text="LOGS" />
                                    <!--  Its tokens follow ViewModel.Filters in code; a SelectorBar takes no ItemsSource.  -->
                                    <SelectorBar
                                        x:Name="ServiceFilter"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Service"
                                        SelectionChanged="OnServiceFilterChanged"
                                        Style="{StaticResource TokenViewSelectorBarStyle}" />
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource ColumnHeadStyle}"
                                            Text="Follow" />
                                        <ToggleSwitch
                                            MinWidth="0"
                                            AutomationProperties.AutomationId="ComposeFollow"
                                            AutomationProperties.Name="Follow"
                                            IsOn="{x:Bind ViewModel.IsFollowing, Mode=TwoWay}"
                                            OffContent=""
                                            OnContent="" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="16,14"
                                    Canvas.ZIndex="1"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.LogsNote, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind views:ComposePage.WhenNone(ViewModel.Lines.Count), Mode=OneWay}" />
                                <ListView
                                    x:Name="LogList"
                                    Grid.Row="1"
                                    Padding="0,10"
                                    AutomationProperties.AutomationId="ComposeLogs"
                                    Background="{ThemeResource ComposeLogBackgroundBrush}"
                                    CornerRadius="0,0,8,8"
                                    ItemContainerStyle="{StaticResource LogListItemStyle}"
                                    ItemTemplate="{StaticResource LogTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Lines}"
                                    SelectionMode="None" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <common:EngineGate
                    Margin="0,16,0,0"
                    ViewModel="{x:Bind ViewModel.Engine}"
                    Visibility="{x:Bind ViewModel.Engine.IsClosed, Mode=OneWay}" />

                <common:EmptyState
                    Title="Compose isn't available"
                    Margin="0,16,0,0"
                    Glyph="{x:Bind icons:ContrIcons.Compose}"
                    Message="This version of the Contr service doesn't run Compose projects."
                    Visibility="{x:Bind views:ComposePage.ShowsBoth(ViewModel.Engine.IsOpen, ViewModel.LacksOffer), Mode=OneWay}" />

                <common:EmptyState
                    Title="No Compose projects yet"
                    Margin="0,16,0,0"
                    Glyph="{x:Bind icons:ContrIcons.Compose}"
                    Message="Run docker compose up in a project's folder, or add a project by its compose.yaml. Its services show up here."
                    Visibility="{x:Bind views:ComposePage.ShowsEmpty(ViewModel.Engine.IsOpen, ViewModel.IsLoaded, ViewModel.HasProjects), Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
