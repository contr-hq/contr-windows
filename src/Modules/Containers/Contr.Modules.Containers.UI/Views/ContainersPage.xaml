<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.Modules.Containers.UI.Views.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Contr.UI.Common.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Contr.Modules.Containers.UI.Views"
    xmlns:vm="using:Contr.Modules.Containers.UI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  The header and every row share these widths, so the columns line up across cards.  -->
        <GridLength x:Key="NameColumnWidth">2.4*</GridLength>
        <GridLength x:Key="StatusColumnWidth">1.2*</GridLength>
        <GridLength x:Key="PortsColumnWidth">1.1*</GridLength>
        <GridLength x:Key="CpuColumnWidth">72</GridLength>
        <GridLength x:Key="MemoryColumnWidth">108</GridLength>
        <GridLength x:Key="ActionsColumnWidth">120</GridLength>

        <Style x:Key="RowIconStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{StaticResource ContrIconsFontFamily}" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <!--  One wrapping text, so a long mapping continues on the next line; the line break between runs is a space.  -->
        <DataTemplate x:Key="PortTemplate" x:DataType="vm:PortLink">
            <Grid>
                <TextBlock
                    FontFamily="Cascadia Mono,Consolas"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind IsLink}">
                    <Hyperlink NavigateUri="{x:Bind Uri}" UnderlineStyle="None">
                        <Run Text="{x:Bind Address}" />
                    </Hyperlink>
                    <Run
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Target}" />
                </TextBlock>
                <TextBlock
                    FontFamily="Cascadia Mono,Consolas"
                    FontSize="13"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind IsText}">
                    <Run Text="{x:Bind Address}" />
                    <Run
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Target}" />
                </TextBlock>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RowTemplate" x:DataType="vm:ContainerRow">
            <Grid
                AutomationProperties.Name="{x:Bind Name}"
                Style="{StaticResource GroupRowStyle}"
                Tag="{x:Bind}"
                Tapped="OnRowTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource NameColumnWidth}" MinWidth="200" />
                    <ColumnDefinition Width="{StaticResource StatusColumnWidth}" MinWidth="150" />
                    <ColumnDefinition Width="{StaticResource PortsColumnWidth}" MinWidth="140" />
                    <ColumnDefinition Width="{StaticResource CpuColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource MemoryColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource ActionsColumnWidth}" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource CellTextStyle}"
                        Text="{x:Bind Name}" />
                    <TextBlock
                        FontSize="12"
                        Style="{StaticResource IdentifierTextStyle}"
                        Text="{x:Bind Image}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <common:PillView Kind="{x:Bind PillKind}" Text="{x:Bind StatusText}" />
                    <TextBlock Style="{StaticResource TimeTextStyle}" Text="{x:Bind Elapsed}" />
                </StackPanel>

                <ItemsControl
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    ItemTemplate="{StaticResource PortTemplate}"
                    ItemsSource="{x:Bind Ports}"
                    Visibility="{x:Bind HasPorts}" />
                <TextBlock
                    Grid.Column="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CellTextStyle}"
                    Text="—"
                    Visibility="{x:Bind HasNoPorts}" />

                <TextBlock
                    Grid.Column="3"
                    HorizontalAlignment="Right"
                    Style="{StaticResource CellTextStyle}"
                    Text="{x:Bind Usage.CpuText, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="4"
                    HorizontalAlignment="Right"
                    Style="{StaticResource CellTextStyle}"
                    Text="{x:Bind Usage.MemoryText, Mode=OneWay}" />

                <StackPanel
                    Grid.Column="5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="2">
                    <Button
                        AutomationProperties.Name="Start"
                        Click="OnStart"
                        Style="{StaticResource RowActionButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Start"
                        Visibility="{x:Bind CanStart}">
                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Play}" Style="{StaticResource RowIconStyle}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Stop"
                        Click="OnStop"
                        Style="{StaticResource RowActionButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Stop"
                        Visibility="{x:Bind CanStop}">
                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Stop}" Style="{StaticResource RowIconStyle}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Open terminal"
                        Click="OnTerminal"
                        Style="{StaticResource RowActionButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Open terminal"
                        Visibility="{x:Bind OffersTerminal}">
                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Terminal}" Style="{StaticResource RowIconStyle}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="View logs"
                        Click="OnLogs"
                        Style="{StaticResource RowActionButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="View logs"
                        Visibility="{x:Bind OffersLogs}">
                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Logs}" Style="{StaticResource RowIconStyle}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Delete"
                        Click="OnRemove"
                        Style="{StaticResource RowActionButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Delete"
                        Visibility="{x:Bind OffersDelete}">
                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Delete}" Style="{StaticResource RowIconStyle}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="More actions"
                        Style="{StaticResource RowActionButtonStyle}"
                        ToolTipService.ToolTip="More actions">
                        <FontIcon Glyph="{x:Bind icons:ContrIcons.More}" Style="{StaticResource RowIconStyle}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    Click="OnDetails"
                                    Tag="{x:Bind}"
                                    Text="Open details">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Open}" Style="{StaticResource RowIconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnLogs"
                                    Tag="{x:Bind}"
                                    Text="View logs">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Logs}" Style="{StaticResource RowIconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnTerminal"
                                    IsEnabled="{x:Bind OffersTerminal}"
                                    Tag="{x:Bind}"
                                    Text="Open terminal">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Terminal}" Style="{StaticResource RowIconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnRestart"
                                    IsEnabled="{x:Bind CanRestart}"
                                    Tag="{x:Bind}"
                                    Text="Restart">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Restart}" Style="{StaticResource RowIconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnPause"
                                    Tag="{x:Bind}"
                                    Text="Pause"
                                    Visibility="{x:Bind CanPause}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Pause}" Style="{StaticResource RowIconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnUnpause"
                                    Tag="{x:Bind}"
                                    Text="Resume"
                                    Visibility="{x:Bind CanUnpause}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Play}" Style="{StaticResource RowIconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnKill"
                                    IsEnabled="{x:Bind CanKill}"
                                    Tag="{x:Bind}"
                                    Text="Kill">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Power}" Style="{StaticResource RowIconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnRename"
                                    Tag="{x:Bind}"
                                    Text="Rename…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Rename}" Style="{StaticResource RowIconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnCopyId"
                                    Tag="{x:Bind}"
                                    Text="Copy ID">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Copy}" Style="{StaticResource RowIconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Click="OnRemove"
                                    IsEnabled="{x:Bind CanRemove}"
                                    Tag="{x:Bind}"
                                    Text="Delete…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Delete}" Style="{StaticResource RowIconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate" x:DataType="vm:ContainerGroup">
            <Border Style="{StaticResource GroupCardStyle}">
                <StackPanel>
                    <Grid
                        MinHeight="48"
                        Padding="12,8"
                        ColumnSpacing="12"
                        Visibility="{x:Bind HasHeader}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Width="20"
                            Height="20"
                            Padding="0"
                            AutomationProperties.Name="{x:Bind views:ContainersPage.ExpandName(IsExpanded), Mode=OneWay}"
                            Click="OnToggleGroup"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource SubtleButtonStyle}"
                            Tag="{x:Bind}">
                            <FontIcon
                                FontFamily="{StaticResource ContrIconsFontFamily}"
                                FontSize="12"
                                Glyph="{x:Bind views:ContainersPage.ChevronGlyph(IsExpanded), Mode=OneWay}" />
                        </Button>
                        <FontIcon
                            Grid.Column="1"
                            FontFamily="{StaticResource ContrIconsFontFamily}"
                            FontSize="20"
                            Glyph="{x:Bind Glyph}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{StaticResource CellTextStyle}"
                                Text="{x:Bind Title}" />
                            <TextBlock Style="{StaticResource SecondaryCellTextStyle}">
                                <Run Text="{x:Bind Summary, Mode=OneWay}" /><Run Text="{x:Bind views:ContainersPage.FileSeparator(ComposeFile), Mode=OneWay}" /><Run FontFamily="Cascadia Mono,Consolas" Text="{x:Bind ComposeFile, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind IsProject}">
                            <Button
                                AutomationProperties.Name="Start all"
                                Click="OnStartAll"
                                Style="{StaticResource RowActionButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Start all"
                                Visibility="{x:Bind CanStartAll, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind icons:ContrIcons.Play}" Style="{StaticResource RowIconStyle}" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Stop all"
                                Click="OnStopAll"
                                Style="{StaticResource RowActionButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Stop all"
                                Visibility="{x:Bind CanStopAll, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind icons:ContrIcons.Stop}" Style="{StaticResource RowIconStyle}" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Restart all"
                                Click="OnRestartAll"
                                Style="{StaticResource RowActionButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="Restart all"
                                Visibility="{x:Bind CanStopAll, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind icons:ContrIcons.Restart}" Style="{StaticResource RowIconStyle}" />
                            </Button>
                            <Button
                                AutomationProperties.Name="More actions for the project"
                                Style="{StaticResource RowActionButtonStyle}"
                                ToolTipService.ToolTip="More actions">
                                <FontIcon Glyph="{x:Bind icons:ContrIcons.More}" Style="{StaticResource RowIconStyle}" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Click="OnOpenCompose" Text="Open in Compose">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="{x:Bind icons:ContrIcons.Compose}" Style="{StaticResource RowIconStyle}" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsRepeater
                        ItemTemplate="{StaticResource RowTemplate}"
                        ItemsSource="{x:Bind Rows}"
                        Visibility="{x:Bind IsExpanded, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!--  Kakehashi's page frame: 24 px padding, 16 px between blocks; the grouped table is not paged.  -->
    <ScrollViewer>
        <Grid Padding="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="{StaticResource PageContentMaxWidth}" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <common:PageHeader Title="Containers">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind views:ContainersPage.ShowsBoth(ViewModel.Engine.IsOpen, ViewModel.HasRows), Mode=OneWay}">
                        <Button
                            AutomationProperties.AutomationId="RunContainerButton"
                            AutomationProperties.Name="Run container"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind icons:ContrIcons.Play}" Style="{StaticResource RowIconStyle}" />
                                <TextBlock Text="Run container" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.AutomationId="PruneStoppedButton"
                            AutomationProperties.Name="Prune stopped"
                            Click="OnPruneStopped"
                            IsEnabled="{x:Bind ViewModel.CanPrune, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind icons:ContrIcons.Delete}" Style="{StaticResource RowIconStyle}" />
                                <TextBlock Text="Prune stopped" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </common:PageHeader>

                <!--  The page's messages sit right under the breadcrumb, before any card.  -->
                <StackPanel>
                    <InfoBar
                        Title="Container stopped"
                        Margin="0,16,0,0"
                        AutomationProperties.AutomationId="ExitNotice"
                        IsOpen="{x:Bind ViewModel.IsExitNoticeOpen, Mode=TwoWay}"
                        Message="{x:Bind ViewModel.ExitNotice, Mode=OneWay}"
                        Severity="Error"
                        Visibility="{x:Bind ViewModel.IsExitNoticeOpen, Mode=OneWay}">
                        <InfoBar.Content>
                            <StackPanel
                                Margin="0,0,0,12"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button Click="OnViewExitedLogs" Content="View logs" />
                                <Button Click="OnRestartExited" Content="Restart" />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>
                    <InfoBar
                        Title="Couldn't list containers"
                        Margin="0,16,0,0"
                        IsClosable="False"
                        IsOpen="{x:Bind views:ContainersPage.ShowsError(ViewModel.HasError, ViewModel.Engine.IsOpen), Mode=OneWay}"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Error"
                        Visibility="{x:Bind views:ContainersPage.ErrorVisibility(ViewModel.HasError, ViewModel.Engine.IsOpen), Mode=OneWay}" />
                </StackPanel>

                <!--  Counted over every container, never the filtered set.  -->
                <common:PillRow
                    Margin="0,16,0,0"
                    AutomationProperties.AutomationId="ContainerSummary"
                    Pills="{x:Bind ViewModel.SummaryPills, Mode=OneWay}"
                    Visibility="{x:Bind views:ContainersPage.ShowsBoth(ViewModel.Engine.IsOpen, ViewModel.HasRows), Mode=OneWay}" />

                <Grid
                    Margin="0,16,0,0"
                    ColumnSpacing="16"
                    Visibility="{x:Bind views:ContainersPage.ShowsBoth(ViewModel.Engine.IsOpen, ViewModel.HasRows), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  The filter glyph leads the box, as in the design's text boxes.  -->
                    <Grid VerticalAlignment="Center">
                        <TextBox
                            Padding="34,5,10,6"
                            AutomationProperties.AutomationId="ContainersFilter"
                            AutomationProperties.Name="Filter containers"
                            PlaceholderText="Filter by name, image or port"
                            Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <FontIcon
                            Margin="11,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind icons:ContrIcons.Filter}"
                            IsHitTestVisible="False"
                            Style="{StaticResource RowIconStyle}" />
                    </Grid>
                    <Border Grid.Column="1" Style="{StaticResource SegmentGroupStyle}">
                        <StackPanel AutomationProperties.Name="Group by" Orientation="Horizontal">
                            <ToggleButton
                                Click="OnByProject"
                                Content="By project"
                                IsChecked="{x:Bind views:ContainersPage.IsView(ViewModel.ViewIndex, 0), Mode=OneWay}"
                                Style="{StaticResource SegmentToggleButtonStyle}" />
                            <Border Width="1" Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                            <ToggleButton
                                Click="OnFlatList"
                                Content="Flat list"
                                IsChecked="{x:Bind views:ContainersPage.IsView(ViewModel.ViewIndex, 1), Mode=OneWay}"
                                Style="{StaticResource SegmentToggleButtonStyle}" />
                        </StackPanel>
                    </Border>
                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <TextBlock VerticalAlignment="Center" Text="Show stopped" />
                        <ToggleSwitch
                            MinWidth="0"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="ShowStoppedToggle"
                            AutomationProperties.Name="Show stopped"
                            IsOn="{x:Bind ViewModel.ShowStopped, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <common:EngineGate ViewModel="{x:Bind ViewModel.Engine}" Visibility="{x:Bind ViewModel.Engine.IsClosed, Mode=OneWay}" />

                    <ProgressRing
                        Margin="0,48,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        IsActive="{x:Bind views:ContainersPage.IsWaiting(ViewModel.Engine.IsOpen, ViewModel.IsLoaded, ViewModel.HasError), Mode=OneWay}" />

                    <common:EmptyState
                        Title="No containers yet"
                        Glyph="{x:Bind icons:ContrIcons.Containers}"
                        IsAccent="False"
                        Message="Run one from an image here, or start a project with docker compose up in a terminal. It will show up here right away."
                        Visibility="{x:Bind views:ContainersPage.ShowsBoth(ViewModel.Engine.IsOpen, ViewModel.IsEmpty), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Run a container"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="OnPullImage" Content="Pull an image" />
                        </StackPanel>
                        <common:EmptyState.Footer>
                            <Border Style="{StaticResource CaptionedCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="TRY IT FROM A TERMINAL" />
                                    <Grid
                                        Padding="10,6,6,6"
                                        Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontFamily="Cascadia Mono,Consolas"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind views:ContainersPage.TryCommand}" />
                                        <Button
                                            HorizontalAlignment="Right"
                                            Click="OnCopyTryCommand"
                                            Content="Copy"
                                            Style="{StaticResource ToolbarButtonStyle}" />
                                    </Grid>
                                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="Then open " /><Run FontFamily="Cascadia Mono,Consolas" Text="localhost:8080" /><Run Text=" in your browser." />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </common:EmptyState.Footer>
                    </common:EmptyState>

                    <TextBlock
                        Margin="0,48,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Style="{StaticResource EmptyStateTextStyle}"
                        Text="No containers match the filter."
                        Visibility="{x:Bind views:ContainersPage.ShowsNoMatches(ViewModel.Engine.IsOpen, ViewModel.HasRows, ViewModel.HasMatches), Mode=OneWay}" />

                    <StackPanel Visibility="{x:Bind views:ContainersPage.ShowsBoth(ViewModel.Engine.IsOpen, ViewModel.HasMatches), Mode=OneWay}">
                        <Grid Padding="45,0,13,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource NameColumnWidth}" MinWidth="200" />
                                <ColumnDefinition Width="{StaticResource StatusColumnWidth}" MinWidth="150" />
                                <ColumnDefinition Width="{StaticResource PortsColumnWidth}" MinWidth="140" />
                                <ColumnDefinition Width="{StaticResource CpuColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource MemoryColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource ActionsColumnWidth}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ColumnHeadStyle}" Text="Name" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource ColumnHeadStyle}"
                                Text="Status" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource ColumnHeadStyle}"
                                Text="Ports" />
                            <TextBlock
                                Grid.Column="3"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ColumnHeadStyle}"
                                Text="CPU" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ColumnHeadStyle}"
                                Text="Memory" />
                            <TextBlock
                                Grid.Column="5"
                                HorizontalAlignment="Right"
                                Style="{StaticResource ColumnHeadStyle}"
                                Text="Actions" />
                        </Grid>

                        <ItemsRepeater
                            AutomationProperties.AutomationId="ContainersList"
                            ItemTemplate="{StaticResource GroupTemplate}"
                            ItemsSource="{x:Bind ViewModel.Groups}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
