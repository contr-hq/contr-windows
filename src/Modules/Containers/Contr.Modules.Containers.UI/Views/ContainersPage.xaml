<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.Modules.Containers.UI.Views.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Contr.Modules.Containers.UI.Views"
    xmlns:vm="using:Contr.Modules.Containers.UI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <common:PageHeader Title="Containers" />

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="{x:Bind views:ContainersPage.SeverityFor(ViewModel.IsEngineDown), Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

        <Border Grid.Row="2" Style="{StaticResource ListCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12" Style="{StaticResource ListHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="176" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Name" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Image" />
                    <TextBlock
                        Grid.Column="3"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Status" />
                    <TextBlock
                        Grid.Column="4"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Ports" />
                </Grid>

                <ListView
                    x:Name="ContainersList"
                    Grid.Row="1"
                    AutomationProperties.Name="Containers"
                    ItemContainerStyle="{StaticResource ListRowStyle}"
                    ItemsSource="{x:Bind ViewModel.Rows}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContainerRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>

                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{x:Bind views:ContainersPage.StateBrush(State)}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource CellTextStyle}"
                                        Text="{x:Bind Name}" />
                                    <TextBlock Style="{StaticResource MonoCellTextStyle}" Text="{x:Bind views:ContainersPage.Subtitle(Project, ShortId)}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource CellTextStyle}"
                                    Text="{x:Bind Image}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="{x:Bind Status}" />
                                <TextBlock
                                    Grid.Column="4"
                                    Style="{StaticResource MonoCellTextStyle}"
                                    Text="{x:Bind Ports}" />

                                <StackPanel
                                    Grid.Column="5"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        AutomationProperties.HelpText="{x:Bind Name}"
                                        AutomationProperties.Name="Start"
                                        Click="OnStart"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Start"
                                        Visibility="{x:Bind CanStart}">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                    </Button>
                                    <Button
                                        AutomationProperties.HelpText="{x:Bind Name}"
                                        AutomationProperties.Name="Stop"
                                        Click="OnStop"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Stop"
                                        Visibility="{x:Bind CanStop}">
                                        <FontIcon FontSize="14" Glyph="&#xE71A;" />
                                    </Button>
                                    <Button
                                        AutomationProperties.HelpText="{x:Bind Name}"
                                        AutomationProperties.Name="Restart"
                                        Click="OnRestart"
                                        IsEnabled="{x:Bind CanRestart}"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Restart">
                                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                                    </Button>
                                    <Button
                                        AutomationProperties.HelpText="{x:Bind Name}"
                                        AutomationProperties.Name="Logs"
                                        Click="OnLogs"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Logs">
                                        <FontIcon FontSize="14" Glyph="&#xE8A5;" />
                                    </Button>
                                    <Button
                                        AutomationProperties.HelpText="{x:Bind Name}"
                                        AutomationProperties.Name="Delete"
                                        Click="OnRemove"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        IsEnabled="{x:Bind CanRemove}"
                                        Style="{StaticResource RowActionButtonStyle}"
                                        Tag="{x:Bind}"
                                        ToolTipService.ToolTip="Delete">
                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Row="1"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE7B8;" />
                    <TextBlock Style="{StaticResource EmptyStateTextStyle}" Text="No containers yet. Containers you create with docker run or docker compose appear here." />
                </StackPanel>

                <ProgressRing
                    Grid.Row="1"
                    IsActive="{x:Bind views:ContainersPage.IsWaiting(ViewModel.IsLoaded, ViewModel.HasError), Mode=OneWay}" />
            </Grid>
        </Border>

        <Border
            Grid.Row="3"
            Height="280"
            Style="{StaticResource ListCardStyle}"
            Visibility="{x:Bind ViewModel.IsLogsOpen, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Style="{StaticResource ListHeaderStyle}">
                    <TextBlock Style="{StaticResource ColumnHeaderTextStyle}">
                        <Run Text="Logs" />
                        <Run Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="·" />
                        <Run Text="{x:Bind ViewModel.LogsTitle, Mode=OneWay}" />
                    </TextBlock>
                    <Button
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Close logs"
                        Click="OnCloseLogs"
                        Style="{StaticResource RowActionButtonStyle}"
                        ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <InfoBar
                    Grid.Row="1"
                    Margin="12,8,12,0"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasLogsError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.LogsError, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.HasLogsError, Mode=OneWay}" />

                <ScrollViewer
                    x:Name="LogsScroller"
                    Grid.Row="2"
                    Padding="16,8"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto">
                    <TextBlock
                        AutomationProperties.Name="Log output"
                        FontFamily="Cascadia Mono,Consolas"
                        FontSize="12"
                        IsTextSelectionEnabled="True"
                        SizeChanged="OnLogsSizeChanged"
                        Text="{x:Bind ViewModel.LogsText, Mode=OneWay}" />
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
