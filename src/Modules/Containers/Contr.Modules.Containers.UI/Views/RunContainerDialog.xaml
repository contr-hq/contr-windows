<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Contr.Modules.Containers.UI.Views.RunContainerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Contr.UI.Common.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Contr.Modules.Containers.UI.Views"
    xmlns:vm="using:Contr.Modules.Containers.UI.ViewModels"
    Title="Run a container"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanRun, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="Run"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <!--  The board's dialog is 600 px wide; WinUI's default stops at 548.  -->
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>

        <FontFamily x:Key="CodeFontFamily">Cascadia Mono,Consolas</FontFamily>

        <Style x:Key="CodeBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <DataTemplate x:Key="PortTemplate" x:DataType="vm:PortEntry">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    AutomationProperties.Name="Port on this PC"
                    PlaceholderText="8080"
                    Style="{StaticResource CodeBoxStyle}"
                    Text="{x:Bind Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="→" />
                <TextBox
                    Grid.Column="2"
                    AutomationProperties.Name="Container port"
                    PlaceholderText="80/tcp"
                    Style="{StaticResource CodeBoxStyle}"
                    Text="{x:Bind Container, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Remove port"
                    Click="OnRemovePort"
                    Style="{StaticResource RowActionButtonStyle}"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="Remove port">
                    <FontIcon Glyph="{x:Bind icons:ContrIcons.Dismiss}" Style="{StaticResource IconStyle}" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MountTemplate" x:DataType="vm:MountEntry">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        AutomationProperties.Name="Folder on this PC or volume"
                        PlaceholderText="C:\src\site or a volume"
                        Style="{StaticResource CodeBoxStyle}"
                        Text="{x:Bind Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Click="OnBrowse"
                        Content="Browse…"
                        Tag="{x:Bind}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="→" />
                    <TextBox
                        Grid.Column="3"
                        AutomationProperties.Name="Path in container"
                        PlaceholderText="/usr/share/nginx/html"
                        Style="{StaticResource CodeBoxStyle}"
                        Text="{x:Bind Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="4"
                        AutomationProperties.Name="Remove folder or volume"
                        Click="OnRemoveMount"
                        Style="{StaticResource RowActionButtonStyle}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Remove">
                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Dismiss}" Style="{StaticResource IconStyle}" />
                    </Button>
                </Grid>
                <CheckBox Content="Read only" IsChecked="{x:Bind ReadOnly, Mode=TwoWay}" />
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>

    <!--  The dialog's one error bar opens at the top of its body, and the dialog stays open.  -->
    <StackPanel Width="552" Spacing="16">
        <InfoBar
            Title="Couldn't run the container."
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

        <TextBox
            AutomationProperties.AutomationId="RunImage"
            PlaceholderText="nginx:1.27-alpine"
            Style="{StaticResource CodeBoxStyle}"
            Text="{x:Bind ViewModel.Image, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.Header>
                <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="Image" />
            </TextBox.Header>
        </TextBox>

        <TextBox
            AutomationProperties.AutomationId="RunName"
            PlaceholderText="Leave empty for a random name"
            Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.Header>
                <TextBlock>
                    <Run Text="Name" />
                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="(optional)" />
                </TextBlock>
            </TextBox.Header>
        </TextBox>

        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="PORTS" />
            <ItemsRepeater ItemTemplate="{StaticResource PortTemplate}" ItemsSource="{x:Bind ViewModel.Ports}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
            <Button Click="OnAddPort" Style="{StaticResource AddButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="{x:Bind icons:ContrIcons.Add}" Style="{StaticResource IconStyle}" />
                    <TextBlock Text="Add port" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="FOLDERS AND VOLUMES" />
            <ItemsRepeater ItemTemplate="{StaticResource MountTemplate}" ItemsSource="{x:Bind ViewModel.Mounts}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
            <Button Click="OnAddMount" Style="{StaticResource AddButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="{x:Bind icons:ContrIcons.Add}" Style="{StaticResource IconStyle}" />
                    <TextBlock Text="Add folder or volume" />
                </StackPanel>
            </Button>
            <Grid
                Padding="10,8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                ColumnSpacing="8"
                CornerRadius="4"
                Visibility="{x:Bind ViewModel.HasFolder, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Top"
                    FontSize="14"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="{x:Bind icons:ContrIcons.Info}"
                    Style="{StaticResource IconStyle}" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap">
                    <Run Text="Windows folders are slower than volumes for many small files, like" />
                    <Run FontFamily="{StaticResource CodeFontFamily}" Text="node_modules" /><Run Text="." />
                </TextBlock>
            </Grid>
        </StackPanel>

        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <TextBlock>
                    <Run Text="More options" />
                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="· environment, network, restart policy, command" />
                </TextBlock>
            </Expander.Header>
            <StackPanel Spacing="16">
                <TextBox
                    MinHeight="72"
                    AcceptsReturn="True"
                    PlaceholderText="VAR=value, one per line"
                    Style="{StaticResource CodeBoxStyle}"
                    Text="{x:Bind ViewModel.Environment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap">
                    <TextBox.Header>
                        <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="Environment" />
                    </TextBox.Header>
                </TextBox>
                <TextBox
                    PlaceholderText="The engine's default bridge"
                    Style="{StaticResource CodeBoxStyle}"
                    Text="{x:Bind ViewModel.Network, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Header>
                        <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="Network" />
                    </TextBox.Header>
                </TextBox>
                <ComboBox
                    HorizontalAlignment="Stretch"
                    Header="Restart policy"
                    SelectedIndex="{x:Bind ViewModel.RestartIndex, Mode=TwoWay}">
                    <x:String>No</x:String>
                    <x:String>Always</x:String>
                    <x:String>Unless stopped</x:String>
                    <x:String>On failure</x:String>
                </ComboBox>
                <TextBox
                    PlaceholderText="Leave empty for the image's command"
                    Style="{StaticResource CodeBoxStyle}"
                    Text="{x:Bind ViewModel.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Header>
                        <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="Command" />
                    </TextBox.Header>
                </TextBox>
            </StackPanel>
        </Expander>

        <CheckBox Content="Delete the container when it stops" IsChecked="{x:Bind ViewModel.AutoRemove, Mode=TwoWay}" />

        <StackPanel Spacing="6">
            <Grid>
                <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="SAME AS THIS COMMAND" />
                <Button
                    Padding="6,2"
                    HorizontalAlignment="Right"
                    Click="OnCopyCommand"
                    Content="Copy"
                    FontSize="12"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Style="{StaticResource SubtleButtonStyle}" />
            </Grid>
            <Border
                Padding="10,8"
                Background="{ThemeResource SolidBackgroundFillColorBaseAltBrush}"
                CornerRadius="4">
                <TextBlock
                    FontFamily="{StaticResource CodeFontFamily}"
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    LineHeight="18"
                    Text="{x:Bind ViewModel.Preview, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </StackPanel>
</ContentDialog>
