<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.Modules.Containers.UI.Views.ContainerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Contr.UI.Common.Icons"
    xmlns:helpers="using:Contr.UI.Common.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Contr.Modules.Containers.UI.Views"
    xmlns:vm="using:Contr.Modules.Containers.UI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#0C0C0C" />
                    <SolidColorBrush x:Key="LogMatchBrush" Color="#4D6B2A2A" />
                    <SolidColorBrush x:Key="JsonStringBrush" Color="#E6C07B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="LogMatchBrush" Color="#33C42B1C" />
                    <SolidColorBrush x:Key="JsonStringBrush" Color="#8A5300" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="LogFontFamily">Cascadia Mono,Consolas</FontFamily>

            <!--  A field row: identifiers in mono, plain values SemiBold, absent ones secondary.  -->
            <DataTemplate x:Key="FactTemplate" x:DataType="vm:InspectFact">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource FieldLabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource FieldLabelStyle}"
                        Text="{x:Bind Label}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource IdentifierTextStyle}"
                        Text="{x:Bind Value}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind views:ContainerDetailPage.WhenFact(Kind, 'Code')}" />
                    <TextBlock
                        Grid.Column="1"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind views:ContainerDetailPage.WhenFact(Kind, 'Text')}">
                        <Run FontWeight="SemiBold" Text="{x:Bind Value}" />
                        <Run
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind Note}" />
                    </TextBlock>
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Value}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind views:ContainerDetailPage.WhenFact(Kind, 'Muted')}" />
                </Grid>
            </DataTemplate>

            <!--  The same row in a side column, whose labels are short.  -->
            <DataTemplate x:Key="NarrowFactTemplate" x:DataType="vm:InspectFact">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Style="{StaticResource FieldLabelStyle}"
                        Text="{x:Bind Label}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource IdentifierTextStyle}"
                        Text="{x:Bind Value}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind views:ContainerDetailPage.WhenFact(Kind, 'Code')}" />
                    <TextBlock
                        Grid.Column="1"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind views:ContainerDetailPage.WhenFact(Kind, 'Text')}">
                        <Run FontWeight="SemiBold" Text="{x:Bind Value}" />
                        <Run
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind Note}" />
                    </TextBlock>
                    <TextBlock
                        Grid.Column="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Value}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind views:ContainerDetailPage.WhenFact(Kind, 'Muted')}" />
                </Grid>
            </DataTemplate>

            <StackLayout x:Key="FieldRowsLayout" Spacing="10" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="24,24,24,16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1440" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TerminalActions.(Grid.Row)" Value="0" />
                        <Setter Target="TerminalActions.(Grid.Column)" Value="5" />
                        <Setter Target="TerminalActions.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="TerminalActions.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MaxWidth="{StaticResource PageContentMaxWidth}" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="16">
            <common:PageHeader Trail="{x:Bind ViewModel.Trail, Mode=OneWay}" TrailClicked="OnTrailClicked">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        AutomationProperties.AutomationId="DetailStartButton"
                        Click="OnStart"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Play}" Style="{StaticResource IconStyle}" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.AutomationId="DetailStopButton"
                        Click="OnStop"
                        Visibility="{x:Bind ViewModel.CanStop, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Stop}" Style="{StaticResource IconStyle}" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.AutomationId="DetailRestartButton"
                        Click="OnRestart"
                        Visibility="{x:Bind ViewModel.CanStop, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Restart}" Style="{StaticResource IconStyle}" />
                            <TextBlock Text="Restart" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.AutomationId="DetailOpenPortButton"
                        Click="OnOpenPort"
                        Visibility="{x:Bind views:ContainerDetailPage.WhenPort(ViewModel.HasPort, ViewModel.IsRunning), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Open}" Style="{StaticResource IconStyle}" />
                            <TextBlock Text="{x:Bind views:ContainerDetailPage.OpenText(ViewModel.FirstPort), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <!--  A stopped container's delete is an action of its own; a running one keeps it in More.  -->
                    <Button
                        AutomationProperties.AutomationId="DetailDeleteButton"
                        Click="OnRemove"
                        IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind icons:ContrIcons.Delete}" Style="{StaticResource IconStyle}" />
                            <TextBlock Text="Delete…" />
                        </StackPanel>
                    </Button>
                    <Button
                        Width="40"
                        AutomationProperties.Name="More actions"
                        ToolTipService.ToolTip="More actions">
                        <FontIcon Glyph="{x:Bind icons:ContrIcons.More}" Style="{StaticResource IconStyle}" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem
                                    Click="OnPause"
                                    Visibility="{x:Bind ViewModel.CanPause, Mode=OneWay}"
                                    Text="Pause">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Pause}" Style="{StaticResource IconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnUnpause"
                                    Visibility="{x:Bind ViewModel.CanUnpause, Mode=OneWay}"
                                    Text="Resume">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Play}" Style="{StaticResource IconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnKill"
                                    IsEnabled="{x:Bind ViewModel.CanKill, Mode=OneWay}"
                                    Text="Kill">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Power}" Style="{StaticResource IconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="OnRename"
                                    IsEnabled="{x:Bind ViewModel.CanRename, Mode=OneWay}"
                                    Text="Rename…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Rename}" Style="{StaticResource IconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnCopyId" Text="Copy ID">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Copy}" Style="{StaticResource IconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem
                                    Click="OnRemove"
                                    IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}"
                                    Text="Delete…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="{x:Bind icons:ContrIcons.Delete}" Style="{StaticResource IconStyle}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </common:PageHeader>

            <!--  What used to be the status line, as pills: state, uptime, image, then the ID.  -->
            <StackPanel
                AutomationProperties.Name="Summary"
                Orientation="Horizontal"
                Spacing="8">
                <common:PillView Kind="{x:Bind ViewModel.PillKind, Mode=OneWay}" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                <TextBlock Style="{StaticResource TimeTextStyle}" Text="{x:Bind ViewModel.Elapsed, Mode=OneWay}" />
                <Border Padding="9,3" Style="{StaticResource PillStyle}">
                    <TextBlock
                        FontFamily="Cascadia Mono,Consolas"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Image, Mode=OneWay}" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock
                        FontSize="12"
                        Style="{StaticResource IdentifierTextStyle}"
                        Text="{x:Bind ViewModel.ShortId, Mode=OneWay}" />
                    <Button
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Copy ID"
                        Click="OnCopyId"
                        Style="{StaticResource RowActionButtonStyle}"
                        ToolTipService.ToolTip="Copy ID">
                        <FontIcon
                            FontFamily="{StaticResource ContrIconsFontFamily}"
                            FontSize="12"
                            Glyph="{x:Bind icons:ContrIcons.Copy}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Grid
            Grid.Row="2"
            Margin="0,16,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <SelectorBar x:Name="Tabs" SelectionChanged="OnTabSelectionChanged">
                <SelectorBarItem
                    x:Name="LogsTab"
                    AutomationProperties.AutomationId="LogsTab"
                    Text="Logs">
                    <SelectorBarItem.Icon>
                        <FontIcon FontFamily="{StaticResource ContrIconsFontFamily}" Glyph="{x:Bind icons:ContrIcons.Logs}" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem
                    x:Name="InspectTab"
                    AutomationProperties.AutomationId="InspectTab"
                    Text="Inspect">
                    <SelectorBarItem.Icon>
                        <FontIcon FontFamily="{StaticResource ContrIconsFontFamily}" Glyph="{x:Bind icons:ContrIcons.Inspect}" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem
                    x:Name="ExecTab"
                    AutomationProperties.AutomationId="ExecTab"
                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                    Text="Exec">
                    <SelectorBarItem.Icon>
                        <FontIcon FontFamily="{StaticResource ContrIconsFontFamily}" Glyph="{x:Bind icons:ContrIcons.Terminal}" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem
                    x:Name="StatsTab"
                    AutomationProperties.AutomationId="StatsTab"
                    Text="Stats">
                    <SelectorBarItem.Icon>
                        <FontIcon FontFamily="{StaticResource ContrIconsFontFamily}" Glyph="{x:Bind icons:ContrIcons.Stats}" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind views:ContainerDetailPage.When(ViewModel.Tab, 'Stats'), Mode=OneWay}">
                <TextBlock Style="{StaticResource ColumnHeadStyle}" Text="Show" />
                <ComboBox AutomationProperties.Name="Show" SelectedIndex="{x:Bind ViewModel.Stats.WindowIndex, Mode=TwoWay}">
                    <x:String>Last minute</x:String>
                    <x:String>Last 5 minutes</x:String>
                    <x:String>Last 15 minutes</x:String>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!--  The page's messages, under the breadcrumb and before the tabs; margins, so a closed bar leaves no gap.  -->
        <StackPanel Grid.Row="1">
            <InfoBar
                Title="This container no longer exists"
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsGone, Mode=OneWay}"
                Message="It was removed outside this page. Its logs and settings went with it."
                Severity="Warning"
                Visibility="{x:Bind ViewModel.IsGone, Mode=OneWay}" />
            <InfoBar
                Title="The engine refused"
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
            <InfoBar
                Title="Couldn't read the log"
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="{x:Bind views:ContainerDetailPage.Shows(ViewModel.Tab, 'Logs', ViewModel.Logs.HasError), Mode=OneWay}"
                Message="{x:Bind ViewModel.Logs.Error, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind views:ContainerDetailPage.WhenShown(ViewModel.Tab, 'Logs', ViewModel.Logs.HasError), Mode=OneWay}" />
            <InfoBar
                Title="Couldn't read the details"
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="{x:Bind views:ContainerDetailPage.Shows(ViewModel.Tab, 'Inspect', ViewModel.Inspect.HasError), Mode=OneWay}"
                Message="{x:Bind ViewModel.Inspect.Error, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind views:ContainerDetailPage.WhenShown(ViewModel.Tab, 'Inspect', ViewModel.Inspect.HasError), Mode=OneWay}" />
            <InfoBar
                Title="The shell stopped"
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="{x:Bind views:ContainerDetailPage.Shows(ViewModel.Tab, 'Exec', ViewModel.Terminal.HasError), Mode=OneWay}"
                Message="{x:Bind ViewModel.Terminal.Error, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind views:ContainerDetailPage.WhenShown(ViewModel.Tab, 'Exec', ViewModel.Terminal.HasError), Mode=OneWay}" />
            <InfoBar
                Title="Couldn't read usage"
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="{x:Bind views:ContainerDetailPage.Shows(ViewModel.Tab, 'Stats', ViewModel.Stats.HasError), Mode=OneWay}"
                Message="{x:Bind ViewModel.Stats.Error, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind views:ContainerDetailPage.WhenShown(ViewModel.Tab, 'Stats', ViewModel.Stats.HasError), Mode=OneWay}" />
        </StackPanel>

        <!--  Logs  -->
        <Border
            Grid.Row="3"
            Margin="0,16,0,0"
            Style="{StaticResource CardStyle}"
            Visibility="{x:Bind views:ContainerDetailPage.When(ViewModel.Tab, 'Logs'), Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="12,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Center">
                        <TextBox
                            x:Name="LogSearch"
                            Padding="34,5,64,6"
                            AutomationProperties.AutomationId="LogSearch"
                            AutomationProperties.Name="Search the log"
                            KeyDown="OnLogSearchKeyDown"
                            PlaceholderText="Search the log"
                            Text="{x:Bind ViewModel.Logs.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <FontIcon
                            Margin="11,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind icons:ContrIcons.Search}"
                            IsHitTestVisible="False"
                            Style="{StaticResource IconStyle}" />
                        <TextBlock
                            Margin="0,0,12,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsHitTestVisible="False"
                            Text="{x:Bind ViewModel.Logs.MatchText, Mode=OneWay}" />
                    </Grid>
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock Style="{StaticResource ColumnHeadStyle}" Text="Since" />
                        <ComboBox AutomationProperties.Name="Since" SelectedIndex="{x:Bind ViewModel.Logs.SinceIndex, Mode=TwoWay}">
                            <x:String>Last start</x:String>
                            <x:String>Last hour</x:String>
                            <x:String>Last 5,000 lines</x:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock Style="{StaticResource ColumnHeadStyle}" Text="Timestamps" />
                        <ToggleSwitch
                            MinWidth="0"
                            AutomationProperties.Name="Timestamps"
                            IsOn="{x:Bind ViewModel.Logs.ShowTimestamps, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </StackPanel>
                    <Button
                        Grid.Column="5"
                        Click="OnCopyLogs"
                        Content="Copy all"
                        Style="{StaticResource ToolbarButtonStyle}" />
                </Grid>

                <TextBlock
                    Grid.Row="2"
                    Margin="14,16"
                    Canvas.ZIndex="1"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No output yet. Lines appear here as the container writes them."
                    Visibility="{x:Bind views:ContainerDetailPage.WhenQuiet(ViewModel.Logs.Lines.Count, ViewModel.Logs.HasError), Mode=OneWay}" />
                <ListView
                    x:Name="LogList"
                    Grid.Row="2"
                    Padding="0,8"
                    AutomationProperties.AutomationId="LogLines"
                    Background="{ThemeResource LogBackgroundBrush}"
                    CornerRadius="0,0,8,8"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.Logs.Lines}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogLine">
                            <Grid Padding="14,1" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.ColumnSpan="2"
                                    Margin="-14,-1"
                                    Background="{ThemeResource LogMatchBrush}"
                                    Visibility="{x:Bind IsMatch, Mode=OneWay}" />
                                <TextBlock
                                    FontFamily="{StaticResource LogFontFamily}"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Time}"
                                    Visibility="{x:Bind HasTime}" />
                                <TextBlock
                                    Grid.Column="1"
                                    helpers:TextHighlight.Query="{x:Bind Highlight, Mode=OneWay}"
                                    FontFamily="{StaticResource LogFontFamily}"
                                    FontSize="13"
                                    Opacity="{x:Bind views:ContainerDetailPage.LineOpacity(IsNote)}"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Text, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--  Inspect  -->
        <Grid
            Grid.Row="3"
            Margin="0,16,0,0"
            ColumnSpacing="16"
            Visibility="{x:Bind views:ContainerDetailPage.When(ViewModel.Tab, 'Inspect'), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border VerticalAlignment="Top" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,8,8,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="RAW JSON" />
                        <TextBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Find a key"
                            PlaceholderText="Find a key"
                            Text="{x:Bind ViewModel.Inspect.FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="2"
                            Click="OnCollapseJson"
                            Content="Collapse all"
                            Style="{StaticResource ToolbarButtonStyle}" />
                        <Button
                            Grid.Column="3"
                            Click="OnCopyJson"
                            Content="Copy"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    </Grid>
                    <TreeView
                        Grid.Row="1"
                        Padding="4,8"
                        AutomationProperties.AutomationId="InspectJson"
                        Background="{ThemeResource LogBackgroundBrush}"
                        CanDragItems="False"
                        CanReorderItems="False"
                        ItemsSource="{x:Bind ViewModel.Inspect.Nodes}"
                        SelectionMode="None">
                        <!--  One 20px line per node, like the code it shows; the defaults give each node 32.  -->
                        <TreeView.Resources>
                            <x:Double x:Key="TreeViewItemMinHeight">20</x:Double>
                            <x:Double x:Key="TreeViewItemContentHeight">20</x:Double>
                            <Thickness x:Key="TreeViewItemPresenterMargin">0</Thickness>
                            <Thickness x:Key="TreeViewItemPresenterPadding">0</Thickness>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:JsonTreeNode">
                                <TreeViewItem
                                    MinHeight="20"
                                    Padding="0"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                    ItemsSource="{x:Bind Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="{StaticResource LogFontFamily}"
                                            FontSize="13"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind Key}"
                                            Visibility="{x:Bind HasKey}" />
                                        <TextBlock
                                            Margin="0,0,6,0"
                                            FontFamily="{StaticResource LogFontFamily}"
                                            FontSize="13"
                                            Text=":"
                                            Visibility="{x:Bind HasKey}" />
                                        <TextBlock
                                            MaxWidth="360"
                                            FontFamily="{StaticResource LogFontFamily}"
                                            FontSize="13"
                                            Foreground="{ThemeResource JsonStringBrush}"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind Value}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Value}"
                                            Visibility="{x:Bind views:ContainerDetailPage.WhenKind(Kind, 'String')}" />
                                        <TextBlock
                                            FontFamily="{StaticResource LogFontFamily}"
                                            FontSize="13"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind Value}"
                                            Visibility="{x:Bind views:ContainerDetailPage.WhenKind(Kind, 'Number')}" />
                                        <TextBlock
                                            FontFamily="{StaticResource LogFontFamily}"
                                            FontSize="13"
                                            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                            Text="{x:Bind Value}"
                                            Visibility="{x:Bind views:ContainerDetailPage.WhenKind(Kind, 'Literal')}" />
                                        <TextBlock
                                            FontFamily="{StaticResource LogFontFamily}"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind Value}"
                                            Visibility="{x:Bind views:ContainerDetailPage.WhenKind(Kind, 'Container')}" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock
                        Grid.Row="2"
                        Padding="12,8"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Paths are shown as the engine sees them, inside its Linux environment."
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource CaptionedCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="CONFIGURATION" />
                            <ItemsRepeater
                                ItemTemplate="{StaticResource FactTemplate}"
                                ItemsSource="{x:Bind ViewModel.Inspect.Configuration, Mode=OneWay}"
                                Layout="{StaticResource FieldRowsLayout}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CaptionedCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="STATE" />
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource FieldLabelWidth}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="Status" />
                                    <common:PillView
                                        Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        Kind="{x:Bind ViewModel.PillKind, Mode=OneWay}"
                                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                                </Grid>
                                <ItemsRepeater
                                    ItemTemplate="{StaticResource FactTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Inspect.State, Mode=OneWay}"
                                    Layout="{StaticResource FieldRowsLayout}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CaptionedCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="LIMITS" />
                            <ItemsRepeater
                                ItemTemplate="{StaticResource FactTemplate}"
                                ItemsSource="{x:Bind ViewModel.Inspect.Limits, Mode=OneWay}"
                                Layout="{StaticResource FieldRowsLayout}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  Exec  -->
        <Grid
            Grid.Row="3"
            Margin="0,16,0,0"
            ColumnSpacing="16"
            Visibility="{x:Bind views:ContainerDetailPage.When(ViewModel.Tab, 'Exec'), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        Padding="12,8,8,8"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        ColumnSpacing="8"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource ColumnHeadStyle}"
                            Text="Shell" />
                        <ComboBox
                            Grid.Column="1"
                            AutomationProperties.Name="Shell"
                            SelectedIndex="{x:Bind ViewModel.Terminal.ShellIndex, Mode=TwoWay}">
                            <x:String>/bin/sh</x:String>
                            <x:String>/bin/bash</x:String>
                            <x:String>/bin/ash</x:String>
                        </ComboBox>
                        <TextBlock
                            Grid.Column="2"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource ColumnHeadStyle}"
                            Text="User" />
                        <ComboBox
                            Grid.Column="3"
                            AutomationProperties.Name="User"
                            SelectedIndex="{x:Bind ViewModel.Terminal.UserIndex, Mode=TwoWay}">
                            <x:String>Image default</x:String>
                            <x:String>root</x:String>
                        </ComboBox>
                        <StackPanel
                            Grid.Column="4"
                            Margin="4,0,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <common:PillView Kind="{x:Bind views:ContainerDetailPage.TerminalPill(ViewModel.Terminal.IsConnected), Mode=OneWay}" Text="{x:Bind ViewModel.Terminal.StatusText, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource TimeTextStyle}" Text="{x:Bind ViewModel.Terminal.SizeText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            x:Name="TerminalActions"
                            Grid.Row="1"
                            Grid.ColumnSpan="6"
                            Margin="-4,0,0,0"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                Click="OnClearTerminal"
                                Content="Clear"
                                Style="{StaticResource ToolbarButtonStyle}" />
                            <Button
                                Width="32"
                                Padding="0"
                                AutomationProperties.Name="Copy selection"
                                Click="OnCopyTerminal"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTipService.ToolTip="Copy selection">
                                <FontIcon Glyph="{x:Bind icons:ContrIcons.Copy}" Style="{StaticResource IconStyle}" />
                            </Button>
                            <Button
                                AutomationProperties.AutomationId="TerminalConnectButton"
                                Click="OnConnectTerminal"
                                Content="Connect"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Visibility="{x:Bind ViewModel.Terminal.IsDisconnected, Mode=OneWay}" />
                            <Button
                                AutomationProperties.AutomationId="TerminalDisconnectButton"
                                Click="OnDisconnectTerminal"
                                Content="Disconnect"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Visibility="{x:Bind ViewModel.Terminal.IsConnected, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource LogBackgroundBrush}"
                        CornerRadius="0,0,8,8">
                        <views:TerminalView x:Name="TerminalHost" AutomationProperties.AutomationId="Terminal" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource CaptionedCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="USAGE" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CPU" />
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        LineHeight="28"
                                        Text="{x:Bind views:ContainerDetailPage.OrDash(ViewModel.Stats.CpuText), Mode=OneWay}" />
                                    <ProgressBar
                                        Margin="0,6,0,0"
                                        Maximum="100"
                                        Value="{x:Bind views:ContainerDetailPage.Latest(ViewModel.Stats.Cpu), Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Memory" />
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        LineHeight="28"
                                        Text="{x:Bind views:ContainerDetailPage.OrDash(ViewModel.Stats.MemoryText), Mode=OneWay}" />
                                    <ProgressBar
                                        Margin="0,6,0,0"
                                        Maximum="100"
                                        Value="{x:Bind ViewModel.Stats.MemoryShare, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CaptionedCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="NETWORK" />
                            <StackPanel Spacing="10">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Ports, Mode=OneWay}" Layout="{StaticResource FieldRowsLayout}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PortLink">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Port" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{StaticResource IdentifierTextStyle}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{x:Bind IsLink}">
                                                    <Hyperlink NavigateUri="{x:Bind Uri}" UnderlineStyle="None">
                                                        <Run Text="{x:Bind Address}" />
                                                    </Hyperlink>
                                                    <Run Text="{x:Bind Target}" />
                                                </TextBlock>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{StaticResource IdentifierTextStyle}"
                                                    TextWrapping="Wrap"
                                                    Visibility="{x:Bind IsText}">
                                                    <Run Text="{x:Bind Address}" />
                                                    <Run Text="{x:Bind Target}" />
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <Grid ColumnSpacing="16" Visibility="{x:Bind views:ContainerDetailPage.WhenNone(ViewModel.Ports), Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Port" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="None published" />
                                </Grid>
                                <ItemsRepeater
                                    ItemTemplate="{StaticResource NarrowFactTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Inspect.Networks, Mode=OneWay}"
                                    Layout="{StaticResource FieldRowsLayout}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CaptionedCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="MOUNTS" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="No mounts."
                                Visibility="{x:Bind views:ContainerDetailPage.WhenNoFacts(ViewModel.Inspect.Mounts), Mode=OneWay}" />
                            <ItemsRepeater
                                ItemTemplate="{StaticResource NarrowFactTemplate}"
                                ItemsSource="{x:Bind ViewModel.Inspect.Mounts, Mode=OneWay}"
                                Layout="{StaticResource FieldRowsLayout}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CaptionedCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="CONFIGURATION" />
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource FieldLabelStyle}"
                                        Text="Environment" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.Inspect.EnvironmentSummary, Mode=OneWay}" />
                                    <ToggleButton
                                        Grid.Column="2"
                                        AutomationProperties.Name="Show the variables"
                                        Content="{x:Bind views:ContainerDetailPage.ShowText(ViewModel.Inspect.IsEnvironmentShown), Mode=OneWay}"
                                        IsChecked="{x:Bind ViewModel.Inspect.IsEnvironmentShown, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource IdentifierTextStyle}"
                                    Text="{x:Bind ViewModel.Inspect.EnvironmentText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ViewModel.Inspect.HasEnvironmentText, Mode=OneWay}" />
                                <ItemsRepeater
                                    ItemTemplate="{StaticResource NarrowFactTemplate}"
                                    ItemsSource="{x:Bind ViewModel.Inspect.Setup, Mode=OneWay}"
                                    Layout="{StaticResource FieldRowsLayout}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  Stats  -->
        <Grid
            Grid.Row="3"
            Margin="0,16,0,0"
            Visibility="{x:Bind views:ContainerDetailPage.When(ViewModel.Tab, 'Stats'), Mode=OneWay}">
            <common:EmptyState
                Title="{x:Bind views:ContainerDetailPage.StatsWaitTitle(ViewModel.CanStop, ViewModel.Stats.HasError), Mode=OneWay}"
                Margin="0,0,0,48"
                Glyph="{x:Bind icons:ContrIcons.Stats}"
                Message="{x:Bind views:ContainerDetailPage.StatsWaitText(ViewModel.CanStop), Mode=OneWay}"
                Visibility="{x:Bind ViewModel.Stats.HasNoSamples, Mode=OneWay}" />
            <ScrollViewer Visibility="{x:Bind ViewModel.Stats.HasSamples, Mode=OneWay}">
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CaptionedCardStyle}">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="100" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="CPU" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                FontWeight="SemiBold"
                                LineHeight="28"
                                Text="{x:Bind ViewModel.Stats.CpuText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource SecondaryCellTextStyle}"
                                Text="{x:Bind ViewModel.Stats.CpuDetail, Mode=OneWay}" />
                            <common:Sparkline
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                Values="{x:Bind ViewModel.Stats.Cpu, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Style="{StaticResource CaptionedCardStyle}">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="100" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="MEMORY" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="20"
                                FontWeight="SemiBold"
                                LineHeight="28"
                                Text="{x:Bind ViewModel.Stats.MemoryText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource SecondaryCellTextStyle}"
                                Text="{x:Bind ViewModel.Stats.MemoryDetail, Mode=OneWay}" />
                            <common:Sparkline
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                IsFilled="True"
                                Values="{x:Bind ViewModel.Stats.Memory, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Style="{StaticResource CaptionedCardStyle}">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="100" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="NETWORK" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryCellTextStyle}"
                                Text="{x:Bind ViewModel.Stats.NetworkText, Mode=OneWay}" />
                            <StackPanel
                                Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="16">
                                <TextBlock Style="{StaticResource SecondaryCellTextStyle}" Text="— Received" />
                                <TextBlock Style="{StaticResource SecondaryCellTextStyle}" Text="- - Sent" />
                            </StackPanel>
                            <common:Sparkline
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                Maximum="{x:Bind views:ContainerDetailPage.Headroom(ViewModel.Stats.NetworkMaximum), Mode=OneWay}"
                                Values="{x:Bind ViewModel.Stats.Received, Mode=OneWay}" />
                            <common:Sparkline
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                IsDashed="True"
                                Maximum="{x:Bind views:ContainerDetailPage.Headroom(ViewModel.Stats.NetworkMaximum), Mode=OneWay}"
                                ShowsGrid="False"
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                Values="{x:Bind ViewModel.Stats.Sent, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource CaptionedCardStyle}">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="100" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CaptionLabelStyle}" Text="DISK" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryCellTextStyle}"
                                Text="{x:Bind ViewModel.Stats.DiskText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource SecondaryCellTextStyle}"
                                Text="{x:Bind ViewModel.Stats.DiskDetail, Mode=OneWay}" />
                            <common:Sparkline
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                Maximum="{x:Bind views:ContainerDetailPage.Headroom(ViewModel.Stats.DiskMaximum), Mode=OneWay}"
                                Values="{x:Bind ViewModel.Stats.Read, Mode=OneWay}" />
                            <common:Sparkline
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                IsDashed="True"
                                Maximum="{x:Bind views:ContainerDetailPage.Headroom(ViewModel.Stats.DiskMaximum), Mode=OneWay}"
                                ShowsGrid="False"
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                Values="{x:Bind ViewModel.Stats.Written, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
