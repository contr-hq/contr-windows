<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.Modules.Containers.UI.Views.ContainerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:Contr.UI.Common.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Contr.Modules.Containers.UI.Views"
    xmlns:vm="using:Contr.Modules.Containers.UI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#0C0C0C" />
                    <SolidColorBrush x:Key="LogMatchBrush" Color="#4D6B2A2A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#FBFBFB" />
                    <SolidColorBrush x:Key="LogMatchBrush" Color="#33C42B1C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="LogFontFamily">Cascadia Mono,Consolas</FontFamily>

            <DataTemplate x:Key="FactTemplate" x:DataType="vm:InspectFact">
                <Grid Padding="0,3" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Label}" />
                    <TextBlock
                        Grid.Column="1"
                        FontFamily="{x:Bind views:ContainerDetailPage.FactFont(IsCode)}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Value}"
                        TextWrapping="Wrap" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="36,24,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <common:PageHeader Trail="{x:Bind ViewModel.Trail, Mode=OneWay}" TrailClicked="OnTrailClicked">
            <common:PageHeader.Subtitle>
                <StackPanel
                    Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Spacing="16">
                    <common:StatusLabel
                        FontSize="14"
                        Kind="{x:Bind ViewModel.StatusKind, Mode=OneWay}"
                        Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Image, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MonoCellTextStyle}"
                            Text="{x:Bind ViewModel.ShortId, Mode=OneWay}" />
                        <Button
                            AutomationProperties.Name="Copy ID"
                            Click="OnCopyId"
                            Style="{StaticResource RowActionButtonStyle}"
                            ToolTipService.ToolTip="Copy ID">
                            <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </common:PageHeader.Subtitle>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    AutomationProperties.AutomationId="DetailStartButton"
                    Click="OnStart"
                    Style="{StaticResource AccentToolbarButtonStyle}"
                    Visibility="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.AutomationId="DetailStopButton"
                    Click="OnStop"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Visibility="{x:Bind ViewModel.CanStop, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE71A;" />
                        <TextBlock Text="Stop" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.AutomationId="DetailRestartButton"
                    Click="OnRestart"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Visibility="{x:Bind ViewModel.CanStop, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        <TextBlock Text="Restart" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.AutomationId="DetailOpenPortButton"
                    Click="OnOpenPort"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Visibility="{x:Bind views:ContainerDetailPage.WhenPort(ViewModel.HasPort, ViewModel.IsRunning), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                        <TextBlock Text="{x:Bind views:ContainerDetailPage.OpenText(ViewModel.FirstPort), Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource CommandBarDividerStyle}" />
                <Button
                    AutomationProperties.AutomationId="DetailDeleteButton"
                    Click="OnRemove"
                    IsEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}"
                    Style="{StaticResource DangerToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </common:PageHeader>

        <Grid
            Grid.Row="1"
            Margin="0,12,0,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <SelectorBar x:Name="Tabs" SelectionChanged="OnTabSelectionChanged">
                <SelectorBarItem
                    x:Name="LogsTab"
                    AutomationProperties.AutomationId="LogsTab"
                    Text="Logs">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem
                    x:Name="InspectTab"
                    AutomationProperties.AutomationId="InspectTab"
                    Text="Inspect">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem
                    x:Name="ExecTab"
                    AutomationProperties.AutomationId="ExecTab"
                    Text="Exec">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE756;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem
                    x:Name="StatsTab"
                    AutomationProperties.AutomationId="StatsTab"
                    Text="Stats">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind views:ContainerDetailPage.When(ViewModel.Tab, 'Stats'), Mode=OneWay}">
                <TextBlock VerticalAlignment="Center" Text="Show" />
                <ComboBox AutomationProperties.Name="Show" SelectedIndex="{x:Bind ViewModel.Stats.WindowIndex, Mode=TwoWay}">
                    <x:String>Last minute</x:String>
                    <x:String>Last 5 minutes</x:String>
                    <x:String>Last 15 minutes</x:String>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!--  Margins rather than row spacing, so a closed bar leaves no gap behind.  -->
        <StackPanel Grid.Row="2">
            <InfoBar
                Title="This container no longer exists"
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsGone, Mode=OneWay}"
                Message="It was removed outside this page. Its logs and settings went with it."
                Severity="Warning"
                Visibility="{x:Bind ViewModel.IsGone, Mode=OneWay}" />
            <InfoBar
                Title="The engine refused"
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />
        </StackPanel>

        <!--  Logs  -->
        <Border
            Grid.Row="3"
            Margin="0,16,0,0"
            Style="{StaticResource CardStyle}"
            Visibility="{x:Bind views:ContainerDetailPage.When(ViewModel.Tab, 'Logs'), Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="12,10" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="LogSearch"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="LogSearch"
                        AutomationProperties.Name="Search the log"
                        KeyDown="OnLogSearchKeyDown"
                        PlaceholderText="Search the log"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.Logs.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Logs.MatchText, Mode=OneWay}" />
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Since" />
                        <ComboBox AutomationProperties.Name="Since" SelectedIndex="{x:Bind ViewModel.Logs.SinceIndex, Mode=TwoWay}">
                            <x:String>Last start</x:String>
                            <x:String>Last hour</x:String>
                            <x:String>Last 5,000 lines</x:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="Timestamps" />
                        <ToggleSwitch
                            MinWidth="0"
                            AutomationProperties.Name="Timestamps"
                            IsOn="{x:Bind ViewModel.Logs.ShowTimestamps, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </StackPanel>
                    <Button
                        Grid.Column="5"
                        Click="OnCopyLogs"
                        Content="Copy all"
                        Style="{StaticResource ToolbarButtonStyle}" />
                </Grid>

                <InfoBar
                    Title="Couldn't read the log"
                    Grid.Row="1"
                    Margin="12,0,12,10"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.Logs.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Logs.Error, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.Logs.HasError, Mode=OneWay}" />

                <ListView
                    x:Name="LogList"
                    Grid.Row="2"
                    Padding="0,8"
                    AutomationProperties.AutomationId="LogLines"
                    Background="{ThemeResource LogBackgroundBrush}"
                    CornerRadius="0,0,8,8"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.Logs.Lines}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogLine">
                            <Grid Padding="14,1" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.ColumnSpan="2"
                                    Margin="-14,-1"
                                    Background="{ThemeResource LogMatchBrush}"
                                    Visibility="{x:Bind IsMatch, Mode=OneWay}" />
                                <TextBlock
                                    FontFamily="{StaticResource LogFontFamily}"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Time}"
                                    Visibility="{x:Bind HasTime}" />
                                <TextBlock
                                    Grid.Column="1"
                                    helpers:TextHighlight.Query="{x:Bind Highlight, Mode=OneWay}"
                                    FontFamily="{StaticResource LogFontFamily}"
                                    FontSize="13"
                                    Opacity="{x:Bind views:ContainerDetailPage.LineOpacity(IsNote)}"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Text, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--  Inspect  -->
        <Grid
            Grid.Row="3"
            Margin="0,16,0,0"
            ColumnSpacing="16"
            Visibility="{x:Bind views:ContainerDetailPage.When(ViewModel.Tab, 'Inspect'), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer>
                <StackPanel Spacing="10">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.Inspect.HasError, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Inspect.Error, Mode=OneWay}"
                        Severity="Error" />
                    <Border Padding="16" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Configuration" />
                            <ItemsControl ItemTemplate="{StaticResource FactTemplate}" ItemsSource="{x:Bind ViewModel.Inspect.Configuration, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="16" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="State" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Status" />
                                <common:StatusLabel
                                    Grid.Column="1"
                                    Kind="{x:Bind ViewModel.StatusKind, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}" />
                            </Grid>
                            <ItemsControl ItemTemplate="{StaticResource FactTemplate}" ItemsSource="{x:Bind ViewModel.Inspect.State, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="16" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Limits" />
                            <ItemsControl ItemTemplate="{StaticResource FactTemplate}" ItemsSource="{x:Bind ViewModel.Inspect.Limits, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CardHeadingStyle}"
                            Text="Raw JSON" />
                        <TextBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Find a key"
                            PlaceholderText="Find a key"
                            Text="{x:Bind ViewModel.Inspect.FindText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="2"
                            Click="OnCollapseJson"
                            Content="Collapse all"
                            Style="{StaticResource ToolbarButtonStyle}" />
                        <Button
                            Grid.Column="3"
                            Click="OnCopyJson"
                            Content="Copy"
                            Style="{StaticResource ToolbarButtonStyle}" />
                    </Grid>
                    <TreeView
                        Grid.Row="1"
                        Padding="4,8"
                        AutomationProperties.AutomationId="InspectJson"
                        Background="{ThemeResource LogBackgroundBrush}"
                        CanDragItems="False"
                        CanReorderItems="False"
                        ItemsSource="{x:Bind ViewModel.Inspect.Nodes}"
                        SelectionMode="None">
                        <!--  One 20px line per node, like the code it shows; the defaults give each node 32.  -->
                        <TreeView.Resources>
                            <x:Double x:Key="TreeViewItemMinHeight">20</x:Double>
                            <x:Double x:Key="TreeViewItemContentHeight">20</x:Double>
                            <Thickness x:Key="TreeViewItemPresenterMargin">0</Thickness>
                            <Thickness x:Key="TreeViewItemPresenterPadding">0</Thickness>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <DataTemplate x:DataType="vm:JsonTreeNode">
                                <TreeViewItem
                                    MinHeight="20"
                                    Padding="0"
                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                    ItemsSource="{x:Bind Children}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontFamily="{StaticResource LogFontFamily}"
                                            FontSize="13"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind Key}"
                                            Visibility="{x:Bind HasKey}" />
                                        <TextBlock
                                            Margin="0,0,6,0"
                                            FontFamily="{StaticResource LogFontFamily}"
                                            FontSize="13"
                                            Text=":"
                                            Visibility="{x:Bind HasKey}" />
                                        <TextBlock
                                            MaxWidth="360"
                                            FontFamily="{StaticResource LogFontFamily}"
                                            FontSize="13"
                                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                            IsTextSelectionEnabled="True"
                                            Text="{x:Bind Value}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Value}"
                                            Visibility="{x:Bind views:ContainerDetailPage.WhenKind(Kind, 'String')}" />
                                        <TextBlock
                                            FontFamily="{StaticResource LogFontFamily}"
                                            FontSize="13"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Text="{x:Bind Value}"
                                            Visibility="{x:Bind views:ContainerDetailPage.WhenKind(Kind, 'Number')}" />
                                        <TextBlock
                                            FontFamily="{StaticResource LogFontFamily}"
                                            FontSize="13"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind Value}"
                                            Visibility="{x:Bind views:ContainerDetailPage.WhenKind(Kind, 'Literal')}" />
                                        <TextBlock
                                            FontFamily="{StaticResource LogFontFamily}"
                                            FontSize="13"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="{x:Bind Value}"
                                            Visibility="{x:Bind views:ContainerDetailPage.WhenKind(Kind, 'Container')}" />
                                    </StackPanel>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <TextBlock
                        Grid.Row="2"
                        Padding="12,8"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Paths are shown as the engine sees them, inside its Linux environment."
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <!--  Exec  -->
        <Grid
            Grid.Row="3"
            Margin="0,16,0,0"
            ColumnSpacing="16"
            Visibility="{x:Bind views:ContainerDetailPage.When(ViewModel.Tab, 'Exec'), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="12,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="Shell" />
                        <ComboBox
                            Grid.Column="1"
                            AutomationProperties.Name="Shell"
                            SelectedIndex="{x:Bind ViewModel.Terminal.ShellIndex, Mode=TwoWay}">
                            <x:String>/bin/sh</x:String>
                            <x:String>/bin/bash</x:String>
                            <x:String>/bin/ash</x:String>
                        </ComboBox>
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="User" />
                        <ComboBox
                            Grid.Column="3"
                            AutomationProperties.Name="User"
                            SelectedIndex="{x:Bind ViewModel.Terminal.UserIndex, Mode=TwoWay}">
                            <x:String>Container's user</x:String>
                            <x:String>root</x:String>
                        </ComboBox>
                        <StackPanel
                            Grid.Column="4"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{x:Bind ViewModel.Terminal.IsConnected, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryCellTextStyle}"
                                Text="{x:Bind ViewModel.Terminal.StatusText, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="5"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                Click="OnClearTerminal"
                                Content="Clear"
                                Style="{StaticResource ToolbarButtonStyle}" />
                            <Button
                                AutomationProperties.Name="Copy selection"
                                Click="OnCopyTerminal"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTipService.ToolTip="Copy selection">
                                <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                            </Button>
                            <Button
                                AutomationProperties.AutomationId="TerminalConnectButton"
                                Click="OnConnectTerminal"
                                Content="Connect"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Visibility="{x:Bind ViewModel.Terminal.IsDisconnected, Mode=OneWay}" />
                            <Button
                                AutomationProperties.AutomationId="TerminalDisconnectButton"
                                Click="OnDisconnectTerminal"
                                Content="Disconnect"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Visibility="{x:Bind ViewModel.Terminal.IsConnected, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource LogBackgroundBrush}"
                        CornerRadius="0,0,8,8">
                        <views:TerminalView x:Name="TerminalHost" AutomationProperties.AutomationId="Terminal" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="10">
                    <Border Padding="16,12" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource SecondaryCellTextStyle}" Text="CPU" />
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind views:ContainerDetailPage.OrDash(ViewModel.Stats.CpuText), Mode=OneWay}" />
                                <ProgressBar Maximum="100" Value="{x:Bind views:ContainerDetailPage.Latest(ViewModel.Stats.Cpu), Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource SecondaryCellTextStyle}" Text="Memory" />
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind views:ContainerDetailPage.OrDash(ViewModel.Stats.MemoryText), Mode=OneWay}" />
                                <ProgressBar Maximum="100" Value="{x:Bind ViewModel.Stats.MemoryShare, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="16" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Ports" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Ports, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PortLink">
                                            <Grid>
                                                <HyperlinkButton
                                                    Padding="0"
                                                    Content="{x:Bind Address}"
                                                    NavigateUri="{x:Bind Uri}"
                                                    Visibility="{x:Bind IsLink}" />
                                                <TextBlock Text="{x:Bind Address}" Visibility="{x:Bind IsText}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryCellTextStyle}"
                                                    Text="{x:Bind Target}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="No published ports."
                                    Visibility="{x:Bind views:ContainerDetailPage.WhenNone(ViewModel.Ports), Mode=OneWay}" />
                            </StackPanel>
                            <MenuFlyoutSeparator />
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Mounts" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="No mounts."
                                    Visibility="{x:Bind views:ContainerDetailPage.WhenNoFacts(ViewModel.Inspect.Mounts), Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Inspect.Mounts, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InspectFact">
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Style="{StaticResource SecondaryCellTextStyle}" Text="{x:Bind Label}" />
                                                <TextBlock
                                                    FontFamily="{StaticResource LogFontFamily}"
                                                    FontSize="12"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind Value}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <MenuFlyoutSeparator />
                            <StackPanel Spacing="6">
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Network" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="Not attached to a network."
                                    Visibility="{x:Bind views:ContainerDetailPage.WhenNoFacts(ViewModel.Inspect.Networks), Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Inspect.Networks, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InspectFact">
                                            <Grid>
                                                <TextBlock Text="{x:Bind Label}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource MonoCellTextStyle}"
                                                    Text="{x:Bind Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <MenuFlyoutSeparator />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Environment" />
                                    <TextBlock Style="{StaticResource SecondaryCellTextStyle}" Text="{x:Bind ViewModel.Inspect.EnvironmentSummary, Mode=OneWay}" />
                                </StackPanel>
                                <ToggleButton
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Content="Show"
                                    IsChecked="{x:Bind ViewModel.Inspect.IsEnvironmentShown, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock
                                FontFamily="{StaticResource LogFontFamily}"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind ViewModel.Inspect.EnvironmentText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Inspect.HasCompose, Mode=OneWay}">
                                <MenuFlyoutSeparator />
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Compose" />
                                <TextBlock
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="{x:Bind ViewModel.Inspect.Compose, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  Stats  -->
        <Grid
            Grid.Row="3"
            Margin="0,16,0,0"
            Visibility="{x:Bind views:ContainerDetailPage.When(ViewModel.Tab, 'Stats'), Mode=OneWay}">
            <common:EmptyState
                Title="{x:Bind views:ContainerDetailPage.StatsWaitTitle(ViewModel.CanStop, ViewModel.Stats.Error), Mode=OneWay}"
                Margin="0,0,0,48"
                Glyph="&#xE9D9;"
                Message="{x:Bind views:ContainerDetailPage.StatsWaitText(ViewModel.CanStop, ViewModel.Stats.Error), Mode=OneWay}"
                Visibility="{x:Bind ViewModel.Stats.HasNoSamples, Mode=OneWay}" />
            <ScrollViewer Visibility="{x:Bind ViewModel.Stats.HasSamples, Mode=OneWay}">
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="16" Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="100" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="CPU" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Stats.CpuText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource SecondaryCellTextStyle}"
                                Text="{x:Bind ViewModel.Stats.CpuDetail, Mode=OneWay}" />
                            <common:Sparkline
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                Values="{x:Bind ViewModel.Stats.Cpu, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="16"
                        Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="100" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Memory" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Stats.MemoryText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource SecondaryCellTextStyle}"
                                Text="{x:Bind ViewModel.Stats.MemoryDetail, Mode=OneWay}" />
                            <common:Sparkline
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                IsFilled="True"
                                Values="{x:Bind ViewModel.Stats.Memory, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Padding="16"
                        Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="100" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Network" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryCellTextStyle}"
                                Text="{x:Bind ViewModel.Stats.NetworkText, Mode=OneWay}" />
                            <StackPanel
                                Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="16">
                                <TextBlock Style="{StaticResource SecondaryCellTextStyle}" Text="— Received" />
                                <TextBlock Style="{StaticResource SecondaryCellTextStyle}" Text="- - Sent" />
                            </StackPanel>
                            <common:Sparkline
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                Maximum="{x:Bind views:ContainerDetailPage.Headroom(ViewModel.Stats.NetworkMaximum), Mode=OneWay}"
                                Values="{x:Bind ViewModel.Stats.Received, Mode=OneWay}" />
                            <common:Sparkline
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                IsDashed="True"
                                Maximum="{x:Bind views:ContainerDetailPage.Headroom(ViewModel.Stats.NetworkMaximum), Mode=OneWay}"
                                ShowsGrid="False"
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                Values="{x:Bind ViewModel.Stats.Sent, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="16"
                        Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="100" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Disk" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource SecondaryCellTextStyle}"
                                Text="{x:Bind ViewModel.Stats.DiskText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource SecondaryCellTextStyle}"
                                Text="{x:Bind ViewModel.Stats.DiskDetail, Mode=OneWay}" />
                            <common:Sparkline
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                Maximum="{x:Bind views:ContainerDetailPage.Headroom(ViewModel.Stats.DiskMaximum), Mode=OneWay}"
                                Values="{x:Bind ViewModel.Stats.Read, Mode=OneWay}" />
                            <common:Sparkline
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                IsDashed="True"
                                Maximum="{x:Bind views:ContainerDetailPage.Headroom(ViewModel.Stats.DiskMaximum), Mode=OneWay}"
                                ShowsGrid="False"
                                Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                Values="{x:Bind ViewModel.Stats.Written, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
