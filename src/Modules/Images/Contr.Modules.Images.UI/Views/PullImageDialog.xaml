<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Contr.Modules.Images.UI.Views.PullImageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Pull an image"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="OnPrimaryButtonClick"
    PrimaryButtonText="Pull"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <!--  The dialog's one error bar opens at the top of its body, and the dialog stays open.  -->
    <StackPanel Width="440" Spacing="16">
        <InfoBar
            x:Name="PullError"
            IsClosable="False"
            Severity="Error"
            Visibility="Collapsed" />
        <TextBox
            x:Name="ImageNameBox"
            AutomationProperties.AutomationId="PullImageName"
            FontFamily="Cascadia Mono,Consolas"
            PlaceholderText="postgres, or registry.example.com/team/app"
            TextChanged="OnInputChanged">
            <TextBox.Header>
                <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="Image name" />
            </TextBox.Header>
        </TextBox>
        <TextBox
            x:Name="TagBox"
            AutomationProperties.AutomationId="PullImageTag"
            FontFamily="Cascadia Mono,Consolas"
            PlaceholderText="latest"
            TextChanged="OnInputChanged">
            <TextBox.Header>
                <TextBlock FontFamily="{ThemeResource ContentControlThemeFontFamily}" Text="Tag" />
            </TextBox.Header>
        </TextBox>
        <ComboBox
            x:Name="PlatformBox"
            HorizontalAlignment="Stretch"
            Header="Platform"
            SelectedIndex="0">
            <x:String>The engine's own platform</x:String>
            <x:String>linux/amd64</x:String>
            <x:String>linux/arm64</x:String>
        </ComboBox>
    </StackPanel>
</ContentDialog>
