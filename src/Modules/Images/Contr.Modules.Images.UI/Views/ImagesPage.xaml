<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.Modules.Images.UI.Views.ImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Contr.Modules.Images.UI.Views"
    xmlns:vm="using:Contr.Modules.Images.UI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <common:PageHeader Title="Images">
            <Button
                AutomationProperties.AutomationId="PullImage"
                Click="OnPull"
                Style="{StaticResource AccentToolbarButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE896;" />
                    <TextBlock Text="Pull image" />
                </StackPanel>
            </Button>
        </common:PageHeader>

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="{x:Bind views:ImagesPage.SeverityFor(ViewModel.IsEngineDown), Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

        <Border
            Grid.Row="2"
            Padding="16,12"
            Style="{StaticResource ListCardStyle}"
            Visibility="{x:Bind ViewModel.IsPulling, Mode=OneWay}">
            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.PullTitle, Mode=OneWay}" />
                <TextBlock
                    Grid.Row="1"
                    Style="{StaticResource SecondaryCellTextStyle}"
                    Text="{x:Bind ViewModel.PullStatus, Mode=OneWay}" />
                <ProgressBar
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="240"
                    VerticalAlignment="Center"
                    IsIndeterminate="{x:Bind ViewModel.IsPullIndeterminate, Mode=OneWay}"
                    Value="{x:Bind ViewModel.PullProgress, Mode=OneWay}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Click="OnCancelPull"
                    Content="Cancel" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ListCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12" Style="{StaticResource ListHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.4*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColumnHeaderTextStyle}" Text="Repository" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Tag" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Image ID" />
                    <TextBlock
                        Grid.Column="3"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Created" />
                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Right"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Size" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    AutomationProperties.Name="Images"
                    ItemContainerStyle="{StaticResource ListRowStyle}"
                    ItemsSource="{x:Bind ViewModel.Rows}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImageRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.4*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource CellTextStyle}"
                                        Text="{x:Bind Repository}" />
                                    <Border
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        CornerRadius="4"
                                        Visibility="{x:Bind InUse}">
                                        <TextBlock FontSize="11" Text="In use" />
                                    </Border>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <TextBlock Style="{StaticResource CellTextStyle}" Text="{x:Bind Tag}" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCellTextStyle}"
                                        Text="{x:Bind OtherTags}"
                                        Visibility="{x:Bind HasOtherTags}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource MonoCellTextStyle}"
                                    Text="{x:Bind ShortId}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="{x:Bind Created}" />
                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="{x:Bind Size}" />

                                <Button
                                    Grid.Column="5"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.HelpText="{x:Bind DisplayName}"
                                    AutomationProperties.Name="Delete"
                                    Click="OnRemove"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Delete">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Row="1"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE81E;" />
                    <TextBlock Style="{StaticResource EmptyStateTextStyle}" Text="No images yet. Pull one to get started." />
                </StackPanel>

                <ProgressRing
                    Grid.Row="1"
                    IsActive="{x:Bind views:ImagesPage.IsWaiting(ViewModel.IsLoaded, ViewModel.HasError), Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
