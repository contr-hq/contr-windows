<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.Modules.Volumes.UI.Views.VolumesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Contr.Modules.Volumes.UI.Views"
    xmlns:vm="using:Contr.Modules.Volumes.UI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <common:PageHeader Title="Volumes">
            <Button
                AutomationProperties.AutomationId="CreateVolume"
                Click="OnCreate"
                Style="{StaticResource AccentToolbarButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                    <TextBlock Text="Create volume" />
                </StackPanel>
            </Button>
        </common:PageHeader>

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="{x:Bind views:VolumesPage.SeverityFor(ViewModel.IsEngineDown), Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

        <Border Grid.Row="2" Style="{StaticResource ListCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12" Style="{StaticResource ListHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColumnHeaderTextStyle}" Text="Name" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Driver" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Mount point" />
                    <TextBlock
                        Grid.Column="3"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Created" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    AutomationProperties.Name="Volumes"
                    ItemContainerStyle="{StaticResource ListRowStyle}"
                    ItemsSource="{x:Bind ViewModel.Rows}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:VolumeRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource CellTextStyle}"
                                        Text="{x:Bind Name}" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCellTextStyle}"
                                        Text="{x:Bind Project}"
                                        Visibility="{x:Bind HasProject}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="{x:Bind Driver}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource MonoCellTextStyle}"
                                    Text="{x:Bind Mountpoint}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="{x:Bind Created}" />

                                <Button
                                    Grid.Column="4"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.HelpText="{x:Bind Name}"
                                    AutomationProperties.Name="Delete"
                                    Click="OnRemove"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Delete">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Row="1"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xEDA2;" />
                    <TextBlock Style="{StaticResource EmptyStateTextStyle}" Text="No volumes yet. Volumes keep data that outlives a container." />
                </StackPanel>

                <ProgressRing
                    Grid.Row="1"
                    IsActive="{x:Bind views:VolumesPage.IsWaiting(ViewModel.IsLoaded, ViewModel.HasError), Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
