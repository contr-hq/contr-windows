<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.Modules.Volumes.UI.Views.VolumesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Contr.Modules.Volumes.Application.Volumes"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Contr.Modules.Volumes.UI.Views"
    xmlns:vm="using:Contr.Modules.Volumes.UI.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <GridLength x:Key="UsedByColumnWidth">200</GridLength>
        <GridLength x:Key="CreatedColumnWidth">120</GridLength>

        <DataTemplate x:Key="VolumeTemplate" x:DataType="vm:VolumeItem">
            <Grid
                AutomationProperties.Name="{x:Bind Name}"
                Padding="16,6,12,6"
                Background="Transparent"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                ColumnSpacing="12"
                MinHeight="48"
                Tag="{x:Bind}"
                Tapped="OnRowTapped">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource UsedByColumnWidth}" />
                    <ColumnDefinition Width="{StaticResource CreatedColumnWidth}" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.ColumnSpan="3"
                    Margin="-16,-6,-12,-6"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    Visibility="{x:Bind IsSelected}" />
                <Border
                    Width="3"
                    Height="16"
                    Margin="-11,0,0,0"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="1.5"
                    Visibility="{x:Bind IsSelected}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource CellTextStyle}"
                        Text="{x:Bind Name}" />
                    <TextBlock
                        Style="{StaticResource SecondaryCellTextStyle}"
                        Text="{x:Bind Row.Subtitle}"
                        Visibility="{x:Bind views:VolumesPage.WhenText(Row.Subtitle)}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource CellTextStyle}"
                    Text="{x:Bind UsedBy}" />
                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource CellTextStyle}"
                    Text="{x:Bind Row.Created}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MountTemplate" x:DataType="app:VolumeMountDto">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CellTextStyle}" Text="{x:Bind Container}" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Style="{StaticResource MonoCellTextStyle}"
                    Text="{x:Bind Destination}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LabelTemplate" x:DataType="x:String">
            <TextBlock
                IsTextSelectionEnabled="True"
                Style="{StaticResource MonoCellTextStyle}"
                Text="{x:Bind}"
                TextWrapping="Wrap" />
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="36,24,36,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <common:PageHeader Title="Volumes">
            <StackPanel
                Orientation="Horizontal"
                Spacing="2"
                Visibility="{x:Bind ViewModel.Engine.IsOpen, Mode=OneWay}">
                <Button
                    AutomationProperties.AutomationId="CreateVolumeButton"
                    Click="OnCreate"
                    Style="{StaticResource AccentToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="Create volume" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource CommandBarDividerStyle}" />
                <Button
                    AutomationProperties.AutomationId="RemoveUnusedVolumesButton"
                    Click="OnRemoveUnused"
                    IsEnabled="{x:Bind ViewModel.HasUnused, Mode=OneWay}"
                    Style="{StaticResource ToolbarButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="Remove unused" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </common:PageHeader>

        <!--  Counted over every volume.  -->
        <common:StatStrip
            Grid.Row="1"
            Margin="0,16,0,0"
            AutomationProperties.AutomationId="VolumeStats"
            Cards="{x:Bind ViewModel.StatCards, Mode=OneWay}"
            Visibility="{x:Bind views:VolumesPage.Visible(ViewModel.Engine.IsOpen, ViewModel.HasRows), Mode=OneWay}" />

        <InfoBar
            Title="Couldn't list volumes"
            Grid.Row="2"
            Margin="0,16,0,0"
            IsClosable="False"
            IsOpen="{x:Bind views:VolumesPage.ShowsBoth(ViewModel.HasError, ViewModel.Engine.IsOpen), Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error"
            Visibility="{x:Bind views:VolumesPage.Visible(ViewModel.HasError, ViewModel.Engine.IsOpen), Mode=OneWay}" />

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <common:EngineGate
                Margin="0,0,0,48"
                ViewModel="{x:Bind ViewModel.Engine}"
                Visibility="{x:Bind ViewModel.Engine.IsClosed, Mode=OneWay}" />

            <ProgressRing
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind views:VolumesPage.IsWaiting(ViewModel.Engine.IsOpen, ViewModel.IsLoaded, ViewModel.HasError), Mode=OneWay}" />

            <common:EmptyState
                Title="No volumes yet"
                Margin="0,0,0,48"
                Glyph="&#xEDA2;"
                Message="Volumes keep data that outlives a container, such as a database's files. Containers and Compose projects create them, or create one here."
                Visibility="{x:Bind views:VolumesPage.Visible(ViewModel.Engine.IsOpen, ViewModel.IsEmpty), Mode=OneWay}">
                <Button
                    Click="OnCreate"
                    Content="Create volume"
                    Style="{StaticResource AccentButtonStyle}" />
            </common:EmptyState>

            <Grid ColumnSpacing="16" Visibility="{x:Bind views:VolumesPage.Visible(ViewModel.Engine.IsOpen, ViewModel.HasRows), Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border VerticalAlignment="Top" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,10,12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource UsedByColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource CreatedColumnWidth}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource ColumnHeadStyle}" Text="Name" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource ColumnHeadStyle}"
                                Text="Used by" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource ColumnHeadStyle}"
                                Text="Created" />
                        </Grid>
                        <ScrollViewer Grid.Row="1">
                            <ItemsRepeater
                                AutomationProperties.AutomationId="VolumesList"
                                ItemTemplate="{StaticResource VolumeTemplate}"
                                ItemsSource="{x:Bind ViewModel.Items}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="VolumeDetails"
                    Style="{StaticResource CardStyle}"
                    Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SecondaryCellTextStyle}" Text="{x:Bind ViewModel.Selected.Details, Mode=OneWay}" />
                        </StackPanel>
                        <MenuFlyoutSeparator />
                        <StackPanel Spacing="6">
                            <TextBlock FontWeight="SemiBold" Text="Mounted in" />
                            <ItemsControl ItemTemplate="{StaticResource MountTemplate}" ItemsSource="{x:Bind ViewModel.Selected.KnownMounts, Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource SecondaryCellTextStyle}"
                                Text="No container mounts it."
                                Visibility="{x:Bind views:VolumesPage.WhenTrue(ViewModel.Selected.IsUnused), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Spacing="6" Visibility="{x:Bind views:VolumesPage.WhenTrue(ViewModel.Selected.HasLabels), Mode=OneWay}">
                            <MenuFlyoutSeparator />
                            <TextBlock FontWeight="SemiBold" Text="Labels" />
                            <ItemsControl ItemTemplate="{StaticResource LabelTemplate}" ItemsSource="{x:Bind ViewModel.Selected.Row.Labels, Mode=OneWay}" />
                        </StackPanel>
                        <MenuFlyoutSeparator />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnCopyName" Content="Copy name" />
                            <Button
                                AutomationProperties.AutomationId="DeleteVolumeButton"
                                Click="OnDelete"
                                Content="Delete"
                                IsEnabled="{x:Bind views:VolumesPage.CanDelete(ViewModel.Selected.InUse, ViewModel.Selected.Mounts), Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource SecondaryTextStyle}"
                            FontSize="12"
                            Text="{x:Bind ViewModel.Selected.DeleteNote, Mode=OneWay}"
                            Visibility="{x:Bind views:VolumesPage.WhenTrue(ViewModel.Selected.InUse), Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
