<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Contr.Modules.Networks.UI.Views.NetworksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Contr.Modules.Networks.UI.Views"
    xmlns:vm="using:Contr.Modules.Networks.UI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <common:PageHeader Title="Networks" />

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="{x:Bind views:NetworksPage.SeverityFor(ViewModel.IsEngineDown), Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

        <Border Grid.Row="2" Style="{StaticResource ListCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12" Style="{StaticResource ListHeaderStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColumnHeaderTextStyle}" Text="Name" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Network ID" />
                    <TextBlock
                        Grid.Column="2"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Driver" />
                    <TextBlock
                        Grid.Column="3"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Scope" />
                    <TextBlock
                        Grid.Column="4"
                        Style="{StaticResource ColumnHeaderTextStyle}"
                        Text="Subnet" />
                </Grid>

                <ListView
                    Grid.Row="1"
                    AutomationProperties.Name="Networks"
                    ItemContainerStyle="{StaticResource ListRowStyle}"
                    ItemsSource="{x:Bind ViewModel.Rows}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NetworkRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="0.8*" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource CellTextStyle}"
                                        Text="{x:Bind Name}" />
                                    <TextBlock
                                        Style="{StaticResource SecondaryCellTextStyle}"
                                        Text="{x:Bind Project}"
                                        Visibility="{x:Bind HasProject}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource MonoCellTextStyle}"
                                    Text="{x:Bind ShortId}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="{x:Bind Driver}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource SecondaryCellTextStyle}"
                                    Text="{x:Bind Scope}" />
                                <TextBlock
                                    Grid.Column="4"
                                    Style="{StaticResource MonoCellTextStyle}"
                                    Text="{x:Bind Subnets}" />

                                <Button
                                    Grid.Column="5"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.HelpText="{x:Bind Name}"
                                    AutomationProperties.Name="Delete"
                                    Click="OnRemove"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    IsEnabled="{x:Bind CanRemove}"
                                    Style="{StaticResource RowActionButtonStyle}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind views:NetworksPage.RemoveToolTip(CanRemove)}">
                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing
                    Grid.Row="1"
                    IsActive="{x:Bind views:NetworksPage.IsWaiting(ViewModel.IsLoaded, ViewModel.HasError), Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</Page>
