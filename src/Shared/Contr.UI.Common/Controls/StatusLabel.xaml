<UserControl
    x:Class="Contr.UI.Common.Controls.StatusLabel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Contr.UI.Common.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal" Spacing="7">
        <Grid
            Width="14"
            Height="14"
            VerticalAlignment="Center">
            <FontIcon
                FontFamily="{StaticResource ContrIconsFontFamily}"
                FontSize="14"
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Glyph="{x:Bind icons:ContrIcons.Success}"
                Visibility="{x:Bind controls:StatusLabel.When(Kind, 'Good'), Mode=OneWay}" />
            <FontIcon
                FontFamily="{StaticResource ContrIconsFontFamily}"
                FontSize="14"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Glyph="{x:Bind icons:ContrIcons.Warning}"
                Visibility="{x:Bind controls:StatusLabel.When(Kind, 'Caution'), Mode=OneWay}" />
            <FontIcon
                FontFamily="{StaticResource ContrIconsFontFamily}"
                FontSize="14"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Glyph="{x:Bind icons:ContrIcons.Error}"
                Visibility="{x:Bind controls:StatusLabel.When(Kind, 'Critical'), Mode=OneWay}" />
            <FontIcon
                FontFamily="{StaticResource ContrIconsFontFamily}"
                FontSize="14"
                Foreground="{ThemeResource SystemFillColorNeutralBrush}"
                Glyph="{x:Bind icons:ContrIcons.Pending}"
                Visibility="{x:Bind controls:StatusLabel.When(Kind, 'Neutral'), Mode=OneWay}" />
            <FontIcon
                FontFamily="{StaticResource ContrIconsFontFamily}"
                FontSize="14"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Glyph="{x:Bind icons:ContrIcons.Pause}"
                Visibility="{x:Bind controls:StatusLabel.When(Kind, 'Paused'), Mode=OneWay}" />
            <ProgressRing
                Width="12"
                Height="12"
                MinWidth="12"
                MinHeight="12"
                IsActive="{x:Bind controls:StatusLabel.IsBusy(Kind), Mode=OneWay}" />
        </Grid>
        <TextBlock VerticalAlignment="Center" Text="{x:Bind Text, Mode=OneWay}" />
        <TextBlock
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind Detail, Mode=OneWay}" />
    </StackPanel>
</UserControl>
