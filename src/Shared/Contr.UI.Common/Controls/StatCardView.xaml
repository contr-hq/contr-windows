<UserControl
    x:Class="Contr.UI.Common.Controls.StatCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="14,12"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  One square per kind, so each takes its fill from the theme the page is in.  -->
            <Grid
                Width="36"
                Height="36"
                VerticalAlignment="Center">
                <Border
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="8"
                    Visibility="{x:Bind controls:StatCardView.When(Card, 'Accent'), Mode=OneWay}" />
                <Border
                    Background="{ThemeResource SystemFillColorSuccessBrush}"
                    CornerRadius="8"
                    Visibility="{x:Bind controls:StatCardView.When(Card, 'Positive'), Mode=OneWay}" />
                <Border
                    Background="{ThemeResource SystemFillColorNeutralBrush}"
                    CornerRadius="8"
                    Visibility="{x:Bind controls:StatCardView.When(Card, 'Muted'), Mode=OneWay}" />
                <Border
                    Background="{ThemeResource SystemFillColorCautionBrush}"
                    CornerRadius="8"
                    Visibility="{x:Bind controls:StatCardView.When(Card, 'Warning'), Mode=OneWay}" />
                <Border
                    Background="{ThemeResource SystemFillColorCriticalBrush}"
                    CornerRadius="8"
                    Visibility="{x:Bind controls:StatCardView.When(Card, 'Critical'), Mode=OneWay}" />
                <FontIcon
                    FontSize="16"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Glyph="{x:Bind controls:StatCardView.GlyphOf(Card), Mode=OneWay}" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    CharacterSpacing="40"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind controls:StatCardView.LabelOf(Card), Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{x:Bind controls:StatCardView.ValueOf(Card), Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind controls:StatCardView.DetailOf(Card), Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind controls:StatCardView.HasDetail(Card), Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
