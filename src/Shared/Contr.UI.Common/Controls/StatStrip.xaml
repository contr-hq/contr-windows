<UserControl
    x:Class="Contr.UI.Common.Controls.StatStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--  UniformGridLayout with ItemsStretch=Fill gives equal columns across the page's width.  -->
    <ItemsRepeater ItemsSource="{x:Bind Cards, Mode=OneWay}">
        <ItemsRepeater.ItemTemplate>
            <DataTemplate x:DataType="controls:StatCard">
                <controls:StatCardView Card="{x:Bind}" />
            </DataTemplate>
        </ItemsRepeater.ItemTemplate>
        <ItemsRepeater.Layout>
            <UniformGridLayout
                ItemsStretch="Fill"
                MaximumRowsOrColumns="4"
                MinColumnSpacing="12"
                MinRowSpacing="12"
                Orientation="Horizontal" />
        </ItemsRepeater.Layout>
    </ItemsRepeater>
</UserControl>
