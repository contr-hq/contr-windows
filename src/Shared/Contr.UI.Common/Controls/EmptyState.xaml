<UserControl
    x:Class="Contr.UI.Common.Controls.EmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel
        MaxWidth="560"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12">
        <Border
            Width="72"
            Height="72"
            Margin="0,0,0,8"
            HorizontalAlignment="Center"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            CornerRadius="36">
            <Grid>
                <FontIcon
                    FontSize="30"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="{x:Bind Glyph, Mode=OneWay}"
                    Visibility="{x:Bind IsAccent, Mode=OneWay}" />
                <FontIcon
                    FontSize="30"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Glyph="{x:Bind Glyph, Mode=OneWay}"
                    Visibility="{x:Bind controls:EmptyState.Not(IsAccent), Mode=OneWay}" />
            </Grid>
        </Border>
        <TextBlock
            HorizontalAlignment="Center"
            Style="{StaticResource SubtitleTextBlockStyle}"
            Text="{x:Bind Title, Mode=OneWay}"
            TextAlignment="Center" />
        <TextBlock
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind Message, Mode=OneWay}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <ContentPresenter
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Content="{x:Bind Actions, Mode=OneWay}" />
        <ContentPresenter HorizontalAlignment="Stretch" Content="{x:Bind Footer, Mode=OneWay}" />
    </StackPanel>
</UserControl>
