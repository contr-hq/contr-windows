<UserControl
    x:Class="Contr.UI.Common.Controls.EngineGate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Contr.UI.Common.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <controls:EmptyState
        Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}"
        IsAccent="False"
        Message="{x:Bind ViewModel.Message, Mode=OneWay}"
        Title="{x:Bind ViewModel.Title, Mode=OneWay}">
        <StackPanel HorizontalAlignment="Center" Spacing="12">
            <Button
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="StartEngineButton"
                Command="{x:Bind ViewModel.StartEngineCommand}"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind controls:EngineGate.ShowsEither(ViewModel.IsStopped, ViewModel.IsFailed), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontFamily="{StaticResource ContrIconsFontFamily}"
                        FontSize="16"
                        Glyph="{x:Bind icons:ContrIcons.Play}" />
                    <TextBlock Text="Start engine" />
                </StackPanel>
            </Button>
            <ProgressRing
                HorizontalAlignment="Center"
                IsActive="{x:Bind controls:EngineGate.Any(ViewModel.IsBusy, ViewModel.IsStarting), Mode=OneWay}"
                Visibility="{x:Bind controls:EngineGate.ShowsEither(ViewModel.IsBusy, ViewModel.IsStarting), Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Containers with a restart policy start too."
                Visibility="{x:Bind ViewModel.IsStopped, Mode=OneWay}" />
            <StackPanel
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsStopped, Mode=OneWay}">
                <CheckBox
                    AutomationProperties.AutomationId="StartEngineOnConnect"
                    Content="Start the engine whenever Contr starts"
                    IsChecked="{x:Bind ViewModel.Autostart.IsOn, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.Autostart.CanChange, Mode=OneWay}" />
                <controls:PillView
                    VerticalAlignment="Center"
                    Kind="Locked"
                    Text="Managed by your organization"
                    Visibility="{x:Bind ViewModel.Autostart.IsLocked, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </controls:EmptyState>
</UserControl>
