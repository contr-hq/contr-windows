<UserControl
    x:Class="Contr.UI.Common.Controls.Pager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Contr.UI.Common.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    VerticalAlignment="Center"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal" Spacing="2">
        <Button
            Width="28"
            Height="28"
            Padding="0"
            AutomationProperties.Name="Previous page"
            Command="{x:Bind PreviousCommand, Mode=OneWay}"
            Style="{StaticResource SubtleButtonStyle}"
            ToolTipService.ToolTip="Previous page">
            <FontIcon
                FontFamily="{StaticResource ContrIconsFontFamily}"
                FontSize="12"
                Glyph="{x:Bind icons:ContrIcons.ChevronLeftSmall}" />
        </Button>
        <TextBlock
            MinWidth="36"
            VerticalAlignment="Center"
            FontSize="12"
            Text="{x:Bind Text, Mode=OneWay}"
            TextAlignment="Center" />
        <Button
            Width="28"
            Height="28"
            Padding="0"
            AutomationProperties.Name="Next page"
            Command="{x:Bind NextCommand, Mode=OneWay}"
            Style="{StaticResource SubtleButtonStyle}"
            ToolTipService.ToolTip="Next page">
            <FontIcon
                FontFamily="{StaticResource ContrIconsFontFamily}"
                FontSize="12"
                Glyph="{x:Bind icons:ContrIcons.ChevronRightSmall}" />
        </Button>
    </StackPanel>
</UserControl>
