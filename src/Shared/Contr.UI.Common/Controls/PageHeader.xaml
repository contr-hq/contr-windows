<UserControl
    x:Class="Contr.UI.Common.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="using:Contr.UI.Common.Icons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="CrumbChevronStyle" TargetType="FontIcon">
            <Setter Property="FontFamily" Value="{StaticResource ContrIconsFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!--  One row: the breadcrumb, then the page's actions. A page has no title of its own.  -->
    <Grid ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="32" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel
            VerticalAlignment="Center"
            AutomationProperties.Name="Breadcrumb"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind Root, Mode=OneWay}" />
            <FontIcon Glyph="{x:Bind icons:ContrIcons.ChevronRightSmall}" Style="{StaticResource CrumbChevronStyle}" />
            <ItemsRepeater ItemsSource="{x:Bind controls:PageHeader.Ancestors(Trail), Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="8" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="controls:Crumb">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Margin="-4,-2"
                                Padding="4,2"
                                VerticalAlignment="Center"
                                Click="OnCrumbClick"
                                Content="{x:Bind Text}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="{x:Bind Index}" />
                            <FontIcon Glyph="{x:Bind icons:ContrIcons.ChevronRightSmall}" Style="{StaticResource CrumbChevronStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TextBlock
                VerticalAlignment="Center"
                AutomationProperties.HeadingLevel="Level1"
                FontWeight="SemiBold"
                Text="{x:Bind controls:PageHeader.Current(Title, Trail), Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ContentPresenter
            Grid.Column="1"
            VerticalAlignment="Center"
            Content="{x:Bind Commands, Mode=OneWay}" />

        <!--  The shell's notices, first among the page's messages under the breadcrumb.  -->
        <InfoBar
            x:Name="NoticeBar"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,16,0,0"
            IsClosable="True"
            IsOpen="False"
            Visibility="{x:Bind NoticeBar.IsOpen, Mode=OneWay}" />
    </Grid>
</UserControl>
