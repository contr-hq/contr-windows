<UserControl
    x:Class="Contr.UI.Common.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Top" Spacing="2">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="{x:Bind Title, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind controls:PageHeader.WhenEmpty(Trail), Mode=OneWay}" />
            <BreadcrumbBar
                ItemClicked="OnTrailItemClicked"
                ItemsSource="{x:Bind Trail, Mode=OneWay}"
                Visibility="{x:Bind controls:PageHeader.WhenAny(Trail), Mode=OneWay}">
                <BreadcrumbBar.Resources>
                    <x:Double x:Key="BreadcrumbBarItemThemeFontSize">28</x:Double>
                    <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
                    <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                </BreadcrumbBar.Resources>
            </BreadcrumbBar>
            <ContentPresenter
                Content="{x:Bind Subtitle, Mode=OneWay}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{x:Bind controls:PageHeader.WhenPresent(Subtitle), Mode=OneWay}" />
        </StackPanel>

        <ContentPresenter
            Grid.Column="1"
            Margin="0,6,0,0"
            VerticalAlignment="Top"
            Content="{x:Bind Commands, Mode=OneWay}"
            Visibility="{x:Bind controls:PageHeader.WhenPresent(Commands), Mode=OneWay}" />
    </Grid>
</UserControl>
