<UserControl
    x:Class="Contr.UI.Common.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Contr.UI.Common.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel
            Grid.Column="0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="2">
            <TextBlock
                Padding="8,5"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Root, Mode=OneWay}"
                Visibility="{x:Bind controls:PageHeader.WhenSet(Root), Mode=OneWay}" />
            <FontIcon
                Margin="2,0"
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE76C;"
                Visibility="{x:Bind controls:PageHeader.WhenSet(Root), Mode=OneWay}" />
            <TextBlock
                Padding="8,5"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Section, Mode=OneWay}"
                Visibility="{x:Bind controls:PageHeader.WhenSet(Section), Mode=OneWay}" />
            <FontIcon
                Margin="2,0"
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE76C;"
                Visibility="{x:Bind controls:PageHeader.WhenSet(Section), Mode=OneWay}" />
            <TextBlock
                Padding="8,5"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{x:Bind Title, Mode=OneWay}" />
        </StackPanel>

        <!--  Collapsed when the page contributes no commands.  -->
        <Border
            Grid.Column="1"
            Padding="2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="{x:Bind controls:PageHeader.WhenPresent(Commands), Mode=OneWay}">
            <ContentPresenter Content="{x:Bind Commands, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>
