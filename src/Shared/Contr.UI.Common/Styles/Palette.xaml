<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Contr's muted status colours over the Fluent ones, each 4.5:1 or more on the tinted backdrop and on cards.
        TintedMicaBackdrop holds the surfaces and Branding:Accent the accent.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#94CF9F" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#E7C681" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#E69F9E" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#233226" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#3E2726" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#31693F" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#865725" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#9D3D36" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#DEF1E1" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FCE5E4" />
            <!--  Fluent's 45 % black falls under 4.5:1 on the light backdrop.  -->
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8F000000" />
        </ResourceDictionary>

        <!--  Empty, so high contrast keeps the system's colours.  -->
        <ResourceDictionary x:Key="HighContrast" />
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
