<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="CellTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style
        x:Key="SecondaryCellTextStyle"
        BasedOn="{StaticResource CellTextStyle}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="GroupCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="GroupRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="44,6,12,6" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!--  A table inside a captioned card: the column heads over a divider, then 44 px rows with one under each.  -->
    <Style x:Key="CardTableHeadStyle" TargetType="Grid">
        <Setter Property="Padding" Value="0,0,0,10" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="CardTableRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <!--  A table whose rows select an item for a details card: rows inset for the selection marker.  -->
    <Style
        x:Key="SelectableTableHeadStyle"
        BasedOn="{StaticResource CardTableHeadStyle}"
        TargetType="Grid">
        <Setter Property="Padding" Value="12,0,8,10" />
    </Style>

    <Style
        x:Key="SelectableTableRowStyle"
        BasedOn="{StaticResource CardTableRowStyle}"
        TargetType="Grid">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,4,8,4" />
    </Style>

    <!--  The selected row's marker, in the row's left inset.  -->
    <Style x:Key="SelectionMarkerStyle" TargetType="Border">
        <Setter Property="Width" Value="3" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="-12,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
