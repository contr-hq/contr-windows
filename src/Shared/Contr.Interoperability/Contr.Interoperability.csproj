<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Contr.Interoperability</RootNamespace>
    <AssemblyName>Contr.Interoperability</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CsWin32 cannot generate 64-bit-only APIs for AnyCPU; the app runs only as x64 or ARM64. -->
    <PlatformTarget Condition="'$(Platform)' != 'ARM64'">x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

</Project>
